{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport { toast } from 'vue3-toastify';\nimport 'vue3-toastify/dist/index.css';\nexport default {\n  data() {\n    return {\n      searchQuery: '',\n      cart: [],\n      products: []\n    };\n  },\n  computed: {\n    filteredProducts() {\n      const q = this.searchQuery.toLowerCase();\n      return this.products.filter(p => {\n        return p.name.toLowerCase().includes(q) || p.description.toLowerCase().includes(q);\n      });\n    }\n  },\n  methods: {\n    buttonText(product) {\n      if (product.stock === 0) return 'Out of Stock';\n      if (this.hasReachedLimit(product)) return 'Max Quantity Reached';\n      return 'Add to Cart';\n    },\n    loadCart() {\n      try {\n        const stored = localStorage.getItem('cart');\n        this.cart = stored ? JSON.parse(stored) : [];\n      } catch (err) {\n        console.error('Error loading cart:', err);\n        this.cart = [];\n      }\n    },\n    loadProducts() {\n      const defaultProducts = [{\n        id: 1,\n        name: 'Handwoven Basket',\n        description: 'Eco-friendly and durable basket for home use.',\n        price: 499,\n        stock: 5,\n        image: 'https://via.placeholder.com/300x200?text=Basket'\n      }, {\n        id: 2,\n        name: 'Wooden Spoon Set',\n        description: 'A set of 5 handcrafted wooden spoons.',\n        price: 299,\n        stock: 2,\n        image: 'https://via.placeholder.com/300x200?text=Spoon+Set'\n      }, {\n        id: 3,\n        name: 'Canvas Tote Bag',\n        description: 'Stylish and reusable tote bag made of cotton.',\n        price: 350,\n        stock: 0,\n        image: 'https://via.placeholder.com/300x200?text=Tote+Bag'\n      }];\n      const storedProducts = localStorage.getItem('products');\n      if (storedProducts) {\n        try {\n          this.products = JSON.parse(storedProducts);\n        } catch {\n          this.products = defaultProducts;\n        }\n      } else {\n        this.products = defaultProducts;\n      }\n    },\n    saveCart() {\n      localStorage.setItem('cart', JSON.stringify(this.cart));\n    },\n    saveProducts() {\n      localStorage.setItem('products', JSON.stringify(this.products));\n    },\n    addToCart(product) {\n      const existing = this.cart.find(item => item.product === product.id);\n      if (existing) {\n        if (existing.quantity < product.stock) {\n          existing.quantity++;\n          product.stock--;\n          toast.success(`${product.name} quantity updated!`);\n        } else {\n          toast.warning(`You've reached the max stock for ${product.name}.`);\n          return;\n        }\n      } else {\n        if (product.stock === 0) {\n          toast.error(`${product.name} is out of stock.`);\n          return;\n        }\n        this.cart.push({\n          id: product.id,\n          product: product.id,\n          product_name: product.name,\n          price: product.price,\n          quantity: 1\n        });\n        product.stock--;\n        toast.success(`${product.name} added to cart!`);\n      }\n      this.saveCart();\n      this.saveProducts();\n    },\n    hasReachedLimit(product) {\n      const item = this.cart.find(c => c.product === product.id);\n      return item ? item.quantity >= product.stock : false;\n    },\n    logout() {\n      localStorage.clear();\n      this.$router.push('/login');\n      toast.info('You have been logged out.');\n    }\n  },\n  created() {\n    this.loadCart();\n    this.loadProducts();\n  }\n};","map":{"version":3,"names":["toast","data","searchQuery","cart","products","computed","filteredProducts","q","toLowerCase","filter","p","name","includes","description","methods","buttonText","product","stock","hasReachedLimit","loadCart","stored","localStorage","getItem","JSON","parse","err","console","error","loadProducts","defaultProducts","id","price","image","storedProducts","saveCart","setItem","stringify","saveProducts","addToCart","existing","find","item","quantity","success","warning","push","product_name","c","logout","clear","$router","info","created"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ProductList.vue"],"sourcesContent":["<template>\r\n  <div class=\"container py-4 py-md-5 main-container\">\r\n    <!-- Header Section -->\r\n    <div class=\"row mb-4 mb-md-5\">\r\n      <div class=\"col-12\">\r\n        <div class=\"d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center w-100 gap-3\">\r\n          <div>\r\n            <h2 class=\"font-weight-bold text-brown mb-0\">Maisanova Collection</h2>\r\n            <p class=\"text-brown-light mb-0 mt-1\">Handcrafted luxury for discerning tastes</p>\r\n          </div>\r\n\r\n          <div class=\"w-100 w-md-auto\">\r\n            <div class=\"search-container position-relative\">\r\n              <input\r\n                v-model=\"searchQuery\"\r\n                type=\"text\"\r\n                class=\"form-control search-input ps-4 pe-5 rounded-pill border-0 shadow-sm\"\r\n                placeholder=\"Search our collection...\"\r\n                aria-label=\"Search products\"\r\n              />\r\n              <span class=\"position-absolute search-icon\">\r\n                <i class=\"fas fa-search text-brown-light\"></i>\r\n              </span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Empty State -->\r\n    <div v-if=\"filteredProducts.length === 0\" class=\"text-center py-5 my-5\">\r\n      <div class=\"empty-state-icon mb-3\">\r\n        <i class=\"fas fa-search fa-2x text-brown-light\"></i>\r\n      </div>\r\n      <h4 class=\"text-brown mb-2\">No products found</h4>\r\n      <p class=\"text-brown-light mb-4\">Try adjusting your search or browse our full collection</p>\r\n      <button class=\"btn btn-outline-brown\" @click=\"searchQuery = ''\">\r\n        Clear Search\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Product Grid -->\r\n    <div class=\"row g-4\">\r\n      <div v-for=\"product in filteredProducts\" :key=\"product.id\" class=\"col-12 col-sm-6 col-md-4\">\r\n        <div class=\"card product-card h-100 border-0 shadow-sm overflow-hidden\">\r\n          <div class=\"product-image-container position-relative\">\r\n            <div class=\"aspect-ratio-box\">\r\n              <img\r\n                v-if=\"product.image\"\r\n                :src=\"product.image\"\r\n                class=\"card-img-top product-image\"\r\n                :alt=\"product.name\"\r\n                loading=\"lazy\"\r\n              />\r\n              <div v-else class=\"no-image-placeholder d-flex align-items-center justify-content-center\">\r\n                <i class=\"fas fa-image fa-3x text-brown-light opacity-50\"></i>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-if=\"product.stock === 0\" class=\"out-of-stock-badge\">\r\n              Out of Stock\r\n            </div>\r\n            <div v-else-if=\"product.stock < 5\" class=\"low-stock-badge\">\r\n              Only {{ product.stock }} left\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"card-body d-flex flex-column p-4 bg-beige\">\r\n            <div class=\"mb-2\">\r\n              <h5 class=\"card-title font-weight-bold text-brown-dark mb-1\">{{ product.name }}</h5>\r\n              <div class=\"d-flex align-items-center mb-2\">\r\n                <div class=\"rating-stars me-2\">\r\n                  <i class=\"fas fa-star text-warning\"></i>\r\n                  <i class=\"fas fa-star text-warning\"></i>\r\n                  <i class=\"fas fa-star text-warning\"></i>\r\n                  <i class=\"fas fa-star text-warning\"></i>\r\n                  <i class=\"fas fa-star-half-alt text-warning\"></i>\r\n                </div>\r\n                <small class=\"text-brown-light\">(24)</small>\r\n              </div>\r\n            </div>\r\n            \r\n            <p class=\"card-text text-brown-medium product-description mb-3\">{{ product.description }}</p>\r\n            \r\n            <div class=\"mt-auto\">\r\n              <div class=\"d-flex justify-content-between align-items-center mb-3\">\r\n                <span class=\"product-price text-brown-dark\">₱{{ product.price.toLocaleString() }}</span>\r\n                <span class=\"stock-indicator small\" :class=\"{'text-accent': product.stock < 5 && product.stock > 0}\">\r\n                  {{ product.stock > 0 ? `${product.stock} in stock` : '' }}\r\n                </span>\r\n              </div>\r\n              \r\n              <button\r\n                class=\"btn btn-add-to-cart w-100 text-white border-0 shadow-sm\"\r\n                @click=\"addToCart(product)\"\r\n                :disabled=\"product.stock === 0 || hasReachedLimit(product)\"\r\n                :class=\"{\r\n                  'btn-brown-dark': !(product.stock === 0 || hasReachedLimit(product)),\r\n                  'btn-brown-light': product.stock === 0 || hasReachedLimit(product)\r\n                }\"\r\n                aria-label=\"Add to cart\"\r\n              >\r\n                <i class=\"fas fa-shopping-cart me-2\"></i>\r\n                {{ buttonText(product) }}\r\n              </button>\r\n              \r\n              <button class=\"btn btn-outline-brown w-100 mt-2\" @click=\"showProductDetails(product)\">\r\n                <i class=\"far fa-eye me-2\"></i> View Details\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <!-- Mobile Floating Action Button -->\r\n    <div class=\"d-block d-md-none fixed-bottom mb-3 mx-3\">\r\n      <button \r\n        class=\"btn btn-brown-dark rounded-pill shadow-lg py-3 w-100 d-flex justify-content-center align-items-center\"\r\n        @click=\"scrollToTop\"\r\n      >\r\n        <i class=\"fas fa-arrow-up me-2\"></i> Back to Top\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { toast } from 'vue3-toastify'\r\nimport 'vue3-toastify/dist/index.css'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      searchQuery: '',\r\n      cart: [],\r\n      products: []\r\n    }\r\n  },\r\n  computed: {\r\n    filteredProducts() {\r\n      const q = this.searchQuery.toLowerCase()\r\n      return this.products.filter(p => {\r\n        return (\r\n          p.name.toLowerCase().includes(q) ||\r\n          p.description.toLowerCase().includes(q)\r\n        )\r\n      })\r\n    }\r\n  },\r\n  methods: {\r\n    buttonText(product) {\r\n      if (product.stock === 0) return 'Out of Stock'\r\n      if (this.hasReachedLimit(product)) return 'Max Quantity Reached'\r\n      return 'Add to Cart'\r\n    },\r\n    loadCart() {\r\n      try {\r\n        const stored = localStorage.getItem('cart')\r\n        this.cart = stored ? JSON.parse(stored) : []\r\n      } catch (err) {\r\n        console.error('Error loading cart:', err)\r\n        this.cart = []\r\n      }\r\n    },\r\n    loadProducts() {\r\n      const defaultProducts = [\r\n        {\r\n          id: 1,\r\n          name: 'Handwoven Basket',\r\n          description: 'Eco-friendly and durable basket for home use.',\r\n          price: 499,\r\n          stock: 5,\r\n          image: 'https://via.placeholder.com/300x200?text=Basket'\r\n        },\r\n        {\r\n          id: 2,\r\n          name: 'Wooden Spoon Set',\r\n          description: 'A set of 5 handcrafted wooden spoons.',\r\n          price: 299,\r\n          stock: 2,\r\n          image: 'https://via.placeholder.com/300x200?text=Spoon+Set'\r\n        },\r\n        {\r\n          id: 3,\r\n          name: 'Canvas Tote Bag',\r\n          description: 'Stylish and reusable tote bag made of cotton.',\r\n          price: 350,\r\n          stock: 0,\r\n          image: 'https://via.placeholder.com/300x200?text=Tote+Bag'\r\n        }\r\n      ]\r\n\r\n      const storedProducts = localStorage.getItem('products')\r\n      if (storedProducts) {\r\n        try {\r\n          this.products = JSON.parse(storedProducts)\r\n        } catch {\r\n          this.products = defaultProducts\r\n        }\r\n      } else {\r\n        this.products = defaultProducts\r\n      }\r\n    },\r\n    saveCart() {\r\n      localStorage.setItem('cart', JSON.stringify(this.cart))\r\n    },\r\n    saveProducts() {\r\n      localStorage.setItem('products', JSON.stringify(this.products))\r\n    },\r\n    addToCart(product) {\r\n      const existing = this.cart.find(item => item.product === product.id)\r\n\r\n      if (existing) {\r\n        if (existing.quantity < product.stock) {\r\n          existing.quantity++\r\n          product.stock--\r\n          toast.success(`${product.name} quantity updated!`)\r\n        } else {\r\n          toast.warning(`You've reached the max stock for ${product.name}.`)\r\n          return\r\n        }\r\n      } else {\r\n        if (product.stock === 0) {\r\n          toast.error(`${product.name} is out of stock.`)\r\n          return\r\n        }\r\n\r\n        this.cart.push({\r\n          id: product.id,\r\n          product: product.id,\r\n          product_name: product.name,\r\n          price: product.price,\r\n          quantity: 1\r\n        })\r\n        product.stock--\r\n        toast.success(`${product.name} added to cart!`)\r\n      }\r\n\r\n      this.saveCart()\r\n      this.saveProducts()\r\n    },\r\n    hasReachedLimit(product) {\r\n      const item = this.cart.find(c => c.product === product.id)\r\n      return item ? item.quantity >= product.stock : false\r\n    },\r\n    logout() {\r\n      localStorage.clear()\r\n      this.$router.push('/login')\r\n      toast.info('You have been logged out.')\r\n    }\r\n  },\r\n  created() {\r\n    this.loadCart()\r\n    this.loadProducts()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Enhanced Color Palette */\r\n:root {\r\n  --brown-dark: #3E2723;\r\n  --brown-medium: #5D4037;\r\n  --brown-light: #8D6E63;\r\n  --beige: #F5F5F0;\r\n  --cream: #FFFDF5;\r\n  --accent: #A1887F;\r\n  --neutral-dark: #3E2723;\r\n  --neutral-light: #D7CCC8;\r\n  --highlight: #BCAAA4;\r\n}\r\n\r\n.main-container {\r\n  background-color: var(--cream);\r\n  max-width: 1800px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.search-container {\r\n  width: 100%;\r\n}\r\n\r\n.search-input {\r\n  background-color: var(--beige);\r\n  transition: all 0.3s ease;\r\n  border: 1px solid var(--neutral-light) !important;\r\n  padding: 0.75rem 1.5rem;\r\n  font-size: 0.95rem;\r\n}\r\n\r\n.search-input:focus {\r\n  background-color: white;\r\n  box-shadow: 0 0 0 3px rgba(158, 119, 105, 0.15) !important;\r\n  border-color: var(--brown-light) !important;\r\n}\r\n\r\n.search-icon {\r\n  top: 50%;\r\n  right: 1.25rem;\r\n  transform: translateY(-50%);\r\n  pointer-events: none;\r\n}\r\n\r\n.product-card {\r\n  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  background: white;\r\n}\r\n\r\n.product-card:hover {\r\n  transform: translateY(-8px);\r\n  box-shadow: 0 15px 30px rgba(62, 39, 35, 0.12) !important;\r\n}\r\n\r\n.aspect-ratio-box {\r\n  position: relative;\r\n  padding-top: 100%; /* 1:1 Aspect Ratio */\r\n  overflow: hidden;\r\n}\r\n\r\n.product-image {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  transition: transform 0.5s ease;\r\n}\r\n\r\n.product-card:hover .product-image {\r\n  transform: scale(1.03);\r\n}\r\n\r\n.no-image-placeholder {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: var(--beige);\r\n}\r\n\r\n.bg-beige {\r\n  background-color: var(--beige);\r\n}\r\n\r\n.text-brown {\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-brown-dark {\r\n  color: var(--brown-dark);\r\n}\r\n\r\n.text-brown-medium {\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-brown-light {\r\n  color: var(--brown-light);\r\n}\r\n\r\n.product-description {\r\n  font-size: 0.92rem;\r\n  line-height: 1.5;\r\n  color: var(--brown-medium);\r\n  overflow: hidden;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  min-height: 66px;\r\n}\r\n\r\n.product-price {\r\n  font-size: 1.3rem;\r\n  font-weight: 600;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.stock-indicator {\r\n  font-size: 0.85rem;\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-accent {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n.btn-add-to-cart {\r\n  background-color: var(--brown-dark);\r\n  color: white;\r\n  transition: all 0.3s ease;\r\n  border-radius: 8px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.5px;\r\n  padding: 0.75rem;\r\n  text-transform: uppercase;\r\n  font-size: 0.9rem;\r\n}\r\n\r\n.btn-add-to-cart:hover:not(:disabled) {\r\n  background-color: var(--neutral-dark);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.btn-add-to-cart:active:not(:disabled) {\r\n  transform: translateY(0);\r\n}\r\n\r\n.btn-brown-dark {\r\n  background-color: var(--brown-dark);\r\n}\r\n\r\n.btn-brown-light {\r\n  background-color: var(--neutral-light);\r\n  color: var(--neutral-dark);\r\n  cursor: not-allowed;\r\n}\r\n\r\n.btn-outline-brown {\r\n  border: 1px solid var(--brown-medium);\r\n  color: var(--brown-medium);\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.btn-outline-brown:hover {\r\n  background-color: var(--brown-medium);\r\n  color: white;\r\n}\r\n\r\n.out-of-stock-badge {\r\n  position: absolute;\r\n  top: 15px;\r\n  right: 15px;\r\n  background-color: rgba(62, 39, 35, 0.9);\r\n  color: white;\r\n  padding: 5px 12px;\r\n  border-radius: 20px;\r\n  font-size: 0.75rem;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.5px;\r\n}\r\n