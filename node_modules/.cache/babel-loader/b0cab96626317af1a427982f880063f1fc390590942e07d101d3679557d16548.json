\", -1 /* HOISTED */)), _createElementVNode(\"span\", null, \"₱\" + _toDisplayString($options.formatPrice($options.cartTotal)), 1 /* TEXT */)]), _cache[12] || (_cache[12] = _createElementVNode(\"div\", {\n    class: \"receipt-row\"\n  }, [_createElementVNode(\"span\", null, \"Shipping:\"), _createElementVNode(\"span\", {\n    class: \"free-shipping\"\n  }, \"Free\")], -1 /* HOISTED */)), _createElementVNode(\"div\", _hoisted_30, [_cache[11] || (_cache[11] = _createElementVNode(\"span\", null, \"Total:\", -1 /* HOISTED */)), _createElementVNode(\"span\", null, \"₱\" + _toDisplayString($options.formatPrice($options.cartTotal)), 1 /* TEXT */)])]), _createElementVNode(\"div\", _hoisted_31, [_createElementVNode(\"button\", {\n    onClick: _cache[1] || (_cache[1] = (...args) => $options.checkout && $options.checkout(...args)),\n    class: \"btn btn-brown w-100 mb-3\"\n  }, _cache[13] || (_cache[13] = [_createElementVNode(\"i\", {\n    class: \"fas fa-credit-card me-2\"\n  }, null, -1 /* HOISTED */), _createTextVNode(\" Complete Purchase \")])), _createElementVNode(\"button\", {\n    onClick: _cache[2] || (_cache[2] = (...args) => $options.clearCart && $options.clearCart(...args)),\n    class: \"btn btn-outline-brown w-100\"\n  }, _cache[14] || (_cache[14] = [_createElementVNode(\"i\", {\n    class: \"fas fa-trash me-2\"\n  }, null, -1 /* HOISTED */), _createTextVNode(\" Clear Cart \")]))])])])) : _createCommentVNode(\"v-if\", true)]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_hoisted_3","$data","isLoading","_hoisted_4","_cache","role","cartItems","length","_Fragment","_createStaticVNode","_hoisted_5","_hoisted_6","_renderList","item","id","_hoisted_7","src","image","alt","product_name","name","_hoisted_8","_hoisted_9","_hoisted_10","_toDisplayString","_hoisted_11","$options","formatPrice","price","_hoisted_12","_hoisted_13","quantity","_hoisted_14","_hoisted_15","onClick","$event","decreaseQuantity","disabled","_hoisted_16","_hoisted_17","increaseQuantity","_hoisted_18","removeItem","title","_hoisted_19","_hoisted_20","args","checkout","_createTextVNode","cartTotal","_hoisted_21","_hoisted_22","_hoisted_23","_hoisted_24","_hoisted_25","_hoisted_26","_hoisted_27","_hoisted_28","_hoisted_29","_hoisted_30","_hoisted_31","clearCart"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n  <div class=\"cart-container\">\r\n    <!-- Main Cart Content -->\r\n    <div class=\"cart-main\">\r\n      <div class=\"container-fluid px-3 px-md-4 py-4\">\r\n\r\n        <!-- Loading State -->\r\n        <div v-if=\"isLoading\" class=\"loading-container\">\r\n          <div class=\"spinner-border text-brown-medium\" role=\"status\">\r\n            <span class=\"visually-hidden\">Loading...</span>\r\n          </div>\r\n          <p class=\"mt-3 text-brown-medium\">Loading your cart...</p>\r\n        </div>\r\n\r\n        <!-- Empty Cart State -->\r\n        <div v-else-if=\"!cartItems || cartItems.length === 0\" class=\"empty-cart\">\r\n          <div class=\"empty-cart-icon\">\r\n            <i class=\"fas fa-shopping-cart\"></i>\r\n          </div>\r\n          <h3 class=\"empty-cart-title\">Your cart is empty</h3>\r\n          <p class=\"empty-cart-text\">\r\n            Discover amazing products and add them to your cart\r\n          </p>\r\n          <a href=\"/products\" class=\"btn btn-brown btn-lg\">\r\n            <i class=\"fas fa-search me-2\"></i>\r\n            Browse Products\r\n          </a>\r\n        </div>\r\n\r\n        <!-- Cart Items -->\r\n        <div v-else class=\"cart-items\">\r\n          <!-- Cart Item Cards -->\r\n          <div class=\"cart-items-list\">\r\n            <div\r\n              v-for=\"item in cartItems\"\r\n              :key=\"item.id\"\r\n              class=\"cart-item-card\"\r\n            >\r\n              <div class=\"item-image\">\r\n                <img \r\n                  :src=\"item.image || '/placeholder-product.jpg'\" \r\n                  :alt=\"item.product_name || item.name\"\r\n                  class=\"product-image\"\r\n                />\r\n              </div>\r\n              \r\n              <div class=\"item-details\">\r\n                <h5 class=\"item-name\">{{ item.product_name || item.name }}</h5>\r\n                <p class=\"item-price\">₱{{ formatPrice(item.price) }} each</p>\r\n                <div class=\"item-total\">\r\n                  <span class=\"total-label\">Subtotal: </span>\r\n                  <span class=\"total-amount\">₱{{ formatPrice(item.price * item.quantity) }}</span>\r\n                </div>\r\n              </div>\r\n\r\n              <div class=\"item-actions\">\r\n                <div class=\"quantity-controls\">\r\n                  <button\r\n                    @click=\"decreaseQuantity(item)\"\r\n                    class=\"qty-btn qty-btn-minus\"\r\n                    :disabled=\"item.quantity <= 1\"\r\n                  >\r\n                    <i class=\"fas fa-minus\"></i>\r\n                  </button>\r\n                  <span class=\"quantity-display\">{{ item.quantity }}</span>\r\n                  <button\r\n                    @click=\"increaseQuantity(item)\"\r\n                    class=\"qty-btn qty-btn-plus\"\r\n                  >\r\n                    <i class=\"fas fa-plus\"></i>\r\n                  </button>\r\n                </div>\r\n                <button\r\n                  @click=\"removeItem(item)\"\r\n                  class=\"remove-btn\"\r\n                  title=\"Remove item\"\r\n                >\r\n                  <i class=\"fas fa-trash\"></i>\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Mobile Checkout Button -->\r\n          <div class=\"mobile-checkout d-md-none\">\r\n            <button @click=\"checkout\" class=\"btn btn-brown btn-lg w-100\">\r\n              <i class=\"fas fa-credit-card me-2\"></i>\r\n              Complete Purchase - ₱{{ formatPrice(cartTotal) }}\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Sticky Receipt Sidebar -->\r\n    <div \r\n      v-if=\"cartItems && cartItems.length > 0\" \r\n      class=\"receipt-sidebar d-none d-md-block\"\r\n    >\r\n      <div class=\"receipt-content\">\r\n        <div class=\"receipt-header\">\r\n          <h4>Order Summary</h4>\r\n        </div>\r\n\r\n        <div class=\"receipt-items\">\r\n          <div \r\n            v-for=\"item in cartItems\" \r\n            :key=\"item.id\"\r\n            class=\"receipt-item\"\r\n          >\r\n            <div class=\"receipt-item-info\">\r\n              <span class=\"receipt-item-name\">{{ item.product_name || item.name }}</span>\r\n              <span class=\"receipt-item-qty\">× {{ item.quantity }}</span>\r\n            </div>\r\n            <span class=\"receipt-item-total\">₱{{ formatPrice(item.price * item.quantity) }}</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"receipt-divider\"></div>\r\n\r\n        <div class=\"receipt-summary\">\r\n          <div class=\"receipt-row\">\r\n            <span>Subtotal:</span>\r\n            <span>₱{{ formatPrice(cartTotal) }}</span>\r\n          </div>\r\n          <div class=\"receipt-row\">\r\n            <span>Shipping:</span>\r\n            <span class=\"free-shipping\">Free</span>\r\n          </div>\r\n          <div class=\"receipt-row receipt-total\">\r\n            <span>Total:</span>\r\n            <span>₱{{ formatPrice(cartTotal) }}</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"receipt-actions\">\r\n          <button @click=\"checkout\" class=\"btn btn-brown w-100 mb-3\">\r\n            <i class=\"fas fa-credit-card me-2\"></i>\r\n            Complete Purchase\r\n          </button>\r\n          <button @click=\"clearCart\" class=\"btn btn-outline-brown w-100\">\r\n            <i class=\"fas fa-trash me-2\"></i>\r\n            Clear Cart\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      cartItems: [],\r\n      isLoading: true,\r\n    };\r\n  },\r\n  computed: {\r\n    cartTotal() {\r\n      return this.cartItems.reduce((total, item) => {\r\n        return total + parseFloat(item.price) * item.quantity;\r\n      }, 0);\r\n    },\r\n  },\r\n  mounted() {\r\n    this.loadLocalCart();\r\n  },\r\n  methods: {\r\n    formatPrice(price) {\r\n      return parseFloat(price).toLocaleString(undefined, {\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2,\r\n      });\r\n    },\r\n    loadLocalCart() {\r\n      try {\r\n        const stored = localStorage.getItem(\"cart\");\r\n        this.cartItems = stored ? JSON.parse(stored) : [];\r\n      } catch (err) {\r\n        console.error(\"Error loading cart from localStorage:\", err);\r\n        this.cartItems = [];\r\n      } finally {\r\n        this.isLoading = false;\r\n      }\r\n    },\r\n    saveLocalCart() {\r\n      try {\r\n        localStorage.setItem(\"cart\", JSON.stringify(this.cartItems));\r\n      } catch (err) {\r\n        console.error(\"Error saving cart to localStorage:\", err);\r\n      }\r\n    },\r\n    increaseQuantity(item) {\r\n      const products = JSON.parse(localStorage.getItem(\"products\")) || [];\r\n      const stockItem = products.find((p) => p.id === item.product);\r\n      if (stockItem && item.quantity < stockItem.stock) {\r\n        item.quantity += 1;\r\n        this.saveLocalCart();\r\n      } else {\r\n        this.showToast(\"You've reached the maximum available stock for this item.\");\r\n      }\r\n    },\r\n    decreaseQuantity(item) {\r\n      if (item.quantity <= 1) {\r\n        this.removeItem(item);\r\n      } else {\r\n        item.quantity -= 1;\r\n        this.saveLocalCart();\r\n      }\r\n    },\r\n    removeItem(item) {\r\n      if (confirm(\"Remove this item from your cart?\")) {\r\n        this.cartItems = this.cartItems.filter(\r\n          (i) => i.product !== item.product && i.id !== item.id\r\n        );\r\n        this.saveLocalCart();\r\n        this.showToast(\"Item removed from cart\");\r\n      }\r\n    },\r\n    clearCart() {\r\n      if (confirm(\"Are you sure you want to clear your entire cart?\")) {\r\n        this.cartItems = [];\r\n        localStorage.removeItem(\"cart\");\r\n        this.showToast(\"Cart cleared\");\r\n      }\r\n    },\r\n    checkout() {\r\n      if (!this.cartItems.length) return;\r\n\r\n      const order = {\r\n        id: Date.now(),\r\n        date: new Date(),\r\n        items: this.cartItems,\r\n        total: this.cartTotal,\r\n      };\r\n\r\n      // Load previous orders\r\n      const prevOrders = JSON.parse(localStorage.getItem(\"orderHistory\")) || [];\r\n\r\n      // Add new order to top\r\n      prevOrders.unshift(order);\r\n\r\n      // Save updated order history\r\n      localStorage.setItem(\"orderHistory\", JSON.stringify(prevOrders));\r\n\r\n      // Clear cart\r\n      this.cartItems = [];\r\n      localStorage.removeItem(\"cart\");\r\n\r\n      this.showToast(\"Order placed successfully! 🎉\");\r\n\r\n      // Optional: redirect to order view\r\n      // this.$router.push(\"/orders\");\r\n    },\r\n    showToast(message) {\r\n      // Simple toast notification (you can integrate with a toast library)\r\n      alert(message);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n:root {\r\n  --brown-dark: #5d4037;\r\n  --brown-medium: #7d5a50;\r\n  --brown-light: #a98274;\r\n  --beige: #f5f5dc;\r\n  --cream: #fffbeb;\r\n  --accent: #8d6e63;\r\n  --neutral-dark: #4e342e;\r\n  --neutral-light: #d7ccc8;\r\n  --success: #28a745;\r\n  --warning: #ffc107;\r\n  --danger: #dc3545;\r\n  --shadow: 0 2px 12px rgba(0, 0, 0, 0.1);\r\n  --shadow-hover: 0 4px 20px rgba(0, 0, 0, 0.15);\r\n}\r\n\r\n.cart-container {\r\n  display: flex;\r\n  min-height: 100vh;\r\n  background-color: var(--cream);\r\n  position: relative;\r\n}\r\n\r\n.cart-main {\r\n  flex: 1;\r\n  width: 100%;\r\n  max-width: 100%;\r\n}\r\n\r\n@media (min-width: 768px) {\r\n  .cart-main {\r\n    width: calc(100% - 350px);\r\n    max-width: calc(100% - 350px);\r\n  }\r\n}\r\n\r\n/* Header Styles */\r\n.cart-header {\r\n  text-align: center;\r\n  padding: 2rem 1rem;\r\n  background: linear-gradient(135deg, var(--brown-medium), var(--brown-dark));\r\n  color: white;\r\n  border-radius: 12px;\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.cart-title {\r\n  font-size: 2.5rem;\r\n  font-weight: 700;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.cart-subtitle {\r\n  font-size: 1.1rem;\r\n  opacity: 0.9;\r\n  margin-bottom: 0;\r\n}\r\n\r\n/* Loading State */\r\n.loading-container {\r\n  text-align: center;\r\n  padding: 4rem 0;\r\n}\r\n\r\n/* Empty Cart State */\r\n.empty-cart {\r\n  text-align: center;\r\n  padding: 4rem 2rem;\r\n  background: white;\r\n  border-radius: 12px;\r\n  box-shadow: var(--shadow);\r\n}\r\n\r\n.empty-cart-icon {\r\n  font-size: 4rem;\r\n  color: var(--brown-light);\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.empty-cart-title {\r\n  color: var(--brown-dark);\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.empty-cart-text {\r\n  color: var(--brown-light);\r\n  font-size: 1.1rem;\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n/* Cart Items */\r\n.items-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.items-count {\r\n  color: var(--brown-dark);\r\n  font-size: 1.5rem;\r\n  margin-bottom: 0;\r\n}\r\n\r\n.cart-items-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1rem;\r\n}\r\n\r\n/* Cart Item Card */\r\n.cart-item-card {\r\n  background: white;\r\n  border-radius: 12px;\r\n  padding: 1.5rem;\r\n  box-shadow: var(--shadow);\r\n  display: flex;\r\n  align