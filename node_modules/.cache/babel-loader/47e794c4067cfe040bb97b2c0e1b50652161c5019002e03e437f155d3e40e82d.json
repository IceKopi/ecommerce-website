{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport axios from '../axios';\nimport $ from 'jquery';\nexport default {\n  data() {\n    return {\n      cart: [],\n      isProcessing: false,\n      orderNumber: ''\n    };\n  },\n  mounted() {\n    const stored = localStorage.getItem('cart');\n    this.cart = stored ? JSON.parse(stored) : [];\n  },\n  methods: {\n    calculateSubtotal() {\n      return this.cart.reduce((total, item) => total + item.price * item.quantity, 0);\n    },\n    calculateTax() {\n      return this.calculateSubtotal() * 0.12;\n    },\n    calculateTotal() {\n      return this.calculateSubtotal() + this.calculateTax();\n    },\n    async checkout() {\n      this.isProcessing = true;\n      try {\n        for (const item of this.cart) {\n          await axios.post('order-items/', {\n            product: item.id,\n            quantity: item.quantity\n          });\n        }\n        const response = await axios.put('orders/complete/');\n\n        // Generate a random order number (in a real app, this would come from the backend)\n        this.orderNumber = 'ORD-' + Math.floor(100000 + Math.random() * 900000);\n\n        // Show receipt modal\n        $('#receiptModal').modal('show');\n\n        // Clear cart from local storage\n        localStorage.removeItem('cart');\n      } catch (err) {\n        console.error(err);\n        alert('❌ Failed to complete checkout. Please try again.');\n      } finally {\n        this.isProcessing = false;\n      }\n    },\n    printReceipt() {\n      window.print();\n    },\n    closeModal() {\n      $('#receiptModal').modal('hide');\n      this.cart = [];\n    }\n  }\n};","map":{"version":3,"names":["axios","$","data","cart","isProcessing","orderNumber","mounted","stored","localStorage","getItem","JSON","parse","methods","calculateSubtotal","reduce","total","item","price","quantity","calculateTax","calculateTotal","checkout","post","product","id","response","put","Math","floor","random","modal","removeItem","err","console","error","alert","printReceipt","window","print","closeModal"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-3\">\r\n    <!-- Main Cart Section -->\r\n    <h2 class=\"mb-4\">My Cart</h2>\r\n    <div v-if=\"!cart || cart.length === 0\" class=\"text-center py-5\">\r\n      <p class=\"text-muted\">Cart is empty.</p>\r\n    </div>\r\n    <div v-else>\r\n      <ul class=\"list-group mb-3\">\r\n        <li\r\n          v-for=\"item in cart\"\r\n          :key=\"item.id\"\r\n          class=\"list-group-item d-flex justify-content-between\"\r\n        >\r\n          <div>\r\n            <h6 class=\"my-0\">{{ item.name }}</h6>\r\n            <small class=\"text-muted\">₱{{ item.price }} × {{ item.quantity }}</small>\r\n          </div>\r\n          <span>₱{{ (item.price * item.quantity).toFixed(2) }}</span>\r\n        </li>\r\n        \r\n        <!-- Price Summary Section -->\r\n        <li class=\"list-group-item d-flex justify-content-between bg-light\">\r\n          <div class=\"text-success\">\r\n            <h6 class=\"my-0\">Subtotal</h6>\r\n          </div>\r\n          <span class=\"text-success\">₱{{ calculateSubtotal().toFixed(2) }}</span>\r\n        </li>\r\n        \r\n        <li class=\"list-group-item d-flex justify-content-between\">\r\n          <div>\r\n            <h6 class=\"my-0\">Tax (12%)</h6>\r\n          </div>\r\n          <span>₱{{ calculateTax().toFixed(2) }}</span>\r\n        </li>\r\n        \r\n        <li class=\"list-group-item d-flex justify-content-between bg-light\">\r\n          <div class=\"text-success\">\r\n            <h6 class=\"my-0 font-weight-bold\">Total</h6>\r\n          </div>\r\n          <strong class=\"text-success\">₱{{ calculateTotal().toFixed(2) }}</strong>\r\n        </li>\r\n      </ul>\r\n      \r\n      <button\r\n        @click=\"checkout\"\r\n        class=\"btn btn-success w-100 mb-3\"\r\n        :disabled=\"isProcessing\"\r\n      >\r\n        {{ isProcessing ? 'Processing...' : 'Checkout' }}\r\n      </button>\r\n    </div>\r\n    \r\n    <!-- Receipt Modal -->\r\n    <div class=\"modal fade\" id=\"receiptModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"receiptModalLabel\" aria-hidden=\"true\">\r\n      <div class=\"modal-dialog\" role=\"document\">\r\n        <div class=\"modal-content\" style=\"background-color: #f8f5f1;\">\r\n          <div class=\"modal-header border-bottom-0\" style=\"background-color: #8B7355;\">\r\n            <h5 class=\"modal-title text-white\" id=\"receiptModalLabel\">Order Receipt</h5>\r\n            <button type=\"button\" class=\"close text-white\" data-dismiss=\"modal\" aria-label=\"Close\">\r\n              <span aria-hidden=\"true\">&times;</span>\r\n            </button>\r\n          </div>\r\n          <div class=\"modal-body\">\r\n            <div class=\"text-center mb-4\">\r\n              <h4 style=\"color: #5E4B3C;\">Thank You For Your Order</h4>\r\n              <p class=\"text-muted\">{{ new Date().toLocaleString() }}</p>\r\n              <p class=\"text-muted\">Order #{{ orderNumber }}</p>\r\n            </div>\r\n            \r\n            <div class=\"px-4\">\r\n              <div class=\"row border-bottom pb-2 text-muted\">\r\n                <div class=\"col-6\">Item</div>\r\n                <div class=\"col-2 text-right\">Price</div>\r\n                <div class=\"col-2 text-center\">Qty</div>\r\n                <div class=\"col-2 text-right\">Total</div>\r\n              </div>\r\n              \r\n              <div v-for=\"item in cart\" :key=\"item.id\" class=\"row py-2 border-bottom\" style=\"color: #5E4B3C;\">\r\n                <div class=\"col-6\">{{ item.name }}</div>\r\n                <div class=\"col-2 text-right\">₱{{ item.price.toFixed(2) }}</div>\r\n                <div class=\"col-2 text-center\">{{ item.quantity }}</div>\r\n                <div class=\"col-2 text-right\">₱{{ (item.price * item.quantity).toFixed(2) }}</div>\r\n              </div>\r\n              \r\n              <div class=\"row py-2\">\r\n                <div class=\"col-8 text-right\">Subtotal:</div>\r\n                <div class=\"col-4 text-right\">₱{{ calculateSubtotal().toFixed(2) }}</div>\r\n              </div>\r\n              \r\n              <div class=\"row py-2\">\r\n                <div class=\"col-8 text-right\">Tax (12%):</div>\r\n                <div class=\"col-4 text-right\">₱{{ calculateTax().toFixed(2) }}</div>\r\n              </div>\r\n              \r\n              <div class=\"row py-2\" style=\"font-weight: bold; color: #5E4B3C;\">\r\n                <div class=\"col-8 text-right\">Total:</div>\r\n                <div class=\"col-4 text-right\">₱{{ calculateTotal().toFixed(2) }}</div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"text-center mt-4\">\r\n              <button type=\"button\" class=\"btn text-white\" style=\"background-color: #8B7355;\" @click=\"printReceipt\">\r\n                Print Receipt\r\n              </button>\r\n            </div>\r\n          </div>\r\n          <div class=\"modal-footer border-top-0 d-flex justify-content-center\" style=\"background-color: #f8f5f1;\">\r\n            <p class=\"mb-0 text-muted small\">Thank you for shopping with us!</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\nimport $ from 'jquery'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      cart: [],\r\n      isProcessing: false,\r\n      orderNumber: '',\r\n    }\r\n  },\r\n  mounted() {\r\n    const stored = localStorage.getItem('cart')\r\n    this.cart = stored ? JSON.parse(stored) : []\r\n  },\r\n  methods: {\r\n    calculateSubtotal() {\r\n      return this.cart.reduce((total, item) => total + (item.price * item.quantity), 0)\r\n    },\r\n    calculateTax() {\r\n      return this.calculateSubtotal() * 0.12\r\n    },\r\n    calculateTotal() {\r\n      return this.calculateSubtotal() + this.calculateTax()\r\n    },\r\n    async checkout() {\r\n      this.isProcessing = true\r\n      try {\r\n        for (const item of this.cart) {\r\n          await axios.post('order-items/', {\r\n            product: item.id,\r\n            quantity: item.quantity\r\n          })\r\n        }\r\n\r\n        const response = await axios.put('orders/complete/')\r\n        \r\n        // Generate a random order number (in a real app, this would come from the backend)\r\n        this.orderNumber = 'ORD-' + Math.floor(100000 + Math.random() * 900000)\r\n        \r\n        // Show receipt modal\r\n        $('#receiptModal').modal('show')\r\n        \r\n        // Clear cart from local storage\r\n        localStorage.removeItem('cart')\r\n      } catch (err) {\r\n        console.error(err)\r\n        alert('❌ Failed to complete checkout. Please try again.')\r\n      } finally {\r\n        this.isProcessing = false\r\n      }\r\n    },\r\n    printReceipt() {\r\n      window.print()\r\n    },\r\n    closeModal() {\r\n      $('#receiptModal').modal('hide')\r\n      this.cart = []\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@media print {\r\n  body * {\r\n    visibility: hidden;\r\n  }\r\n  .modal-content, .modal-content * {\r\n    visibility: visible;\r\n  }\r\n  .modal {\r\n    position: absolute;\r\n    left: 0;\r\n    top: 0;\r\n    margin: 0;\r\n    padding: 0;\r\n    overflow: visible !important;\r\n  }\r\n}\r\n</style>"],"mappings":";;AAqHA,OAAOA,KAAI,MAAO,UAAS;AAC3B,OAAOC,CAAA,MAAO,QAAO;AAErB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,EAAE;MACRC,YAAY,EAAE,KAAK;MACnBC,WAAW,EAAE;IACf;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;IAC1C,IAAI,CAACN,IAAG,GAAII,MAAK,GAAIG,IAAI,CAACC,KAAK,CAACJ,MAAM,IAAI,EAAC;