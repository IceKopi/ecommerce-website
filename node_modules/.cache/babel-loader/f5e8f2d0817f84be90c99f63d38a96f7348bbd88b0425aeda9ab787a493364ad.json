<button type=\"submit\" class=\"login-button\">\r\n            <span class=\"button-text\">Sign In</span>\r\n            <span class=\"button-icon\">→</span>\r\n          </button>\r\n        </form>\r\n        \r\n        <div class=\"login-footer\">\r\n          <p>Don't have an account? <router-link to=\"/register\" class=\"register-link\">Create one</router-link></p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n    \r\n  <script>\r\n  import axios from '../axios'\r\n  import { auth } from '../auth'\r\n  import { ref } from 'vue'\r\n    \r\n  export default {\r\n    name: 'UserLogin',\r\n    setup() {\r\n      const username = ref('')\r\n      const password = ref('')\r\n      \r\n      const login = async () => {\r\n        if (!username.value || !password.value) {\r\n          alert('Please enter both username and password')\r\n          return\r\n        }\r\n        \r\n        try {\r\n          // Step 1: Get access and refresh tokens\r\n          const res = await axios.post('token/', {\r\n            username: username.value,\r\n            password: password.value\r\n          })\r\n          localStorage.setItem('access', res.data.access)\r\n          localStorage.setItem('refresh', res.data.refresh)\r\n          auth.isLoggedIn = true\r\n    \r\n          // Step 2: Get user info\r\n          const user = await axios.get('user/')\r\n          localStorage.setItem('is_staff', user.data.is_staff)\r\n          auth.isStaff = user.data.is_staff\r\n    \r\n          // Step 3: Redirect based on role\r\n          window.location.href = user.data.is_staff ? '/monitor' : '/products'\r\n        } catch (err) {\r\n          alert('Login failed: Check your username or password.')\r\n        }\r\n      }\r\n      \r\n      return {\r\n        username,\r\n        password,\r\n        login\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .login-container {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    min-height: calc(100vh - 70px);\r\n    padding: 2rem 1rem;\r\n    background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.4) 100%);\r\n  }\r\n  \r\n  .login-card {\r\n    width: 100%;\r\n    max-width: 420px;\r\n    padding: 2.5rem;\r\n    border-radius: 20px;\r\n    background-color: rgba(255, 255, 255, 0.85);\r\n    backdrop-filter: blur(10px);\r\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\r\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n  }\r\n  \r\n  .login-card:hover {\r\n    transform: translateY(-5px);\r\n    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);\r\n  }\r\n  \r\n  .login-header {\r\n    text-align: center;\r\n    margin-bottom: 2rem;\r\n  }\r\n  \r\n  .login-header h2 {\r\n    font-weight: 600;\r\n    color: #333;\r\n    margin-bottom: 0.5rem;\r\n    font-size: 1.8rem;\r\n  }\r\n  \r\n  .login-subtitle {\r\n    color: #777;\r\n    font-size: 0.95rem;\r\n  }\r\n  \r\n  .login-form {\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .form-group {\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .password-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 0.5rem;\r\n  }\r\n  \r\n  label {\r\n    display: block;\r\n    margin-bottom: 0.5rem;\r\n    font-weight: 500;\r\n    color: #555;\r\n    font-size: 0.95rem;\r\n  }\r\n  \r\n  .input-wrapper {\r\n    position: relative;\r\n    display: flex;\r\n    align-items: center;\r\n  }\r\n  \r\n  .input-icon {\r\n    position: absolute;\r\n    left: 15px;\r\n    color: #aaa;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  .form-input {\r\n    width: 100%;\r\n    padding: 12px 15px 12px 40px;\r\n    border: 1px solid #e1e1e1;\r\n    border-radius: 25px;\r\n    background-color: rgba(255, 255, 255, 0.8);\r\n    font-size: 0.95rem;\r\n    transition: all 0.3s ease;\r\n  }\r\n  \r\n  .form-input:focus {\r\n    outline: none;\r\n    border-color: #a5a5a5;\r\n    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);\r\n    background-color: #fff;\r\n  }\r\n  \r\n  .form-input::placeholder {\r\n    color: #aaa;\r\n  }\r\n  \r\n  .forgot-link {\r\n    font-size: 0.85rem;\r\n    color: #777;\r\n    text-decoration: none;\r\n    transition: color 0.2s ease;\r\n  }\r\n  \r\n  .forgot-link:hover {\r\n    color: #333;\r\n    text-decoration: underline;\r\n  }\r\n  \r\n  .login-button {\r\n    width: 100%;\r\n    padding: 12px;\r\n    border: none;\r\n    border-radius: 25px;\r\n    background: linear-gradient(135deg, #6a67ce 0%, #8e61d5 100%);\r\n    color: white;\r\n    font-weight: 500;\r\n    font-size: 1rem;\r\n    cursor: pointer;\r\n    transition: all 0.3s ease;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n  }\r\n  \r\n  .login-button:hover {\r\n    background: linear-gradient(135deg, #5d5abc 0%, #7d52c1 100%);\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 5px 15px rgba(106, 103, 206, 0.3);\r\n  }\r\n  \r\n  .button-text {\r\n    margin-right: 10px;\r\n  }\r\n  \r\n  .button-icon {\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .login-button:hover .button-icon {\r\n    transform: translateX(3px);\r\n  }\r\n  \r\n  .login-footer {\r\n    text-align: center;\r\n    color: #777;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  .register-link {\r\n    color: #6a67ce;\r\n    font-weight: 500;\r\n    text-decoration: none;\r\n    transition: color 0.2s ease;\r\n  }\r\n  \r\n  .register-link:hover {\r\n    color: #4f4cb8;\r\n    text-decoration: underline;\r\n  }\r\n  \r\n  @media (max-width: 480px) {\r\n    .login-card {\r\n      padding: 2rem 1.5rem;\r\n    }\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAiB;;EACrBA,KAAK,EAAC;AAAY;;EAOdA,KAAK,EAAC;AAAY;;EAEhBA,KAAK,EAAC;AAAe;;EAYvBA,KAAK,EAAC;AAAY;;EAChBA,KAAK,EAAC;AAAiB;;EAIvBA,KAAK,EAAC;AAAe;;EAmBzBA,KAAK,EAAC;AAAc;;;uBA9C7BC,mBAAA,CAkDM,OAlDNC,UAkDM,GAjDJC,mBAAA,CAgDM,OAhDNC,UAgDM,G,4BA/CJD,mBAAA,CAGM;IAHDH,KAAK,EAAC;EAAc,IACvBG,mBAAA,CAAqB,YAAj