{"ast":null,"code":"import axios from '../axios';\nexport default {\n  data() {\n    return {\n      cart: [],\n      checkingOut: false\n    };\n  },\n  mounted() {\n    const stored = localStorage.getItem('cart');\n    this.cart = stored ? JSON.parse(stored) : [];\n  },\n  methods: {\n    async checkout() {\n      if (!this.cart || this.cart.length === 0) return;\n      try {\n        this.checkingOut = true;\n\n        // Create all order items directly, without creating the order first\n        for (const item of this.cart) {\n          await axios.post('order-items/create/', {\n            product: item.id,\n            quantity: item.quantity\n          });\n        }\n\n        // Then complete the order (this marks the current order as complete)\n        await axios.put('cart/complete/');\n        alert('✅ Order placed successfully!');\n        localStorage.removeItem('cart');\n        this.cart = [];\n      } catch (err) {\n        console.error(err);\n        alert('❌ Failed to complete checkout: ' + (err.response?.data?.detail || err.message));\n      } finally {\n        this.checkingOut = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","cart","checkingOut","mounted","stored","localStorage","getItem","JSON","parse","methods","checkout","length","item","post","product","id","quantity","put","alert","removeItem","err","console","error","response","detail","message"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-3\">\r\n      <h2>My Cart</h2>\r\n      <div v-if=\"!cart || cart.length === 0\">Cart is empty.</div>\r\n      <ul class=\"list-group mb-3\" v-else>\r\n        <li\r\n          v-for=\"item in cart\"\r\n          :key=\"item.id\"\r\n          class=\"list-group-item d-flex justify-content-between\"\r\n        >\r\n          {{ item.name }} x {{ item.quantity }}\r\n          <span>₱{{ item.price * item.quantity }}</span>\r\n        </li>\r\n      </ul>\r\n      <button \r\n        @click=\"checkout\" \r\n        class=\"btn btn-success\" \r\n        :disabled=\"!cart || cart.length === 0 || checkingOut\"\r\n      >\r\n        <span v-if=\"checkingOut\" class=\"spinner-border spinner-border-sm me-2\" role=\"status\"></span>\r\n        Checkout\r\n      </button>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        cart: [],\r\n        checkingOut: false\r\n      }\r\n    },\r\n    mounted() {\r\n      const stored = localStorage.getItem('cart')\r\n      this.cart = stored ? JSON.parse(stored) : []\r\n    },\r\n    methods: {\r\n      async checkout() {\r\n        if (!this.cart || this.cart.length === 0) return\r\n        \r\n        try {\r\n          this.checkingOut = true\r\n          \r\n          // Create all order items directly, without creating the order first\r\n          for (const item of this.cart) {\r\n            await axios.post('order-items/create/', {\r\n              product: item.id,\r\n              quantity: item.quantity\r\n            })\r\n          }\r\n          \r\n          // Then complete the order (this marks the current order as complete)\r\n          await axios.put('cart/complete/')\r\n          \r\n          alert('✅ Order placed successfully!')\r\n          localStorage.removeItem('cart')\r\n          this.cart = []\r\n        } catch (err) {\r\n          console.error(err)\r\n          alert('❌ Failed to complete checkout: ' + (err.response?.data?.detail || err.message))\r\n        } finally {\r\n          this.checkingOut = false\r\n        }\r\n      }\r\n    }\r\n  }\r\n  </script>"],"mappings":"AA0BE,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,EAAE;MACRC,WAAW,EAAE;IACf;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;IAC1C,IAAI,CAACL,IAAG,GAAIG,M