{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from '../axios';\nimport * as bootstrap from 'bootstrap';\nexport default {\n  data() {\n    return {\n      products: [],\n      users: [],\n      newProduct: {\n        name: '',\n        description: '',\n        price: 0,\n        stock: 0\n      },\n      editProduct: {\n        id: null,\n        name: '',\n        description: '',\n        price: 0,\n        stock: 0\n      },\n      selectedImage: null,\n      selectedEditImage: null,\n      modalInstance: null,\n      deleteModalInstance: null,\n      productToDelete: null,\n      currentView: 'grid' // Add this line - default view is grid\n    };\n  },\n  methods: {\n    fullImageUrl(path) {\n      if (path.startsWith('http')) return path;\n      return `http://127.0.0.1:8000${path.startsWith('/') ? path : '/media/' + path}`;\n    },\n    handleImage(e) {\n      this.selectedImage = e.target.files[0];\n    },\n    async fetchProducts() {\n      try {\n        const res = await axios.get('products/');\n        this.products = res.data;\n      } catch (err) {\n        this.showToast('Failed to fetch products', 'danger');\n      }\n    },\n    async addProduct() {\n      const formData = new FormData();\n      for (let key in this.newProduct) {\n        formData.append(key, this.newProduct[key]);\n      }\n      if (this.selectedImage) {\n        formData.append('image', this.selectedImage);\n      }\n      try {\n        await axios.post('products/', formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        this.showToast('Product added successfully!', 'success');\n        this.newProduct = {\n          name: '',\n          description: '',\n          price: 0,\n          stock: 0\n        };\n        this.selectedImage = null;\n        this.fetchProducts();\n        // Close the form\n        const collapseElement = document.getElementById('addProductForm');\n        const bsCollapse = bootstrap.Collapse.getInstance(collapseElement);\n        if (bsCollapse) bsCollapse.hide();\n      } catch (err) {\n        this.showToast('Failed to add product', 'danger');\n      }\n    },\n    confirmDelete(product) {\n      this.productToDelete = product;\n      this.deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteModal'));\n      this.deleteModalInstance.show();\n    },\n    closeDeleteModal() {\n      if (this.deleteModalInstance) this.deleteModalInstance.hide();\n      this.productToDelete = null;\n    },\n    async deleteProduct(id) {\n      if (!id) return;\n      try {\n        await axios.delete(`products/${id}/`);\n        this.showToast('Product deleted successfully', 'success');\n        this.fetchProducts();\n        this.closeDeleteModal();\n      } catch (err) {\n        this.showToast('Cannot delete. Product may be in an order.', 'danger');\n        this.closeDeleteModal();\n      }\n    },\n    openEditModal(product) {\n      this.editProduct = {\n        ...product\n      };\n      this.selectedEditImage = null;\n      this.modalInstance = new bootstrap.Modal(document.getElementById('editModal'));\n      this.modalInstance.show();\n    },\n    closeEditModal() {\n      if (this.modalInstance) this.modalInstance.hide();\n    },\n    async submitEdit() {\n      try {\n        const formData = new FormData();\n        for (let key in this.editProduct) {\n          if (key !== 'image') {\n            formData.append(key, this.editProduct[key]);\n          }\n        }\n        if (this.selectedEditImage) {\n          formData.append('image', this.selectedEditImage);\n        }\n        await axios.patch(`products/${this.editProduct.id}/`, formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        this.showToast('Product updated successfully!', 'success');\n        this.fetchProducts();\n        this.closeEditModal();\n      } catch (err) {\n        console.error(err);\n        this.showToast('Failed to update product', 'danger');\n      }\n    },\n    showToast(message, type = 'primary') {\n      // Create toast container if it doesn't exist\n      let toastContainer = document.getElementById('toast-container');\n      if (!toastContainer) {\n        toastContainer = document.createElement('div');\n        toastContainer.id = 'toast-container';\n        toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3';\n        document.body.appendChild(toastContainer);\n      }\n\n      // Create toast element\n      const toastEl = document.createElement('div');\n      toastEl.className = `toast align-items-center text-white bg-${type} border-0`;\n      toastEl.setAttribute('role', 'alert');\n      toastEl.setAttribute('aria-live', 'assertive');\n      toastEl.setAttribute('aria-atomic', 'true');\n      toastEl.innerHTML = `\n          <div class=\"d-flex\">\n            <div class=\"toast-body\">\n              ${message}\n            </div>\n            <button type=\"button\" class=\"btn-close btn-close-white me-2 m-auto\" data-bs-dismiss=\"toast\" aria-label=\"Close\"></button>\n          </div>\n        `;\n      toastContainer.appendChild(toastEl);\n      const toast = new bootstrap.Toast(toastEl, {\n        autohide: true,\n        delay: 3000\n      });\n      toast.show();\n\n      // Remove toast element after it's hidden\n      toastEl.addEventListener('hidden.bs.toast', () => {\n        toastEl.remove();\n      });\n    }\n  },\n  mounted() {\n    const token = localStorage.getItem('access');\n    const isStaff = localStorage.getItem('is_staff') === 'true';\n    if (!token || !isStaff) {\n      this.showToast('Access denied. Staff only.', 'danger');\n      this.$router.push('/login');\n      return;\n    }\n    this.fetchProducts();\n\n    // Check for saved view preference in localStorage\n    const savedView = localStorage.getItem('productView');\n    if (savedView) {\n      this.currentView = savedView;\n    }\n  },\n  watch: {\n    // Save view preference when it changes\n    currentView(newView) {\n      localStorage.setItem('productView', newView);\n    }\n  }\n};","map":{"version":3,"names":["axios","bootstrap","data","products","users","newProduct","name","description","price","stock","editProduct","id","selectedImage","selectedEditImage","modalInstance","deleteModalInstance","productToDelete","currentView","methods","fullImageUrl","path","startsWith","handleImage","e","target","files","fetchProducts","res","get","err","showToast","addProduct","formData","FormData","key","append","post","headers","collapseElement","document","getElementById","bsCollapse","Collapse","getInstance","hide","confirmDelete","product","Modal","show","closeDeleteModal","deleteProduct","delete","openEditModal","closeEditModal","submitEdit","patch","console","error","message","type","toastContainer","createElement","className","body","appendChild","toastEl","setAttribute","innerHTML","toast","Toast","autohide","delay","addEventListener","remove","mounted","token","localStorage","getItem","isStaff","$router","push","savedView","watch","newView","setItem"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\CheckoutMonitor.vue"],"sourcesContent":["<template>\r\n    <div class=\"container py-5\">\r\n        <div class=\"row\">\r\n            <div class=\"col-lg-10 mx-auto\">\r\n                <!-- Header Section -->\r\n                <div class=\"d-flex justify-content-between align-items-center mb-4\">\r\n                    <h1 class=\"elegant-heading\">\r\n                        <span class=\"elegant-logo me-3\">M</span>Product Management\r\n                    </h1>\r\n                    <button class=\"btn-elegant\" data-bs-toggle=\"collapse\" data-bs-target=\"#addProductForm\"\r\n                        aria-expanded=\"false\">\r\n                        <i class=\"bi bi-plus-circle me-2\"></i>New Product\r\n                    </button>\r\n                </div>\r\n\r\n                   <!-- Add Product Form -->\r\n                   <div class=\"collapse mb-5\" id=\"addProductForm\">\r\n                    <div class=\"elegant-card card-body border-0 shadow-sm\">\r\n                        <h5 class=\"elegant-subheading mb-3\">Add New Product</h5>\r\n                        <form @submit.prevent=\"addProduct\" enctype=\"multipart/form-data\">\r\n                            <div class=\"row g-3\">\r\n                                <div class=\"col-md-6\">\r\n                                    <label class=\"elegant-label\">Product Name</label>\r\n                                    <input v-model=\"newProduct.name\" class=\"elegant-input form-control\" required />\r\n                                </div>\r\n                                <div class=\"col-md-3\">\r\n                                    <label class=\"elegant-label\">Price (₱)</label>\r\n                                    <input v-model.number=\"newProduct.price\" type=\"number\" min=\"0\" step=\"0.01\"\r\n                                        class=\"elegant-input form-control\" required />\r\n                                </div>\r\n                                <div class=\"col-md-3\">\r\n                                    <label class=\"elegant-label\">Stock</label>\r\n                                    <input v-model.number=\"newProduct.stock\" type=\"number\" min=\"0\"\r\n                                        class=\"elegant-input form-control\" required />\r\n                                </div>\r\n                                <div class=\"col-12\">\r\n                                    <label class=\"elegant-label\">Description</label>\r\n                                    <textarea v-model=\"newProduct.description\" class=\"elegant-input form-control\"\r\n                                        rows=\"3\" required></textarea>\r\n                                </div>\r\n                                <div class=\"col-12\">\r\n                                    <label class=\"elegant-label\">Product Image</label>\r\n                                    <input type=\"file\" @change=\"handleImage\" class=\"elegant-input form-control\"\r\n                                        accept=\"image/*\" />\r\n                                </div>\r\n                                <div class=\"col-12 text-end\">\r\n                                    <button type=\"button\" class=\"btn-elegant-secondary me-2\" data-bs-toggle=\"collapse\"\r\n                                        data-bs-target=\"#addProductForm\">\r\n                                        Cancel\r\n                                    </button>\r\n                                    <button type=\"submit\" class=\"btn-elegant\">\r\n                                        <i class=\"bi bi-plus-circle me-2\"></i>Add Product\r\n                                    </button>\r\n                                </div>\r\n                            </div>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Dashboard Section -->\r\n                <div class=\"elegant-card border-0 shadow-sm mb-5\">\r\n                    <div class=\"card-body p-4\">\r\n                        <h5 class=\"elegant-subheading mb-3\">Dashboard Overview</h5>\r\n                        <div class=\"row g-3\">\r\n                            <div class=\"col-md-4\">\r\n                            </div>\r\n                            <div class=\"col-md-4\">\r\n                                <div class=\"dashboard-stat text-center p-3 bg-gradient h-100\">\r\n                                    <i class=\"bi bi-box-seam dashboard-icon\"></i>\r\n                                    <h2 class=\"dashboard-value mt-2\">{{ products ? products.length : 0 }}</h2>\r\n                                    <p class=\"dashboard-label mb-0\">Total Products</p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Products Section -->\r\n                <div class=\"mb-4\">\r\n                    <div class=\"d-flex justify-content-between align-items-center mb-3\">\r\n                        <h4 class=\"elegant-subheading\">Product Catalog</h4>\r\n                        <!-- View Toggle Buttons -->\r\n                        <div class=\"elegant-view-toggle\">\r\n                            <button @click=\"currentView = 'grid'\" class=\"btn-view-toggle\"\r\n                                :class=\"{ active: currentView === 'grid' }\" title=\"Grid View\">\r\n                                <i class=\"bi bi-grid-3x3-gap\"></i>\r\n                            </button>\r\n                            <button @click=\"currentView = 'table'\" class=\"btn-view-toggle\"\r\n                                :class=\"{ active: currentView === 'table' }\" title=\"Table View\">\r\n                                <i class=\"bi bi-list-ul\"></i>\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Product List - Empty State -->\r\n                    <div v-if=\"products.length === 0\" class=\"text-center py-5\">\r\n                        <i class=\"bi bi-box text-secondary display-1\"></i>\r\n                        <p class=\"elegant-text mt-3\">No products found. Add your first product to get started.</p>\r\n                    </div>\r\n\r\n                    <!-- Grid View -->\r\n                    <div v-else-if=\"currentView === 'grid'\" class=\"row g-4\">\r\n                        <div v-for=\"product in products\" :key=\"product.id\" class=\"col-md-6 col-lg-4\">\r\n                            <div class=\"elegant-card card h-100 border-0 shadow-sm hover-shadow transition\">\r\n                                <div class=\"position-relative product-image-container\">\r\n                                    <img v-if=\"product.image\" :src=\"fullImageUrl(product.image)\" :alt=\"product.name\"\r\n                                        class=\"product-image-admin card-img-top\" />\r\n                                    <div v-else class=\"product-image-placeholder\">\r\n                                        <i class=\"bi bi-image text-secondary\"></i>\r\n                                    </div>\r\n                                    <div class=\"position-absolute top-0 end-0 m-2\">\r\n                                        <span class=\"elegant-badge\">\r\n                                            Stock: {{ product.stock }}\r\n                                        </span>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"card-body\">\r\n                                    <h5 class=\"product-title\">{{ product.name }}</h5>\r\n                                    <p class=\"product-price\">₱{{ product.price.toLocaleString() }}</p>\r\n                                    <p class=\"product-description\">{{ product.description }}</p>\r\n                                </div>\r\n                                <div class=\"card-footer bg-white border-0 d-flex justify-content-between\">\r\n                                    <button class=\"btn-elegant-secondary btn-sm\" @click=\"openEditModal(product)\">\r\n                                        <i class=\"bi bi-pencil me-1\"></i>Edit\r\n                                    </button>\r\n                                    <button class=\"btn-elegant-danger btn-sm\" @click=\"confirmDelete(product)\">\r\n                                        <i class=\"bi bi-trash me-1\"></i>Delete\r\n                                    </button>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Table View -->\r\n                    <div v-else class=\"elegant-card border-0 shadow-sm table-responsive\">\r\n                        <table class=\"table elegant-table\">\r\n                            <thead>\r\n                                <tr>\r\n                                    <th class=\"elegant-th\">Image</th>\r\n                                    <th class=\"elegant-th\">Product</th>\r\n                                    <th class=\"elegant-th\">Price</th>\r\n                                    <th class=\"elegant-th\">Stock</th>\r\n                                    <th class=\"elegant-th\">Description</th>\r\n                                    <th class=\"elegant-th text-end\">Actions</th>\r\n                                </tr>\r\n                            </thead>\r\n                            <tbody>\r\n                                <tr v-for=\"product in products\" :key=\"product.id\" class=\"elegant-tr\">\r\n                                    <td class=\"elegant-td\" style=\"width: 80px;\">\r\n                                        <div class=\"table-image-container\">\r\n                                            <img v-if=\"product.image\" :src=\"fullImageUrl(product.image)\"\r\n                                                :alt=\"product.name\" class=\"table-product-image\" />\r\n                                            <div v-else class=\"table-image-placeholder\">\r\n                                                <i class=\"bi bi-image\"></i>\r\n                                            </div>\r\n                                        </div>\r\n                                    </td>\r\n                                    <td class=\"elegant-td fw-medium\">{{ product.name }}</td>\r\n                                    <td class=\"elegant-td\">₱{{ product.price.toLocaleString() }}</td>\r\n                                    <td class=\"elegant-td\">{{ product.stock }}</td>\r\n                                    <td class=\"elegant-td\">\r\n                                        <span class=\"table-description\">{{ product.description }}</span>\r\n                                    </td>\r\n                                    <td class=\"elegant-td text-end\">\r\n                                        <button class=\"btn-elegant-secondary btn-sm me-1\"\r\n                                            @click=\"openEditModal(product)\">\r\n                                            <i class=\"bi bi-pencil\"></i>\r\n                                        </button>\r\n                                        <button class=\"btn-elegant-danger btn-sm\" @click=\"confirmDelete(product)\">\r\n                                            <i class=\"bi bi-trash\"></i>\r\n                                        </button>\r\n                                    </td>\r\n                                </tr>\r\n                            </tbody>\r\n                        </table>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Edit Modal -->\r\n        <div class=\"modal fade\" tabindex=\"-1\" ref=\"editModal\" id=\"editModal\">\r\n            <div class=\"modal-dialog modal-dialog-centered\">\r\n                <div class=\"elegant-modal modal-content border-0 shadow\">\r\n                    <form @submit.prevent=\"submitEdit\">\r\n                        <div class=\"modal-header border-0\">\r\n                            <h5 class=\"elegant-modal-title\">Edit Product</h5>\r\n                            <button type=\"button\" class=\"btn-close\" @click=\"closeEditModal\"></button>\r\n                        </div>\r\n                        <div class=\"modal-body\">\r\n                            <div class=\"mb-3\">\r\n                                <label class=\"elegant-label\">Product Name</label>\r\n                                <input v-model=\"editProduct.name\" class=\"elegant-input form-control\" required />\r\n                            </div>\r\n                            <div class=\"row g-3 mb-3\">\r\n                                <div class=\"col-md-6\">\r\n                                    <label class=\"elegant-label\">Price (₱)</label>\r\n                                    <input type=\"number\" v-model.number=\"editProduct.price\" min=\"0\" step=\"0.01\"\r\n                                        class=\"elegant-input form-control\" required />\r\n                                </div>\r\n                                <div class=\"col-md-6\">\r\n                                    <label class=\"elegant-label\">Stock</label>\r\n                                    <input type=\"number\" v-model.number=\"editProduct.stock\" min=\"0\"\r\n                                        class=\"elegant-input form-control\" required />\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"mb-3\">\r\n                                <label class=\"elegant-label\">Description</label>\r\n                                <textarea v-model=\"editProduct.description\" class=\"elegant-input form-control\" rows=\"3\"\r\n                                    required></textarea>\r\n                            </div>\r\n                            <div class=\"mb-3\">\r\n                                <label class=\"elegant-label\">Product Image</label>\r\n                                <input type=\"file\" @change=\"e => selectedEditImage = e.target.files[0]\"\r\n                                    class=\"elegant-input form-control\" />\r\n                                <div v-if=\"editProduct.image\" class=\"mt-2\">\r\n                                    <img :src=\"fullImageUrl(editProduct.image)\" class=\"elegant-thumbnail\" />\r\n                                    <small class=\"elegant-text-sm d-block mt-1\">Upload a new image to replace the\r\n                                        current one</small>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"modal-footer border-0\">\r\n                            <button type=\"button\" class=\"btn-elegant-secondary\" @click=\"closeEditModal\">Cancel</button>\r\n                            <button type=\"submit\" class=\"btn-elegant\">Save Changes</button>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Delete Confirmation Modal -->\r\n        <div class=\"modal fade\" tabindex=\"-1\" ref=\"deleteModal\" id=\"deleteModal\">\r\n            <div class=\"modal-dialog modal-dialog-centered modal-sm\">\r\n                <div class=\"elegant-modal modal-content border-0 shadow\">\r\n                    <div class=\"modal-header border-0\">\r\n                        <h5 class=\"elegant-modal-title\">Confirm Delete</h5>\r\n                        <button type=\"button\" class=\"btn-close\" @click=\"closeDeleteModal\"></button>\r\n                    </div>\r\n                    <div class=\"modal-body elegant-text\">\r\n                        Are you sure you want to delete <strong>{{ productToDelete?.name }}</strong>?\r\n                    </div>\r\n                    <div class=\"modal-footer border-0\">\r\n                        <button type=\"button\" class=\"btn-elegant-secondary\" @click=\"closeDeleteModal\">Cancel</button>\r\n                        <button type=\"button\" class=\"btn-elegant-danger\"\r\n                            @click=\"deleteProduct(productToDelete?.id)\">Delete</button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\nimport * as bootstrap from 'bootstrap'\r\n\r\nexport default {\r\n    data() {\r\n        return {\r\n            products: [],\r\n            users: [],\r\n            newProduct: { name: '', description: '', price: 0, stock: 0 },\r\n            editProduct: { id: null, name: '', description: '', price: 0, stock: 0 },\r\n            selectedImage: null,\r\n            selectedEditImage: null,\r\n            modalInstance: null,\r\n            deleteModalInstance: null,\r\n            productToDelete: null,\r\n            currentView: 'grid' // Add this line - default view is grid\r\n        }\r\n    },\r\n    methods: {\r\n        fullImageUrl(path) {\r\n            if (path.startsWith('http')) return path\r\n            return `http://127.0.0.1:8000${path.startsWith('/') ? path : '/media/' + path}`\r\n        },\r\n        handleImage(e) {\r\n            this.selectedImage = e.target.files[0]\r\n        },\r\n        async fetchProducts() {\r\n            try {\r\n                const res = await axios.get('products/')\r\n                this.products = res.data\r\n            } catch (err) {\r\n                this.showToast('Failed to fetch products', 'danger')\r\n            }\r\n        },\r\n        async addProduct() {\r\n            const formData = new FormData()\r\n            for (let key in this.newProduct) {\r\n                formData.append(key, this.newProduct[key])\r\n            }\r\n            if (this.selectedImage) {\r\n                formData.append('image', this.selectedImage)\r\n            }\r\n            try {\r\n                await axios.post('products/', formData, {\r\n                    headers: { 'Content-Type': 'multipart/form-data' }\r\n                })\r\n                this.showToast('Product added successfully!', 'success')\r\n                this.newProduct = { name: '', description: '', price: 0, stock: 0 }\r\n                this.selectedImage = null\r\n                this.fetchProducts()\r\n                // Close the form\r\n                const collapseElement = document.getElementById('addProductForm')\r\n                const bsCollapse = bootstrap.Collapse.getInstance(collapseElement)\r\n                if (bsCollapse) bsCollapse.hide()\r\n            } catch (err) {\r\n                this.showToast('Failed to add product', 'danger')\r\n            }\r\n        },\r\n      confirmDelete(product) {\r\n            this.productToDelete = product\r\n            this.deleteModalInstance = new bootstrap.Modal(document.getElementById('deleteModal'))\r\n            this.deleteModalInstance.show()\r\n        },\r\n        closeDeleteModal() {\r\n            if (this.deleteModalInstance) this.deleteModalInstance.hide()\r\n            this.productToDelete = null\r\n        },\r\n        async deleteProduct(id) {\r\n            if (!id) return\r\n\r\n            try {\r\n                await axios.delete(`products/${id}/`)\r\n                this.showToast('Product deleted successfully', 'success')\r\n                this.fetchProducts()\r\n                this.closeDeleteModal()\r\n            } catch (err) {\r\n                this.showToast('Cannot delete. Product may be in an order.', 'danger')\r\n                this.closeDeleteModal()\r\n            }\r\n        },\r\n        openEditModal(product) {\r\n            this.editProduct = { ...product }\r\n            this.selectedEditImage = null\r\n            this.modalInstance = new bootstrap.Modal(document.getElementById('editModal'))\r\n            this.modalInstance.show()\r\n        },\r\n        closeEditModal() {\r\n            if (this.modalInstance) this.modalInstance.hide()\r\n        },\r\n        async submitEdit() {\r\n            try {\r\n                const formData = new FormData()\r\n                for (let key in this.editProduct) {\r\n                    if (key !== 'image') {\r\n                        formData.append(key, this.editProduct[key])\r\n                    }\r\n                }\r\n                if (this.selectedEditImage) {\r\n                    formData.append('image', this.selectedEditImage)\r\n                }\r\n                await axios.patch(`products/${this.editProduct.id}/`, formData, {\r\n                    headers: { 'Content-Type': 'multipart/form-data' }\r\n                })\r\n                this.showToast('Product updated successfully!', 'success')\r\n                this.fetchProducts()\r\n                this.closeEditModal()\r\n            } catch (err) {\r\n                console.error(err)\r\n                this.showToast('Failed to update product', 'danger')\r\n            }\r\n        },\r\n        showToast(message, type = 'primary') {\r\n            // Create toast container if it doesn't exist\r\n            let toastContainer = document.getElementById('toast-container')\r\n            if (!toastContainer) {\r\n                toastContainer = document.createElement('div')\r\n                toastContainer.id = 'toast-container'\r\n                toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3'\r\n                document.body.appendChild(toastContainer)\r\n            }\r\n\r\n            // Create toast element\r\n            const toastEl = document.createElement('div')\r\n            toastEl.className = `toast align-items-center text-white bg-${type} border-0`\r\n            toastEl.setAttribute('role', 'alert')\r\n            toastEl.setAttribute('aria-live', 'assertive')\r\n            toastEl.setAttribute('aria-atomic', 'true')\r\n\r\n            toastEl.innerHTML = `\r\n          <div class=\"d-flex\">\r\n            <div class=\"toast-body\">\r\n              ${message}\r\n            </div>\r\n            <button type=\"button\" class=\"btn-close btn-close-white me-2 m-auto\" data-bs-dismiss=\"toast\" aria-label=\"Close\"></button>\r\n          </div>\r\n        `\r\n\r\n            toastContainer.appendChild(toastEl)\r\n            const toast = new bootstrap.Toast(toastEl, { autohide: true, delay: 3000 })\r\n            toast.show()\