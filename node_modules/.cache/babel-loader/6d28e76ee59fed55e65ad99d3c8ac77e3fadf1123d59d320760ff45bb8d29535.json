{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { auth } from './auth';\nexport default {\n  setup() {\n    return {\n      auth\n    };\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart');\n      localStorage.clear();\n      localStorage.setItem('cart', cart);\n      auth.isLoggedIn = false; // Reset reactivity\n      auth.isStaff = false;\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["auth","setup","methods","logout","cart","localStorage","getItem","clear","setItem","isLoggedIn","isStaff","$router","push"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <nav class=\"navbar navbar-expand-lg shadow-sm py-2\">\n    <div class=\"container-fluid px-4\">\n      <router-link\n        class=\"navbar-brand fw-bold text-primary\"\n        :to=\"auth.isLoggedIn ? (auth.isStaff ? '/monitor' : '/products') : '/login'\"\n      >\n        <span class=\"brand-text\">E-Store</span>\n      </router-link>\n\n      <button \n        class=\"navbar-toggler border-0\" \n        type=\"button\" \n        data-bs-toggle=\"collapse\" \n        data-bs-target=\"#navbarContent\"\n        aria-controls=\"navbarContent\"\n        aria-expanded=\"false\" \n      >\n        <span class=\"navbar-toggler-icon\"></span>\n      </button>\n\n      <div class=\"collapse navbar-collapse\" id=\"navbarContent\">\n        <ul class=\"navbar-nav me-auto mb-2 mb-lg-0\">\n          <!-- STAFF NAVIGATION -->\n          <li class=\"nav-item\" v-if=\"auth.isLoggedIn && auth.isStaff\">\n            <router-link class=\"nav-link\" to=\"/monitor-products\">\n              <i class=\"bi bi-box-seam me-1\"></i> Monitor Products\n            </router-link>\n          </li>\n          <li class=\"nav-item\" v-if=\"auth.isLoggedIn && auth.isStaff\">\n            <router-link class=\"nav-link\" to=\"/add-product\">\n              <i class=\"bi bi-plus-circle me-1\"></i> Add Product\n            </router-link>\n          </li>\n\n          <!-- CUSTOMER NAVIGATION -->\n          <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n            <router-link class=\"nav-link\" to=\"/products\">\n              <i class=\"bi bi-shop me-1\"></i> Home\n            </router-link>\n          </li>\n          <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n            <router-link class=\"nav-link\" to=\"/cart\">\n              <i class=\"bi bi-cart me-1\"></i> Cart\n            </router-link>\n          </li>\n          <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n            <router-link class=\"nav-link\" to=\"/orders\">\n              <i class=\"bi bi-box me-1\"></i> My Orders\n            </router-link>\n          </li>\n        </ul>\n\n        <ul class=\"navbar-nav ms-auto\">\n          <!-- Show Login/Register only if LOGGED OUT -->\n          <li class=\"nav-item\" v-if=\"!auth.isLoggedIn\">\n            <router-link\n              class=\"nav-link btn-link\"\n              v-if=\"$route.name === 'register'\"\n              to=\"/login\"\n            >Login</router-link>\n          </li>\n\n          <!-- Show Logout if LOGGED IN -->\n          <li class=\"nav-item\" v-if=\"auth.isLoggedIn\">\n            <button class=\"btn btn-outline-primary rounded-pill px-3\" @click=\"logout\">\n              <i class=\"bi bi-box-arrow-right me-1\"></i> Logout\n            </button>\n          </li>\n        </ul>\n      </div>\n    </div>\n  </nav>\n\n  <router-view />\n</template>\n\n<script>\nimport { auth } from './auth'\n\nexport default {\n  setup() {\n    return { auth }\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart')\n      localStorage.clear()\n      localStorage.setItem('cart', cart)\n\n      auth.isLoggedIn = false        // Reset reactivity\n      auth.isStaff = false\n\n      this.$router.push('/login')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.navbar {\n  background-color: #ffffff;\n  transition: all 0.3s ease;\n  border-bottom: 1px solid rgba(0,0,0,0.05);\n}\n\n.navbar-brand {\n  font-family: 'Playfair Display', serif;\n  letter-spacing: 1px;\n}\n\n.brand-text {\n  background: linear-gradient(45deg, #4a6fa5, #6a8caf);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  font-size: 1.5rem;\n}\n\n.nav-link {\n  font-weight: 500;\n  transition: color 0.2s;\n  font-size: 0.95rem;\n  padding: 0.5rem 1rem;\n  position: relative;\n}\n\n.nav-link:hover {\n  color: #4a6fa5;\n}\n\n.nav-link.router-link-active {\n  color: #4a6fa5;\n}\n\n.nav-link.router-link-active::after {\n  content: '';\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  width: 100%;\n  height: 2px;\n  background-color: #4a6fa5;\n  transform: scaleX(0.7);\n  transition: transform 0.2s;\n}\n\n.nav-link:hover.router-link-active::after {\n  transform: scaleX(1);\n}\n\n.btn-outline-primary {\n  border-color: #4a6fa5;\n  color: #4a6fa5;\n  transition: all 0.3s ease;\n}\n\n.btn-outline-primary:hover {\n  background-color: #4a6fa5;\n  color: white;\n}\n\n/* Add this to your app's global styles to ensure Bootstrap icons work */\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css\");\n</style>"],"mappings":";AA8EA,SAASA,IAAG,QAAS,QAAO;AAE5B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,OAAO;MAAED;IAAK;EAChB,CAAC;EACDE,OAAO,EAAE;IACPC,MAAMA,CAAA,EAAG;MACP,MAAMC,IAAG,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;MACxCD,YAAY,CAACE,KAAK,CAAC;MACnBF,YAAY,CAACG,OAAO,CAAC,MAAM,EAAEJ,IAAI;MAEjCJ,IAAI,CAACS,UAAS,GAAI,KAAI,EAAS;MAC/BT,IAAI,CAACU,OAAM,GAAI,KAAI;MAEnB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ;IAC5B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}