{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nexport default {\n  data() {\n    return {\n      orders: [],\n      filteredOrders: [],\n      selectedOrder: null,\n      selectedOrderIndex: -1,\n      filters: {\n        startDate: null,\n        endDate: null\n      }\n    };\n  },\n  mounted() {\n    const stored = localStorage.getItem('orderHistory');\n    this.orders = stored ? JSON.parse(stored) : [];\n    this.filteredOrders = [...this.orders];\n  },\n  methods: {\n    openOrderDetailModal(order, index) {\n      this.selectedOrder = order;\n      this.selectedOrderIndex = index;\n      const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));\n      modal.show();\n    },\n    calculateTotal(items) {\n      return items.reduce((sum, item) => sum + item.price * item.quantity, 0);\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return new Intl.DateTimeFormat('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      }).format(date);\n    },\n    applyFilters() {\n      const start = this.filters.startDate ? new Date(this.filters.startDate) : null;\n      const end = this.filters.endDate ? new Date(this.filters.endDate) : null;\n      if (end) end.setHours(23, 59, 59, 999);\n      this.filteredOrders = this.orders.filter(order => {\n        const orderDate = new Date(order.date_ordered);\n        return (!start || orderDate >= start) && (!end || orderDate <= end);\n      });\n    },\n    resetFilters() {\n      this.filters.startDate = null;\n      this.filters.endDate = null;\n      this.filteredOrders = [...this.orders];\n    }\n  }\n};","map":{"version":3,"names":["data","orders","filteredOrders","selectedOrder","selectedOrderIndex","filters","startDate","endDate","mounted","stored","localStorage","getItem","JSON","parse","methods","openOrderDetailModal","order","index","modal","bootstrap","Modal","document","getElementById","show","calculateTotal","items","reduce","sum","item","price","quantity","formatDate","dateString","date","Date","Intl","DateTimeFormat","year","month","day","hour","minute","format","applyFilters","start","end","setHours","filter","orderDate","date_ordered","resetFilters"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\views\\CustomerTransaction.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-5\">\r\n    <div class=\"row justify-content-center\">\r\n      <div class=\"col-lg-10\">\r\n        <h3 class=\"mb-4 fw-light text-center display-6\">\r\n          <i class=\"bi bi-bag-check\"></i> My Order History\r\n        </h3>\r\n\r\n        <!-- Date Filter -->\r\n        <div class=\"card shadow-sm border-0 mb-4\">\r\n          <div class=\"card-body\">\r\n            <div class=\"row align-items-center\">\r\n              <div class=\"col-md-5\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"startDate\" class=\"form-label text-brown\">From Date</label>\r\n                  <input type=\"date\" class=\"form-control\" id=\"startDate\" v-model=\"filters.startDate\" @change=\"applyFilters\">\r\n                </div>\r\n              </div>\r\n              <div class=\"col-md-5\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"endDate\" class=\"form-label text-brown\">To Date</label>\r\n                  <input type=\"date\" class=\"form-control\" id=\"endDate\" v-model=\"filters.endDate\" @change=\"applyFilters\">\r\n                </div>\r\n              </div>\r\n              <div class=\"col-md-2 d-flex align-items-end\">\r\n                <button class=\"btn btn-light w-100\" @click=\"resetFilters\">Reset</button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- No Orders Message -->\r\n        <div class=\"card shadow-sm border-0 mb-4\" v-if=\"filteredOrders.length === 0\">\r\n          <div class=\"card-body text-center p-5 text-muted\">\r\n            <i class=\"bi bi-bag-x fs-1\"></i>\r\n            <p class=\"mt-3\">No orders found.</p>\r\n            <button class=\"btn btn-light mt-2\" @click=\"$router.push('/shop')\">\r\n              Start Shopping\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Order Cards -->\r\n        <div v-for=\"(order, index) in filteredOrders\" :key=\"index\" class=\"card mb-3 shadow-sm border-0\">\r\n          <div class=\"card-header bg-transparent border-bottom-0 pt-3\">\r\n            <div class=\"d-flex justify-content-between align-items-center\">\r\n              <h6 class=\"fw-normal text-brown mb-0\">Order #{{ index + 1 }}</h6>\r\n              <div>\r\n                <span class=\"badge bg-soft-brown text-brown\">{{ formatDate(order.date_ordered) }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"card-body pt-0\">\r\n            <div class=\"items-list mb-3\">\r\n              <div v-for=\"(item, i) in order.items\" :key=\"i\" class=\"d-flex justify-content-between align-items-center py-2 border-bottom border-light\">\r\n                <div>\r\n                  <span class=\"fw-medium\">{{ item.product_name }}</span>\r\n                  <span class=\"text-muted ms-2\">× {{ item.quantity }}</span>\r\n                </div>\r\n                <span class=\"text-brown\">₱{{ parseFloat(item.price).toFixed(2) }}</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"d-flex justify-content-between align-items-center\">\r\n              <span class=\"fw-bold\">Total: <span class=\"text-brown\">₱{{ calculateTotal(order.items).toFixed(2) }}</span></span>\r\n              <button class=\"btn btn-outline-brown px-4\" @click=\"openOrderDetailModal(order, index)\">\r\n                <i class=\"bi bi-info-circle me-1\"></i> View Details\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Order Detail Modal -->\r\n    <div class=\"modal fade\" id=\"orderDetailModal\" tabindex=\"-1\">\r\n      <div class=\"modal-dialog modal-dialog-centered\">\r\n        <div class=\"modal-content border-0\">\r\n          <div class=\"modal-header border-0\">\r\n            <h5 class=\"modal-title fw-light text-brown\">\r\n              Order #{{ selectedOrderIndex + 1 }} Details\r\n            </h5>\r\n            <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n          </div>\r\n          <div class=\"modal-body\" v-if=\"selectedOrder\">\r\n            <div class=\"order-detail-container p-4\">\r\n              <div class=\"text-center mb-4\">\r\n                <h4 class=\"fw-light text-uppercase mb-2\">ORDER DETAILS</h4>\r\n                <p class=\"mb-1 small\">Order #{{ selectedOrderIndex + 1 }}</p>\r\n                <p class=\"small text-muted\">{{ formatDate(selectedOrder.date_ordered) }}</p>\r\n                <div class=\"separator my-3 mx-auto\"></div>\r\n              </div>\r\n              <h5 class=\"fw-light mb-3\">Items</h5>\r\n              <table class=\"table receipt-table\">\r\n                <thead class=\"table-light\">\r\n                  <tr class=\"text-brown\">\r\n                    <th class=\"fw-medium\">Item</th>\r\n                    <th class=\"fw-medium\">Qty</th>\r\n                    <th class=\"text-end fw-medium\">Price</th>\r\n                    <th class=\"text-end fw-medium\">Total</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody>\r\n                  <tr v-for=\"(item, i) in selectedOrder.items\" :key=\"i\">\r\n                    <td>{{ item.product_name }}</td>\r\n                    <td>{{ item.quantity }}</td>\r\n                    <td class=\"text-end\">₱{{ parseFloat(item.price).toFixed(2) }}</td>\r\n                    <td class=\"text-end\">₱{{ (item.price * item.quantity).toFixed(2) }}</td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td colspan=\"3\" class=\"text-end border-0\">Subtotal</td>\r\n                    <td class=\"text-end border-0\">₱{{ calculateTotal(selectedOrder.items).toFixed(2) }}</td>\r\n                  </tr>\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n          </div>\r\n          <div class=\"modal-footer border-0\">\r\n            <button type=\"button\" class=\"btn btn-light\" data-bs-dismiss=\"modal\">Close</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      orders: [],\r\n      filteredOrders: [],\r\n      selectedOrder: null,\r\n      selectedOrderIndex: -1,\r\n      filters: {\r\n        startDate: null,\r\n        endDate: null\r\n      }\r\n    }\r\n  },\r\n  mounted() {\r\n    const stored = localStorage.getItem('orderHistory')\r\n    this.orders = stored ? JSON.parse(stored) : []\r\n    this.filteredOrders = [...this.orders]\r\n  },\r\n  methods: {\r\n    openOrderDetailModal(order, index) {\r\n      this.selectedOrder = order\r\n      this.selectedOrderIndex = index\r\n      const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'))\r\n      modal.show()\r\n    },\r\n    calculateTotal(items) {\r\n      return items.reduce((sum, item) => sum + item.price * item.quantity, 0)\r\n    },\r\n    formatDate(dateString) {\r\n      const date = new Date(dateString)\r\n      return new Intl.DateTimeFormat('en-US', {\r\n        year: 'numeric',\r\n        month: 'short',\r\n        day: 'numeric',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      }).format(date)\r\n    },\r\n    applyFilters() {\r\n      const start = this.filters.startDate ? new Date(this.filters.startDate) : null\r\n      const end = this.filters.endDate ? new Date(this.filters.endDate) : null\r\n      if (end) end.setHours(23, 59, 59, 999)\r\n\r\n      this.filteredOrders = this.orders.filter(order => {\r\n        const orderDate = new Date(order.date_ordered)\r\n        return (!start || orderDate >= start) && (!end || orderDate <= end)\r\n      })\r\n    },\r\n    resetFilters() {\r\n      this.filters.startDate = null\r\n      this.filters.endDate = null\r\n      this.filteredOrders = [...this.orders]\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":";;;AA8HA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,EAAE;MACVC,cAAc,EAAE,EAAE;MAClBC,aAAa,EAAE,IAAI;MACnBC,kBAAkB,EAAE,CAAC,CAAC;MACtBC,OAAO,EAAE;QACPC,SAAS,EAAE,IAAI;QACfC,OAAO,EAAE;MACX;IACF;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAIC,YAAY,CAACC,OAAO,CAAC,cAAc;IAClD,IAAI,CAACV,MAAK,GAAIQ,MAAK,GAAIG,IAAI,CAACC,KAAK,CAACJ,MAAM,IAAI,EAAC;IAC7C,IAAI,CAACP,cAAa,GAAI,CAAC,GAAG,IAAI,CAACD,MAAM;EACvC,CAAC;EACDa,OAAO,EAAE;IACPC,oBAAoBA,CAACC,KAAK,EAAEC,KAAK,EAAE;MACjC,IAAI,CAACd,aAAY,GAAIa,KAAI;MACzB,IAAI,CAACZ,kBAAiB,GAAIa,KAAI;MAC9B,MAAMC,KAAI,GAAI,IAAIC,SAAS,CAACC,KAAK,CAACC,QAAQ,CAACC,cAAc,CAAC,kBAAkB,CAAC;MAC7EJ,KAAK,CAACK,IAAI,CAAC;IACb,CAAC;IACDC,cAAcA,CAACC,KAAK,EAAE;MACpB,OAAOA,KAAK,CAACC,MAAM,CAAC,CAACC,GAAG,EAAEC,IAAI,KAAKD,GAAE,GAAIC,IAAI,CAACC,KAAI,GAAID,IAAI,CAACE,QAAQ,EAAE,CAAC;IACxE,CAAC;IACDC,UAAUA,CAACC,UAAU,EAAE;MACrB,MAAMC,IAAG,GAAI,IAAIC,IAAI,CAACF,UAAU;MAChC,OAAO,IAAIG,IAAI,CAACC,cAAc,CAAC,OAAO,EAAE;QACtCC,IAAI,EAAE,SAAS;QACfC,KAAK,EAAE,OAAO;QACdC,GAAG,EAAE,SAAS;QACdC,IAAI,EAAE,SAAS;QACfC,MAAM,EAAE;MACV,CAAC,CAAC,CAACC,MAAM,CAACT,IAAI;IAChB,CAAC;IACDU,YAAYA,CAAA,EAAG;MACb,MAAMC,KAAI,GAAI,IAAI,CAACvC,OAAO,CAACC,SAAQ,GAAI,IAAI4B,IAAI,CAAC,IAAI,CAAC7B,OAAO,CAACC,SAAS,IAAI,IAAG;MAC7E,MAAMuC,GAAE,GAAI,IAAI,CAACxC,OAAO,CAACE,OAAM,GAAI,IAAI2B,IAAI,CAAC,IAAI,CAAC7B,OAAO,CAACE,OAAO,IAAI,IAAG;MACvE,IAAIsC,GAAG,EAAEA,GAAG,CAACC,QAAQ,CAAC,EAAE,EAAE,