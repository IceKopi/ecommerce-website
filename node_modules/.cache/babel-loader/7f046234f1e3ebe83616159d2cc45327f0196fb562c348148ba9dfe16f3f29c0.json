{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from '../axios';\nimport * as bootstrap from 'bootstrap';\nexport default {\n  data() {\n    return {\n      products: [],\n      newProduct: {\n        name: '',\n        description: '',\n        price: 0,\n        stock: 0\n      },\n      editProduct: {\n        id: null,\n        name: '',\n        description: '',\n        price: 0,\n        stock: 0\n      },\n      selectedImage: null,\n      selectedEditImage: null,\n      modalInstance: null\n    };\n  },\n  methods: {\n    fullImageUrl(path) {\n      if (path.startsWith('http')) return path;\n      return `http://127.0.0.1:8000${path.startsWith('/') ? path : '/media/' + path}`;\n    },\n    handleImage(e) {\n      this.selectedImage = e.target.files[0];\n    },\n    async fetchProducts() {\n      try {\n        const res = await axios.get('products/');\n        this.products = res.data;\n      } catch (err) {\n        this.showNotification('Failed to fetch products', 'error');\n      }\n    },\n    async addProduct() {\n      const formData = new FormData();\n      for (let key in this.newProduct) {\n        formData.append(key, this.newProduct[key]);\n      }\n      if (this.selectedImage) {\n        formData.append('image', this.selectedImage);\n      }\n      try {\n        await axios.post('products/', formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        this.showNotification('Product added successfully', 'success');\n        this.newProduct = {\n          name: '',\n          description: '',\n          price: 0,\n          stock: 0\n        };\n        this.selectedImage = null;\n        this.fetchProducts();\n      } catch (err) {\n        this.showNotification('Failed to add product', 'error');\n      }\n    },\n    confirmDelete(id) {\n      if (confirm('Are you sure you want to delete this product?')) {\n        this.deleteProduct(id);\n      }\n    },\n    async deleteProduct(id) {\n      try {\n        await axios.delete(`products/${id}/`);\n        this.showNotification('Product deleted successfully', 'success');\n        this.fetchProducts();\n      } catch (err) {\n        this.showNotification('Cannot delete. Product may be in an order.', 'error');\n      }\n    },\n    openEditModal(product) {\n      this.editProduct = {\n        ...product\n      };\n      this.selectedEditImage = null;\n      this.modalInstance = new bootstrap.Modal(this.$refs.editModal);\n      this.modalInstance.show();\n    },\n    closeEditModal() {\n      if (this.modalInstance) this.modalInstance.hide();\n    },\n    async submitEdit() {\n      try {\n        const formData = new FormData();\n        for (let key in this.editProduct) {\n          if (key !== 'image') {\n            formData.append(key, this.editProduct[key]);\n          }\n        }\n        if (this.selectedEditImage) {\n          formData.append('image', this.selectedEditImage);\n        }\n        await axios.patch(`products/${this.editProduct.id}/`, formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        this.showNotification('Product updated successfully', 'success');\n        this.fetchProducts();\n        this.closeEditModal();\n      } catch (err) {\n        console.error(err);\n        this.showNotification('Failed to update product', 'error');\n      }\n    },\n    showNotification(message, type = 'info') {\n      const toastClasses = {\n        success: 'bg-green-50 text-green-700 border-green-200',\n        error: 'bg-red-50 text-red-700 border-red-200',\n        info: 'bg-blue-50 text-blue-700 border-blue-200'\n      };\n      const toast = document.createElement('div');\n      toast.className = `fixed top-4 right-4 py-2 px-4 rounded shadow-md border ${toastClasses[type]} transition-all`;\n      toast.style.zIndex = '9999';\n      toast.textContent = message;\n      document.body.appendChild(toast);\n      setTimeout(() => {\n        toast.style.opacity = '0';\n        setTimeout(() => document.body.removeChild(toast), 300);\n      }, 3000);\n    }\n  },\n  mounted() {\n    const token = localStorage.getItem('access');\n    const isStaff = localStorage.getItem('is_staff') === 'true';\n    if (!token || !isStaff) {\n      this.showNotification('Access denied. Staff only.', 'error');\n      this.$router.push('/login');\n      return;\n    }\n    this.fetchProducts();\n  }\n};","map":{"version":3,"names":["axios","bootstrap","data","products","newProduct","name","description","price","stock","editProduct","id","selectedImage","selectedEditImage","modalInstance","methods","fullImageUrl","path","startsWith","handleImage","e","target","files","fetchProducts","res","get","err","showNotification","addProduct","formData","FormData","key","append","post","headers","confirmDelete","confirm","deleteProduct","delete","openEditModal","product","Modal","$refs","editModal","show","closeEditModal","hide","submitEdit","patch","console","error","message","type","toastClasses","success","info","toast","document","createElement","className","style","zIndex","textContent","body","appendChild","setTimeout","opacity","removeChild","mounted","token","localStorage","getItem","isStaff","$router","push"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\CheckoutMonitor.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mx-auto p-6 max-w-5xl\">\r\n      <div class=\"text-center mb-8\">\r\n        <h1 class=\"text-3xl font-serif text-gray-800 mb-2\">Bogsh Product Management</h1>\r\n        <p class=\"text-gray-500 italic\">Manage your product catalog with elegance</p>\r\n      </div>\r\n  \r\n      <!-- Add Product Card -->\r\n      <div class=\"bg-white rounded-lg shadow-md p-6 mb-8 transition-all hover:shadow-lg\">\r\n        <h2 class=\"text-xl font-serif text-gray-700 mb-4 flex items-center\">\r\n          <span class=\"mr-2\">Add New Product</span>\r\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-gray-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6v6m0 0v6m0-6h6m-6 0H6\" />\r\n          </svg>\r\n        </h2>\r\n        \r\n        <form @submit.prevent=\"addProduct\" class=\"space-y-4\" enctype=\"multipart/form-data\">\r\n          <div class=\"grid md:grid-cols-2 gap-4\">\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Product Name</label>\r\n              <input \r\n                v-model=\"newProduct.name\" \r\n                placeholder=\"Enter product name\" \r\n                class=\"w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400 outline-none transition-colors\" \r\n                required \r\n              />\r\n            </div>\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Price (₱)</label>\r\n              <input \r\n                v-model.number=\"newProduct.price\" \r\n                placeholder=\"0.00\" \r\n                type=\"number\" \r\n                min=\"0\" \r\n                step=\"0.01\"\r\n                class=\"w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400 outline-none transition-colors\" \r\n                required \r\n              />\r\n            </div>\r\n          </div>\r\n          \r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Description</label>\r\n            <textarea \r\n              v-model=\"newProduct.description\" \r\n              placeholder=\"Enter product description\" \r\n              rows=\"2\"\r\n              class=\"w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400 outline-none transition-colors\" \r\n              required\r\n            ></textarea>\r\n          </div>\r\n          \r\n          <div class=\"grid md:grid-cols-2 gap-4\">\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Stock Quantity</label>\r\n              <input \r\n                v-model.number=\"newProduct.stock\" \r\n                placeholder=\"0\" \r\n                type=\"number\" \r\n                min=\"0\" \r\n                class=\"w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400 outline-none transition-colors\" \r\n                required \r\n              />\r\n            </div>\r\n            <div>\r\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Product Image</label>\r\n              <input \r\n                type=\"file\" \r\n                @change=\"handleImage\" \r\n                class=\"w-full px-4 py-2 border border-gray-300 rounded-md file:mr-4 file:py-1 file:px-4 file:rounded-md file:border-0 file:text-sm file:bg-indigo-50 file:text-indigo-700\" \r\n                accept=\"image/*\" \r\n              />\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"text-right\">\r\n            <button \r\n              type=\"submit\"\r\n              class=\"px-6 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors\"\r\n            >\r\n              Add Product\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n  \r\n      <!-- Products List Section -->\r\n      <div class=\"bg-white rounded-lg shadow-md p-6\">\r\n        <h2 class=\"text-xl font-serif text-gray-700 mb-6 flex items-center\">\r\n          <span class=\"mr-2\">Product Catalog</span>\r\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-gray-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\" />\r\n          </svg>\r\n        </h2>\r\n  \r\n        <!-- Empty state -->\r\n        <div v-if=\"products.length === 0\" class=\"text-center py-12\">\r\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-16 w-16 mx-auto text-gray-300 mb-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1\" d=\"M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4\" />\r\n          </svg>\r\n          <p class=\"text-gray-500\">No products found. Add your first product above.</p>\r\n        </div>\r\n  \r\n        <!-- Product Grid -->\r\n        <div v-else class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\r\n          <div \r\n            v-for=\"product in products\" \r\n            :key=\"product.id\" \r\n            class=\"border border-gray-100 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow\"\r\n          >\r\n            <!-- Product Image -->\r\n            <div class=\"h-48 bg-gray-100 overflow-hidden relative\">\r\n              <img\r\n                v-if=\"product.image\"\r\n                :src=\"fullImageUrl(product.image)\"\r\n                alt=\"Product image\"\r\n                class=\"w-full h-full object-cover\"\r\n              />\r\n              <div v-else class=\"flex items-center justify-center h-full bg-gray-50\">\r\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-12 w-12 text-gray-300\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\" />\r\n                </svg>\r\n              </div>\r\n            </div>\r\n            \r\n            <!-- Product Info -->\r\n            <div class=\"p-4\">\r\n              <h3 class=\"font-medium text-gray-800 mb-1\">{{ product.name }}</h3>\r\n              <p class=\"text-gray-600 text-sm mb-3 line-clamp-2\">{{ product.description }}</p>\r\n              \r\n              <div class=\"flex justify-between items-center mb-4\">\r\n                <span class=\"text-indigo-600 font-medium\">₱{{ product.price.toLocaleString() }}</span>\r\n                <span class=\"text-gray-500 text-sm\">Stock: {{ product.stock }}</span>\r\n              </div>\r\n              \r\n              <!-- Actions -->\r\n              <div class=\"flex space-x-2\">\r\n                <button \r\n                  @click=\"openEditModal(product)\" \r\n                  class=\"flex-1 py-1.5 bg-white border border-gray-300 rounded text-gray-700 text-sm hover:bg-gray-50 transition-colors\"\r\n                >\r\n                  Edit\r\n                </button>\r\n                <button \r\n                  @click=\"confirmDelete(product.id)\" \r\n                  class=\"flex-1 py-1.5 bg-white border border-gray-300 rounded text-red-600 text-sm hover:bg-red-50 transition-colors\"\r\n                >\r\n                  Delete\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- Edit Modal -->\r\n      <div class=\"modal fade\" tabindex=\"-1\" ref=\"editModal\" id=\"editModal\">\r\n        <div class=\"modal-dialog modal-dialog-centered\">\r\n          <div class=\"modal-content border-0 shadow-lg rounded-lg\">\r\n            <form @submit.prevent=\"submitEdit\">\r\n              <div class=\"modal-header border-bottom bg-gray-50\">\r\n                <h5 class=\"modal-title font-serif\">Edit Product</h5>\r\n                <button type=\"button\" class=\"btn-close\" @click=\"closeEditModal\"></button>\r\n              </div>\r\n              <div class=\"modal-body p-4\">\r\n                <div class=\"mb-3\">\r\n                  <label class=\"form-label text-sm font-medium text-gray-700\">Product Name</label>\r\n                  <input v-model=\"editProduct.name\" class=\"form-control\" required />\r\n                </div>\r\n                <div class=\"mb-3\">\r\n                  <label class=\"form-label text-sm font-medium text-gray-700\">Description</label>\r\n                  <textarea v-model=\"editProduct.description\" class=\"form-control\" rows=\"2\" required></textarea>\r\n                </div>\r\n                <div class=\"row g-3 mb-3\">\r\n                  <div class=\"col-md-6\">\r\n                    <label class=\"form-label text-sm font-medium text-gray-700\">Price (₱)</label>\r\n                    <input type=\"number\" v-model.number=\"editProduct.price\" class=\"form-control\" min=\"0\" step=\"0.01\" required />\r\n                  </div>\r\n                  <div class=\"col-md-6\">\r\n                    <label class=\"form-label text-sm font-medium text-gray-700\">Stock</label>\r\n                    <input type=\"number\" v-model.number=\"editProduct.stock\" class=\"form-control\" min=\"0\" required />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label class=\"form-label text-sm font-medium text-gray-700\">Product Image</label>\r\n                  <input type=\"file\" @change=\"e => selectedEditImage = e.target.files[0]\" class=\"form-control\" />\r\n                </div>\r\n              </div>\r\n              <div class=\"modal-footer border-top\">\r\n                <button type=\"button\" class=\"btn btn-outline-secondary\" @click=\"closeEditModal\">Cancel</button>\r\n                <button type=\"submit\" class=\"btn btn-indigo\">Save Changes</button>\r\n              </div>\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  import * as bootstrap from 'bootstrap'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        products: [],\r\n        newProduct: { name: '', description: '', price: 0, stock: 0 },\r\n        editProduct: { id: null, name: '', description: '', price: 0, stock: 0 },\r\n        selectedImage: null,\r\n        selectedEditImage: null,\r\n        modalInstance: null\r\n      }\r\n    },\r\n    methods: {\r\n      fullImageUrl(path) {\r\n        if (path.startsWith('http')) return path\r\n        return `http://127.0.0.1:8000${path.startsWith('/') ? path : '/media/' + path}`\r\n      },\r\n      handleImage(e) {\r\n        this.selectedImage = e.target.files[0]\r\n      },\r\n      async fetchProducts() {\r\n        try {\r\n          const res = await axios.get('products/')\r\n          this.products = res.data\r\n        } catch (err) {\r\n          this.showNotification('Failed to fetch products', 'error')\r\n        }\r\n      },\r\n      async addProduct() {\r\n        const formData = new FormData()\r\n        for (let key in this.newProduct) {\r\n          formData.append(key, this.newProduct[key])\r\n        }\r\n        if (this.selectedImage) {\r\n          formData.append('image', this.selectedImage)\r\n        }\r\n        try {\r\n          await axios.post('products/', formData, {\r\n            headers: { 'Content-Type': 'multipart/form-data' }\r\n          })\r\n          this.showNotification('Product added successfully', 'success')\r\n          this.newProduct = { name: '', description: '', price: 0, stock: 0 }\r\n          this.selectedImage = null\r\n          this.fetchProducts()\r\n        } catch (err) {\r\n          this.showNotification('Failed to add product', 'error')\r\n        }\r\n      },\r\n      confirmDelete(id) {\r\n        if (confirm('Are you sure you want to delete this product?')) {\r\n          this.deleteProduct(id)\r\n        }\r\n      },\r\n      async deleteProduct(id) {\r\n        try {\r\n          await axios.delete(`products/${id}/`)\r\n          this.showNotification('Product deleted successfully', 'success')\r\n          this.fetchProducts()\r\n        } catch (err) {\r\n          this.showNotification('Cannot delete. Product may be in an order.', 'error')\r\n        }\r\n      },\r\n      openEditModal(product) {\r\n        this.editProduct = { ...product }\r\n        this.selectedEditImage = null\r\n        this.modalInstance = new bootstrap.Modal(this.$refs.editModal)\r\n        this.modalInstance.show()\r\n      },\r\n      closeEditModal() {\r\n        if (this.modalInstance) this.modalInstance.hide()\r\n      },\r\n      async submitEdit() {\r\n        try {\r\n          const formData = new FormData()\r\n          for (let key in this.editProduct) {\r\n            if (key !== 'image') {\r\n              formData.append(key, this.editProduct[key])\r\n            }\r\n          }\r\n          if (this.selectedEditImage) {\r\n            formData.append('image', this.selectedEditImage)\r\n          }\r\n          await axios.patch(`products/${this.editProduct.id}/`, formData, {\r\n            headers: { 'Content-Type': 'multipart/form-data' }\r\n          })\r\n          this.showNotification('Product updated successfully', 'success')\r\n          this.fetchProducts()\r\n          this.closeEditModal()\r\n        } catch (err) {\r\n          console.error(err)\r\n          this.showNotification('Failed to update product', 'error')\r\n        }\r\n      },\r\n      showNotification(message, type = 'info') {\r\n        const toastClasses = {\r\n          success: 'bg-green-50 text-green-700 border-green-200',\r\n          error: 'bg-red-50 text-red-700 border-red-200',\r\n          info: 'bg-blue-50 text-blue-700 border-blue-200'\r\n        }\r\n        \r\n        const toast = document.createElement('div')\r\n        toast.className = `fixed top-4 right-4 py-2 px-4 rounded shadow-md border ${toastClasses[type]} transition-all`\r\n        toast.style.zIndex = '9999'\r\n        toast.textContent = message\r\n        \r\n        document.body.appendChild(toast)\r\n        \r\n        setTimeout(() => {\r\n          toast.style.opacity = '0'\r\n          setTimeout(() => document.body.removeChild(toast), 300)\r\n        }, 3000)\r\n      }\r\n    },\r\n    mounted() {\r\n      const token = localStorage.getItem('access')\r\n      const isStaff = localStorage.getItem('is_staff') === 'true'\r\n      if (!token || !isStaff) {\r\n        this.showNotification('Access denied. Staff only.', 'error')\r\n        this.$router.push('/login')\r\n        return\r\n      }\r\n      this.fetchProducts()\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .modal {\r\n    display: none;\r\n  }\r\n  \r\n  /* Custom styling to integrate with Tailwind and Bootstrap */\r\n  .btn-indigo {\r\n    color: white;\r\n    background-color: #4f46e5;\r\n    border-color: #4f46e5;\r\n  }\r\n  \r\n  .btn-indigo:hover, .btn-indigo:focus {\r\n    background-color: #4338ca;\r\n    border-color: #4338ca;\r\n    color: white;\r\n  }\r\n  \r\n  /* Line clamp for product descriptions */\r\n  .line-clamp-2 {\r\n    display: -webkit-box;\r\n    -webkit-line-clamp: 2;\r\n    -webkit-box-orient: vertical;\r\n    overflow: hidden;\r\n  }\r\n  \r\n  /* Smooth transitions */\r\n  .transition-colors {\r\n    transition: background-color 0.3s, border-color 0.3s, color 0.3s;\r\n  }\r\n  \r\n  .transition-shadow {\r\n    transition: box-shadow 0.3s;\r\n  }\r\n  \r\n  /* Responsive adjustments */\r\n  @media (max-width: 768px) {\r\n    .container {\r\n      padding-left: 1rem;\r\n      padding-right: 1rem;\r\n    }\r\n  }\r\n  </style>"],"mappings":";AAwME,OAAOA,KAAI,MAAO,UAAS;AAC3B,OAAO,KAAKC,SAAQ,MAAO,WAAU;AAErC,eA