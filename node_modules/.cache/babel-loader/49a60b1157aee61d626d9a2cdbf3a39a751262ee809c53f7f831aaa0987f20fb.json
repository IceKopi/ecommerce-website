{"ast":null,"code":"import axios from '../axios';\nexport default {\n  data() {\n    return {\n      orders: []\n    };\n  },\n  async mounted() {\n    const res = await axios.get('orders/');\n    this.orders = res.data;\n  }\n};","map":{"version":3,"names":["axios","data","orders","mounted","res","get"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\views\\OrderHistory.vue"],"sourcesContent":["\r\n<template>\r\n    <div class=\"container mt-3\">\r\n      <h2>My Orders</h2>\r\n      <div v-if=\"orders.length === 0\">No orders found.</div>\r\n      <div v-for=\"order in orders\" :key=\"order.id\" class=\"card mb-2\">\r\n        <div class=\"card-body\">\r\n          <h5>Order #{{ order.id }} — {{ order.date_ordered }}</h5>\r\n          <ul>\r\n            <li v-for=\"item in order.items\" :key=\"item.id\">\r\n              {{ item.product }} — Qty: {{ item.quantity }}\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  \r\n  export default {\r\n    data() {\r\n      return { orders: [] }\r\n    },\r\n    async mounted() {\r\n      const res = await axios.get('orders/')\r\n      this.orders = res.data\r\n    }\r\n  }\r\n  </script>\r\n  \r\n"],"mappings":"AAmBE,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MAAEC,MAAM,EAAE;IAAG;EACtB,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAMC,GAAE,GAAI,MAAMJ,KAAK,CAACK,GAAG,CAAC,SAAS;IACrC,IAAI,CAACH,MAAK,GAAIE,GAAG,CAACH,IAAG;EACvB;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}