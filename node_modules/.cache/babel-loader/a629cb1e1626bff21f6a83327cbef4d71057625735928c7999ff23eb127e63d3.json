{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport axios from '../axios';\nexport default {\n  data() {\n    return {\n      cartItems: [],\n      isProcessing: false,\n      isLoading: true,\n      localCart: []\n    };\n  },\n  computed: {\n    cartTotal() {\n      return this.cartItems.reduce((total, item) => {\n        return total + parseFloat(item.price) * item.quantity;\n      }, 0);\n    }\n  },\n  async mounted() {\n    // Load local cart first for quick display\n    const stored = localStorage.getItem('cart');\n    this.localCart = stored ? JSON.parse(stored) : [];\n\n    // Then fetch the actual cart from backend\n    await this.fetchCart();\n  },\n  methods: {\n    async fetchCart() {\n      this.isLoading = true;\n      try {\n        // Get current cart from backend\n        const response = await axios.get('cart/current/');\n        if (response.data && response.data.items) {\n          this.cartItems = response.data.items;\n\n          // Sync with local storage\n          localStorage.setItem('cart', JSON.stringify(this.cartItems));\n        } else {\n          this.cartItems = [];\n        }\n      } catch (err) {\n        console.error('Error fetching cart:', err);\n        // Fall back to local storage if backend fails\n        this.cartItems = this.localCart;\n      } finally {\n        this.isLoading = false;\n      }\n    },\n    async removeItem() {\n      // Would need a backend endpoint for this\n      // For now we'll just show how it would work\n      alert('Remove functionality would require an additional API endpoint');\n    },\n    async clearCart() {\n      // Would need a backend endpoint for this\n      if (confirm('Are you sure you want to clear your cart?')) {\n        localStorage.removeItem('cart');\n        this.cartItems = [];\n        // In a real implementation, you'd also clear the cart on the backend\n      }\n    },\n    async checkout() {\n      this.isProcessing = true;\n      try {\n        // Send each item from local storage to backend\n        const stored = localStorage.getItem('cart');\n        const localItems = stored ? JSON.parse(stored) : [];\n\n        // Only add items that don't exist in backend yet\n        for (const item of localItems) {\n          const exists = this.cartItems.some(backendItem => backendItem.product === item.id);\n          if (!exists) {\n            await axios.post('order-items/', {\n              product: item.id,\n              quantity: item.quantity\n            });\n          }\n        }\n\n        // Complete the order\n        await axios.put('orders/complete/');\n\n        // Clear local storage\n        localStorage.removeItem('cart');\n\n        // Show success message\n        alert('✅ Order placed successfully!');\n\n        // Refresh cart from backend (should be empty now)\n        await this.fetchCart();\n      } catch (err) {\n        console.error('Checkout error:', err);\n        if (err.response && err.response.data) {\n          alert(`❌ ${err.response.data.detail || 'Failed to complete checkout. Please try again.'}`);\n        } else {\n          alert('❌ Failed to complete checkout. Please try again.');\n        }\n      } finally {\n        this.isProcessing = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","cartItems","isProcessing","isLoading","localCart","computed","cartTotal","reduce","total","item","parseFloat","price","quantity","mounted","stored","localStorage","getItem","JSON","parse","fetchCart","methods","response","get","items","setItem","stringify","err","console","error","removeItem","alert","clearCart","confirm","checkout","localItems","exists","some","backendItem","product","id","post","put","detail"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-3\">\r\n    <h2>My Cart</h2>\r\n    <div v-if=\"isLoading\" class=\"text-center\">\r\n      <div class=\"spinner-border text-primary\" role=\"status\">\r\n        <span class=\"visually-hidden\">Loading...</span>\r\n      </div>\r\n    </div>\r\n    <div v-else-if=\"!cartItems || cartItems.length === 0\">Cart is empty.</div>\r\n    <ul class=\"list-group mb-3\" v-else>\r\n      <li v-for=\"item in cartItems\" :key=\"item.id\" class=\"list-group-item d-flex justify-content-between align-items-center\">\r\n        <div>\r\n          <strong>{{ item.product_name }}</strong> x {{ item.quantity }}\r\n          <span class=\"badge bg-secondary ms-2\">₱{{ (item.price * item.quantity).toFixed(2) }}</span>\r\n        </div>\r\n        <button @click=\"removeItem(item)\" class=\"btn btn-sm btn-outline-danger\">\r\n          <i class=\"bi bi-trash\"></i>\r\n        </button>\r\n      </li>\r\n      <li class=\"list-group-item d-flex justify-content-between\">\r\n        <strong>Total:</strong>\r\n        <strong>₱{{ cartTotal.toFixed(2) }}</strong>\r\n      </li>\r\n    </ul>\r\n    <div class=\"d-flex justify-content-between\">\r\n      <button @click=\"checkout\" class=\"btn btn-success\" :disabled=\"!cartItems || cartItems.length === 0 || isProcessing\">\r\n        {{ isProcessing ? 'Processing...' : 'Checkout' }}\r\n      </button>\r\n      <button @click=\"clearCart\" class=\"btn btn-outline-secondary\" :disabled=\"!cartItems || cartItems.length === 0 || isProcessing\">\r\n        Clear Cart\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      cartItems: [],\r\n      isProcessing: false,\r\n      isLoading: true,\r\n      localCart: []\r\n    }\r\n  },\r\n  computed: {\r\n    cartTotal() {\r\n      return this.cartItems.reduce((total, item) => {\r\n        return total + (parseFloat(item.price) * item.quantity)\r\n      }, 0)\r\n    }\r\n  },\r\n  async mounted() {\r\n    // Load local cart first for quick display\r\n    const stored = localStorage.getItem('cart')\r\n    this.localCart = stored ? JSON.parse(stored) : []\r\n    \r\n    // Then fetch the actual cart from backend\r\n    await this.fetchCart()\r\n  },\r\n  methods: {\r\n    async fetchCart() {\r\n      this.isLoading = true\r\n      try {\r\n        // Get current cart from backend\r\n        const response = await axios.get('cart/current/')\r\n        \r\n        if (response.data && response.data.items) {\r\n          this.cartItems = response.data.items\r\n          \r\n          // Sync with local storage\r\n          localStorage.setItem('cart', JSON.stringify(this.cartItems))\r\n        } else {\r\n          this.cartItems = []\r\n        }\r\n      } catch (err) {\r\n        console.error('Error fetching cart:', err)\r\n        // Fall back to local storage if backend fails\r\n        this.cartItems = this.localCart\r\n      } finally {\r\n        this.isLoading = false\r\n      }\r\n    },\r\n    \r\n    async removeItem() {\r\n      // Would need a backend endpoint for this\r\n      // For now we'll just show how it would work\r\n      alert('Remove functionality would require an additional API endpoint')\r\n    },\r\n    \r\n    async clearCart() {\r\n      // Would need a backend endpoint for this\r\n      if (confirm('Are you sure you want to clear your cart?')) {\r\n        localStorage.removeItem('cart')\r\n        this.cartItems = []\r\n        // In a real implementation, you'd also clear the cart on the backend\r\n      }\r\n    },\r\n    \r\n    async checkout() {\r\n      this.isProcessing = true\r\n      try {\r\n        // Send each item from local storage to backend\r\n        const stored = localStorage.getItem('cart')\r\n        const localItems = stored ? JSON.parse(stored) : []\r\n        \r\n        // Only add items that don't exist in backend yet\r\n        for (const item of localItems) {\r\n          const exists = this.cartItems.some(\r\n            backendItem => backendItem.product === item.id\r\n          )\r\n          \r\n          if (!exists) {\r\n            await axios.post('order-items/', {\r\n              product: item.id,\r\n              quantity: item.quantity\r\n            })\r\n          }\r\n        }\r\n\r\n        // Complete the order\r\n        await axios.put('orders/complete/')\r\n\r\n        // Clear local storage\r\n        localStorage.removeItem('cart')\r\n        \r\n        // Show success message\r\n        alert('✅ Order placed successfully!')\r\n        \r\n        // Refresh cart from backend (should be empty now)\r\n        await this.fetchCart()\r\n      } catch (err) {\r\n        console.error('Checkout error:', err)\r\n        if (err.response && err.response.data) {\r\n          alert(`❌ ${err.response.data.detail || 'Failed to complete checkout. Please try again.'}`)\r\n        } else {\r\n          alert('❌ Failed to complete checkout. Please try again.')\r\n        }\r\n      } finally {\r\n        this.isProcessing = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":";;;AAoCA,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,YAAY,EAAE,KAAK;MACnBC,SAAS,EAAE,IAAI;MACfC,SAAS,EAAE;IACb;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,SAASA,CAAA,EAAG;MACV,OAAO,IAAI,CAACL,SAAS,CAACM,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAK;QAC5C,OAAOD,KAAI,GAAKE,UAAU,CAACD,IAAI,CAACE,KAAK,IAAIF,IAAI,CAACG,QAAQ;MACxD,CAAC,EAAE,CAAC;IACN;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd;IACA,MAAMC,MAAK,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;IAC1C,IAAI,CAACZ,SAAQ,GAAIU,MAAK,GAAIG,IAAI,CAACC,KAAK,CAACJ,MAAM,IAAI,EAAC;;IAEhD;IACA,MAAM,IAAI,CAACK,SAAS,CAAC;EACvB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,SAASA,CAAA,EAAG;MAChB,IAAI,CAAChB,SAAQ,GAAI,IAAG;MACpB,IAAI;QACF;QACA,MAAMkB,QAAO,GAAI,MAAMtB,KAAK,CAACuB,GAAG,CAAC,eAAe;QAEhD,IAAID,QAAQ,CAACrB,IAAG,IAAKqB,QAAQ,CAACrB,IAAI,CAACuB,KAAK,EAAE;UACxC,IAAI,CAACtB,SAAQ,GAAIoB,QAAQ,CAACrB,IAAI