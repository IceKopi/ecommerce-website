{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from '../axios';\nexport default {\n  data() {\n    return {\n      product: {\n        name: '',\n        description: '',\n        price: 0,\n        stock: 0\n      },\n      image: null\n    };\n  },\n  methods: {\n    handleImage(e) {\n      this.image = e.target.files[0];\n    },\n    async submitProduct() {\n      const formData = new FormData();\n      for (let key in this.product) {\n        formData.append(key, this.product[key]);\n      }\n      if (this.image) formData.append('image', this.image);\n      try {\n        await axios.post('products/', formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        alert('✅ Product added successfully.');\n        this.$router.push('/monitor-products');\n      } catch (err) {\n        alert('❌ Failed to add product.');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","product","name","description","price","stock","image","methods","handleImage","e","target","files","submitProduct","formData","FormData","key","append","post","headers","alert","$router","push","err"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\AddProduct.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-4\">\r\n      <h3>➕ Add New Product</h3>\r\n      <form @submit.prevent=\"submitProduct\" enctype=\"multipart/form-data\">\r\n        <input v-model=\"product.name\" class=\"form-control mb-2\" placeholder=\"Name\" required />\r\n        <input v-model=\"product.description\" class=\"form-control mb-2\" placeholder=\"Description\" required />\r\n        <input type=\"number\" v-model.number=\"product.price\" class=\"form-control mb-2\" placeholder=\"Price\" required />\r\n        <input type=\"number\" v-model.number=\"product.stock\" class=\"form-control mb-2\" placeholder=\"Stock\" required />\r\n        <input type=\"file\" @change=\"handleImage\" class=\"form-control mb-3\" accept=\"image/*\" />\r\n        <button class=\"btn btn-success\">Add Product</button>\r\n      </form>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        product: { name: '', description: '', price: 0, stock: 0 },\r\n        image: null\r\n      }\r\n    },\r\n    methods: {\r\n      handleImage(e) {\r\n        this.image = e.target.files[0]\r\n      },\r\n      async submitProduct() {\r\n        const formData = new FormData()\r\n        for (let key in this.product) {\r\n          formData.append(key, this.product[key])\r\n        }\r\n        if (this.image) formData.append('image', this.image)\r\n  \r\n        try {\r\n          await axios.post('products/', formData, {\r\n            headers: { 'Content-Type': 'multipart/form-data' }\r\n          })\r\n          alert('✅ Product added successfully.')\r\n          this.$router.push('/monitor-products')\r\n        } catch (err) {\r\n          alert('❌ Failed to add product.')\r\n        }\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  "],"mappings":";AAeE,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;QAAEC,IAAI,EAAE,EAAE;QAAEC,WAAW,EAAE,EAAE;QAAEC,KAAK,EAAE,CAAC;QAAEC,KAAK,EAAE;MAAE,CAAC;MAC1DC,KAAK,EAAE;IACT;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAACC,CAAC,EAAE;MACb,IAAI,CAACH,KAAI,GAAIG,CAAC,CAACC,MAAM,CAACC,KAAK,CAAC,CAAC;IAC/B,CAAC;IACD,MAAMC,aAAaA,CAAA,EAAG;MACpB,MAAMC,QAAO,GAAI,IAAIC,QAAQ,CAAC;MAC9B,KAAK,IAAIC,GAAE,IAAK,IAAI,CAACd,OAAO,EAAE;QAC5BY,QAAQ,CAACG,MAAM,CAACD,GAAG,EAAE,IAAI,CAACd,OAAO,CAACc,GAAG,CAAC;MACxC;MACA,IAAI,IAAI,CAACT,KAAK,EAAEO,QAAQ,CAACG,MAAM,CAAC,OAAO,EAAE,IAAI,CAACV,KAAK;MAEnD,IAAI;QACF,MAAMP,KAAK,CAACkB,IAAI,CAAC,WAAW,EAAEJ,QAAQ,EAAE;UACtCK,OAAO,EAAE;YAAE,cAAc,EAAE;UAAsB;QACnD,CAAC;QACDC,KAAK,CAAC,+BAA+B;QACrC,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,mBAAmB;MACvC,EAAE,OAAOC,GAAG,EAAE;QACZH,KAAK,CAAC