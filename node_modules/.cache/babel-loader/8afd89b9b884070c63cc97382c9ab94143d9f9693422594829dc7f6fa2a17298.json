de(\"i\", {\n      class: \"far fa-eye me-2\"\n    }, null, -1 /* HOISTED */), _createTextVNode(\" View Details \")]))], 8 /* PROPS */, _hoisted_24)])])])]);\n  }), 128 /* KEYED_FRAGMENT */))]), _createCommentVNode(\" Mobile Floating Action Button \"), _createElementVNode(\"div\", _hoisted_25, [_createElementVNode(\"button\", {\n    class: \"btn btn-brown-dark rounded-pill shadow-lg py-3 w-100 d-flex justify-content-center align-items-center\",\n    onClick: _cache[2] || (_cache[2] = (...args) => $options.scrollToTop && $options.scrollToTop(...args))\n  }, _cache[12] || (_cache[12] = [_createElementVNode(\"i\", {\n    class: \"fas fa-arrow-up me-2\"\n  }, null, -1 /* HOISTED */), _createTextVNode(\" Back to Top \")]))])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_hoisted_3","_hoisted_4","_hoisted_5","_hoisted_6","_cache","$event","$data","searchQuery","type","placeholder","$options","filteredProducts","length","_hoisted_7","onClick","_hoisted_8","_Fragment","_renderList","product","id","_hoisted_9","_hoisted_10","_hoisted_11","image","src","alt","name","loading","_hoisted_12","_hoisted_13","stock","_hoisted_14","_hoisted_15","_toDisplayString","_hoisted_16","_hoisted_17","_hoisted_18","_createStaticVNode","_hoisted_19","description","_hoisted_20","_hoisted_21","_hoisted_22","price","toLocaleString","_normalizeClass","hasReachedLimit","addToCart","disabled","_createTextVNode","buttonText","_hoisted_23","showProductDetails","_hoisted_24","_hoisted_25","args","scrollToTop"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ProductList.vue"],"sourcesContent":["<template>\r\n  <div class=\"container py-4 py-md-5 main-container\">\r\n    <!-- Header Section -->\r\n    <div class=\"row mb-4 mb-md-5\">\r\n      <div class=\"col-12\">\r\n        <div class=\"d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center w-100 gap-3\">\r\n          <div>\r\n            <h2 class=\"font-weight-bold text-brown mb-0\">Maisanova Collection</h2>\r\n            <p class=\"text-brown-light mb-0 mt-1\">Handcrafted luxury for discerning tastes</p>\r\n          </div>\r\n\r\n          <div class=\"w-100 w-md-auto\">\r\n            <div class=\"search-container position-relative\">\r\n              <input\r\n                v-model=\"searchQuery\"\r\n                type=\"text\"\r\n                class=\"form-control search-input ps-4 pe-5 rounded-pill border-0 shadow-sm\"\r\n                placeholder=\"Search our collection...\"\r\n                aria-label=\"Search products\"\r\n              />\r\n              <span class=\"position-absolute search-icon\">\r\n                <i class=\"fas fa-search text-brown-light\"></i>\r\n              </span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Empty State -->\r\n    <div v-if=\"filteredProducts.length === 0\" class=\"text-center py-5 my-5\">\r\n      <div class=\"empty-state-icon mb-3\">\r\n        <i class=\"fas fa-search fa-2x text-brown-light\"></i>\r\n      </div>\r\n      <h4 class=\"text-brown mb-2\">No products found</h4>\r\n      <p class=\"text-brown-light mb-4\">Try adjusting your search or browse our full collection</p>\r\n      <button class=\"btn btn-outline-brown\" @click=\"searchQuery = ''\">\r\n        Clear Search\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Product Grid -->\r\n    <div class=\"row g-4\">\r\n      <div v-for=\"product in filteredProducts\" :key=\"product.id\" class=\"col-12 col-sm-6 col-md-4\">\r\n        <div class=\"card product-card h-100 border-0 shadow-sm overflow-hidden\">\r\n          <div class=\"product-image-container position-relative\">\r\n            <div class=\"aspect-ratio-box\">\r\n              <img\r\n                v-if=\"product.image\"\r\n                :src=\"product.image\"\r\n                class=\"card-img-top product-image\"\r\n                :alt=\"product.name\"\r\n                loading=\"lazy\"\r\n              />\r\n              <div v-else class=\"no-image-placeholder d-flex align-items-center justify-content-center\">\r\n                <i class=\"fas fa-image fa-3x text-brown-light opacity-50\"></i>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-if=\"product.stock === 0\" class=\"out-of-stock-badge\">\r\n              Out of Stock\r\n            </div>\r\n            <div v-else-if=\"product.stock < 5\" class=\"low-stock-badge\">\r\n              Only {{ product.stock }} left\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"card-body d-flex flex-column p-4 bg-beige\">\r\n            <div class=\"mb-2\">\r\n              <h5 class=\"card-title font-weight-bold text-brown-dark mb-1\">{{ product.name }}</h5>\r\n              <div class=\"d-flex align-items-center mb-2\">\r\n                <div class=\"rating-stars me-2\">\r\n                  <i class=\"fas fa-star text-warning\"></i>\r\n                  <i class=\"fas fa-star text-warning\"></i>\r\n                  <i class=\"fas fa-star text-warning\"></i>\r\n                  <i class=\"fas fa-star text-warning\"></i>\r\n                  <i class=\"fas fa-star-half-alt text-warning\"></i>\r\n                </div>\r\n                <small class=\"text-brown-light\">(24)</small>\r\n              </div>\r\n            </div>\r\n            \r\n            <p class=\"card-text text-brown-medium product-description mb-3\">{{ product.description }}</p>\r\n            \r\n            <div class=\"mt-auto\">\r\n              <div class=\"d-flex justify-content-between align-items-center mb-3\">\r\n                <span class=\"product-price text-brown-dark\">₱{{ product.price.toLocaleString() }}</span>\r\n                <span class=\"stock-indicator small\" :class=\"{'text-accent': product.stock < 5 && product.stock > 0}\">\r\n                  {{ product.stock > 0 ? `${product.stock} in stock` : '' }}\r\n                </span>\r\n              </div>\r\n              \r\n              <button\r\n                class=\"btn btn-add-to-cart w-100 text-white border-0 shadow-sm\"\r\n                @click=\"addToCart(product)\"\r\n                :disabled=\"product.stock === 0 || hasReachedLimit(product)\"\r\n                :class=\"{\r\n                  'btn-brown-dark': !(product.stock === 0 || hasReachedLimit(product)),\r\n                  'btn-brown-light': product.stock === 0 || hasReachedLimit(product)\r\n                }\"\r\n                aria-label=\"Add to cart\"\r\n              >\r\n                <i class=\"fas fa-shopping-cart me-2\"></i>\r\n                {{ buttonText(product) }}\r\n              </button>\r\n              \r\n              <button class=\"btn btn-outline-brown w-100 mt-2\" @click=\"showProductDetails(product)\">\r\n                <i class=\"far fa-eye me-2\"></i> View Details\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <!-- Mobile Floating Action Button -->\r\n    <div class=\"d-block d-md-none fixed-bottom mb-3 mx-3\">\r\n      <button \r\n        class=\"btn btn-brown-dark rounded-pill shadow-lg py-3 w-100 d-flex justify-content-center align-items-center\"\r\n        @click=\"scrollToTop\"\r\n      >\r\n        <i class=\"fas fa-arrow-up me-2\"></i> Back to Top\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { toast } from 'vue3-toastify'\r\nimport 'vue3-toastify/dist/index.css'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      searchQuery: '',\r\n      cart: [],\r\n      products: [\r\n        {\r\n          id: 1,\r\n          name: 'Handwoven Rattan Basket',\r\n          description: 'Eco-friendly, sustainably harvested rattan basket with leather handles. Perfect for home organization or as a stylish market tote.',\r\n          price: 2499,\r\n          stock: 5,\r\n          image: 'https://images.unsplash.com/photo-1584917865442-de89df76afd3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80'\r\n        },\r\n        {\r\n          id: 2,\r\n          name: 'Artisan Wooden Spoon Set',\r\n          description: 'Set of 5 hand-carved olive wood spoons. Each piece is unique, finished with food-grade mineral oil for lasting beauty.',\r\n          price: 1899,\r\n          stock: 2,\r\n          image: 'https://images.unsplash.com/photo-1583947581924-a6d4a274a35c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80'\r\n        },\r\n        {\r\n          id: 3,\r\n          name: 'Organic Cotton Canvas Tote',\r\n          description: 'Premium heavyweight canvas tote with reinforced stitching and vegetable-tanned leather handles. Made from 100% organic cotton.',\r\n          price: 1799,\r\n          stock: 0,\r\n          image: 'https://images.unsplash.com/photo-1566150902887-9679ecc155ba?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80'\r\n        },\r\n        {\r\n          id: 4,\r\n          name: 'Handblown Glass Vase',\r\n          description: 'Unique handblown glass vase with organic imperfections that highlight its artisanal craftsmanship. Each piece is one-of-a-kind.',\r\n          price: 3499,\r\n          stock: 3,\r\n          image: 'https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80'\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    filteredProducts() {\r\n      const q = this.searchQuery.toLowerCase()\r\n      return this.products.filter(p => {\r\n        return (\r\n          p.name.toLowerCase().includes(q) ||\r\n          p.description.toLowerCase().includes(q)\r\n        )\r\n      })\r\n    }\r\n  },\r\n  methods: {\r\n    buttonText(product) {\r\n      if (product.stock === 0) return 'Out of Stock'\r\n      if (this.hasReachedLimit(product)) return 'Max Quantity Reached'\r\n      return 'Add to Cart'\r\n    },\r\n    loadCart() {\r\n      try {\r\n        const stored = localStorage.getItem('cart')\r\n        this.cart = stored ? JSON.parse(stored) : []\r\n      } catch (err) {\r\n        console.error('Error loading cart:', err)\r\n        this.cart = []\r\n      }\r\n    },\r\n    saveCart() {\r\n      localStorage.setItem('cart', JSON.stringify(this.cart))\r\n    },\r\n    addToCart(product) {\r\n      const existing = this.cart.find(item => item.product === product.id)\r\n\r\n      if (existing) {\r\n        if (existing.quantity < product.stock) {\r\n          existing.quantity++\r\n          product.stock--\r\n          toast.success(`${product.name} quantity updated in your cart`, {\r\n            position: 'bottom-right',\r\n            transition: 'zoom',\r\n            timeout: 2000\r\n          })\r\n        } else {\r\n          toast.warning(`You've reached the maximum available quantity for ${product.name}.`, {\r\n            position: 'bottom-right',\r\n            transition: 'zoom',\r\n            timeout: 2500\r\n          })\r\n          return\r\n        }\r\n      } else {\r\n        if (product.stock === 0) {\r\n          toast.error(`${product.name} is currently out of stock.`, {\r\n            position: 'bottom-right',\r\n            transition: 'zoom',\r\n            timeout: 2500\r\n          })\r\n          return\r\n        }\r\n\r\n        this.cart.push({\r\n          id: product.id,\r\n          product: product.id,\r\n          product_name: product.name,\r\n          price: product.price,\r\n          quantity: 1\r\n        })\r\n        product.stock--\r\n        toast.success(`${product.name} added to your cart`, {\r\n          position: 'bottom-right',\r\n          transition: 'zoom',\r\n          timeout: 2000\r\n        })\r\n      }\r\n\r\n      this.saveCart()\r\n    },\r\n    hasReachedLimit(product) {\r\n      const item = this.cart.find(c => c.product === product.id)\r\n      return item ? item.quantity >= product.stock : false\r\n    },\r\n    showProductDetails(product) {\r\n      toast.info(`Viewing details for ${product.name}`, {\r\n        position: 'bottom-right',\r\n        transition: 'zoom',\r\n        timeout: 1500\r\n      })\r\n    },\r\n    scrollToTop() {\r\n      window.scrollTo({\r\n        top: 0,\r\n        behavior: 'smooth'\r\n      })\r\n    }\r\n  },\r\n  created() {\r\n    this.loadCart()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Enhanced Color Palette */\r\n:root {\r\n  --brown-dark: #3E2723;\r\n  --brown-medium: #5D4037;\r\n  --brown-light: #8D6E63;\r\n  --beige: #F5F5F0;\r\n  --cream: #FFFDF5;\r\n  --accent: #A1887F;\r\n  --neutral-dark: #3E2723;\r\n  --neutral-light: #D7CCC8;\r\n  --highlight: #BCAAA4;\r\n}\r\n\r\n.main-container {\r\n  background-color: var(--cream);\r\n  max-width: 1800px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.search-container {\r\n  width: 100%;\r\n}\r\n\r\n.search-input {\r\n  background-color: var(--beige);\r\n  transition: all 0.3s ease;\r\n  border: 1px solid var(--neutral-light) !important;\r\n  padding: 0.75rem 1.5rem;\r\n  font-size: 0.95rem;\r\n}\r\n\r\n.search-input:focus {\r\n  background-color: white;\r\n  box-shadow: 0 0 0 3px rgba(158, 119, 105, 0.15) !important;\r\n  border-color: var(--brown-light) !important;\r\n}\r\n\r\n.search-icon {\r\n  top: 50%;\r\n  right: 1.25rem;\r\n  transform: translateY(-50%);\r\n  pointer-events: none;\r\n}\r\n\r\n.product-card {\r\n  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  background: white;\r\n}\r\n\r\n.product-card:hover {\r\n  transform: translateY(-8px);\r\n  box-shadow: 0 15px 30px rgba(62, 39, 35, 0.12) !important;\r\n}\r\n\r\n.aspect-ratio-box {\r\n  position: relative;\r