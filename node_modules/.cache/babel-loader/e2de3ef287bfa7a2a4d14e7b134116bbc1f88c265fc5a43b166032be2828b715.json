{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport axios from '../axios';\nexport default {\n  data() {\n    return {\n      products: [],\n      quantities: {},\n      loading: true,\n      addingToCart: {}\n    };\n  },\n  async mounted() {\n    await this.fetchProducts();\n  },\n  methods: {\n    async fetchProducts() {\n      try {\n        this.loading = true;\n        const response = await axios.get('products/');\n        this.products = response.data;\n\n        // Initialize quantities\n        this.products.forEach(product => {\n          this.quantities[product.id] = 1;\n          this.addingToCart[product.id] = false;\n        });\n      } catch (error) {\n        console.error('Error fetching products:', error);\n        alert('Failed to load products. Please refresh the page.');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async addToCart(product) {\n      const quantity = parseInt(this.quantities[product.id]);\n      if (!quantity || quantity <= 0 || quantity > product.stock) return;\n      try {\n        this.addingToCart[product.id] = true;\n\n        // Use the order-items/create/ endpoint to add item to cart\n        await axios.post('order-items/create/', {\n          product: product.id,\n          quantity: quantity\n        });\n\n        // Reset quantity input\n        this.quantities[product.id] = 1;\n\n        // Update product stock in the UI\n        const productIndex = this.products.findIndex(p => p.id === product.id);\n        if (productIndex !== -1) {\n          this.products[productIndex].stock -= quantity;\n        }\n\n        // Show success message\n        this.$toast?.success(`Added ${product.name} to cart`) || alert(`Added ${product.name} to cart`);\n      } catch (error) {\n        console.error('Error adding to cart:', error);\n        alert(error.response?.data?.detail || 'Failed to add item to cart.');\n      } finally {\n        this.addingToCart[product.id] = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","products","quantities","loading","addingToCart","mounted","fetchProducts","methods","response","get","forEach","product","id","error","console","alert","addToCart","quantity","parseInt","stock","post","productIndex","findIndex","p","$toast","success","name","detail"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-3\">\r\n      <h2>Products</h2>\r\n      <div v-if=\"loading\" class=\"text-center my-4\">\r\n        <div class=\"spinner-border\" role=\"status\">\r\n          <span class=\"visually-hidden\">Loading...</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"row row-cols-1 row-cols-md-3 g-4\" v-else>\r\n        <div class=\"col\" v-for=\"product in products\" :key=\"product.id\">\r\n          <div class=\"card h-100\">\r\n            <img v-if=\"product.image\" :src=\"product.image\" class=\"card-img-top\" alt=\"Product image\">\r\n            <div class=\"card-body\">\r\n              <h5 class=\"card-title\">{{ product.name }}</h5>\r\n              <p class=\"card-text\">{{ product.description }}</p>\r\n              <div class=\"d-flex justify-content-between align-items-center\">\r\n                <span class=\"price\">₱{{ product.price }}</span>\r\n                <span class=\"stock\" :class=\"{ 'text-danger': product.stock < 5 }\">\r\n                  Stock: {{ product.stock }}\r\n                </span>\r\n              </div>\r\n            </div>\r\n            <div class=\"card-footer d-flex\">\r\n              <input \r\n                type=\"number\" \r\n                class=\"form-control me-2\" \r\n                v-model=\"quantities[product.id]\" \r\n                min=\"1\" \r\n                :max=\"product.stock\"\r\n                placeholder=\"Qty\"\r\n              >\r\n              <button \r\n                class=\"btn btn-primary\" \r\n                @click=\"addToCart(product)\" \r\n                :disabled=\"!quantities[product.id] || quantities[product.id] > product.stock || addingToCart[product.id]\"\r\n              >\r\n                <span v-if=\"addingToCart[product.id]\" class=\"spinner-border spinner-border-sm\" role=\"status\"></span>\r\n                <span v-else>Add</span>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        products: [],\r\n        quantities: {},\r\n        loading: true,\r\n        addingToCart: {}\r\n      }\r\n    },\r\n    \r\n    async mounted() {\r\n      await this.fetchProducts()\r\n    },\r\n    \r\n    methods: {\r\n      async fetchProducts() {\r\n        try {\r\n          this.loading = true\r\n          const response = await axios.get('products/')\r\n          this.products = response.data\r\n          \r\n          // Initialize quantities\r\n          this.products.forEach(product => {\r\n            this.quantities[product.id] = 1\r\n            this.addingToCart[product.id] = false\r\n          })\r\n        } catch (error) {\r\n          console.error('Error fetching products:', error)\r\n          alert('Failed to load products. Please refresh the page.')\r\n        } finally {\r\n          this.loading = false\r\n        }\r\n      },\r\n      \r\n      async addToCart(product) {\r\n        const quantity = parseInt(this.quantities[product.id])\r\n        if (!quantity || quantity <= 0 || quantity > product.stock) return\r\n        \r\n        try {\r\n          this.addingToCart[product.id] = true\r\n          \r\n          // Use the order-items/create/ endpoint to add item to cart\r\n          await axios.post('order-items/create/', {\r\n            product: product.id,\r\n            quantity: quantity\r\n          })\r\n          \r\n          // Reset quantity input\r\n          this.quantities[product.id] = 1\r\n          \r\n          // Update product stock in the UI\r\n          const productIndex = this.products.findIndex(p => p.id === product.id)\r\n          if (productIndex !== -1) {\r\n            this.products[productIndex].stock -= quantity\r\n          }\r\n          \r\n          // Show success message\r\n          this.$toast?.success(`Added ${product.name} to cart`) || alert(`Added ${product.name} to cart`)\r\n        } catch (error) {\r\n          console.error('Error adding to cart:', error)\r\n          alert(error.response?.data?.detail || 'Failed to add item to cart.')\r\n        } finally {\r\n          this.addingToCart[product.id] = false\r\n        }\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .price {\r\n    font-size: 1.2rem;\r\n    font-weight: bold;\r\n  }\r\n  .stock {\r\n    font-size: 0.9rem;\r\n  }\r\n  </style>"],"mappings":";;AAgDE,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,UAAU,EAAE,CAAC,CAAC;MACdC,OAAO,EAAE,IAAI;MACbC,YAAY,EAAE,CAAC;IACjB;EACF,CAAC;EAED,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,aAAa,CAAC;EAC3B,CAAC;EAEDC,OAAO,EAAE;IACP,MAAMD,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,IAAI,CAACH,OAAM,GAAI,IAAG;QAClB,MAAMK,QAAO,GAAI,MAAMT,KAAK,CAACU,GAAG,CAAC,WAAW;QAC5C,IAAI,CAACR,QAAO,GAAIO,QAAQ,CAACR,IAAG;;QAE5B;QACA,IAAI,CAACC,QAAQ,CAACS,OAAO,CAACC,OAAM,IAAK;UAC/B,IAAI,CAACT,UAAU,CAACS,OAAO,CAACC,EAAE,IAAI;UAC9B,IAAI,CAACR,YAAY,CAACO,OAAO,CAACC,EAAE,IAAI,KAAI;QACtC,CAAC;MACH,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,0BAA0B,EAAEA,KAAK;QAC/CE,KAAK,CAAC,mDAAmD;MAC3D,UAAU;QACR,IAAI,CAACZ,OAAM,GAAI,KAAI;MACrB;IACF,CAAC;IAED,MAAMa,SAASA,CAACL,OAAO,EAAE;MACvB,MAAMM,QAAO,GAAIC,QAAQ,CAAC,IAAI,CAAChB,UAAU,CAACS,OAAO,CAACC,EAAE,CAAC;MACrD,IAAI,CAACK,QAAO,IAAKA,QAAO,IAAK,KAAKA,QAAO,GAAIN,OAAO,CAACQ,KAAK,EAAE;