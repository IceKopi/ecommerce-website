{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from '../axios';\nexport default {\n  data() {\n    return {\n      product: {\n        name: '',\n        description: '',\n        price: 0,\n        stock: 0\n      },\n      image: null,\n      imagePreview: null\n    };\n  },\n  methods: {\n    handleImage(e) {\n      this.image = e.target.files[0];\n      if (this.image) {\n        const reader = new FileReader();\n        reader.onload = e => {\n          this.imagePreview = e.target.result;\n        };\n        reader.readAsDataURL(this.image);\n      }\n    },\n    removeImage() {\n      this.image = null;\n      this.imagePreview = null;\n      document.getElementById('fileInput').value = '';\n    },\n    async submitProduct() {\n      const formData = new FormData();\n      for (let key in this.product) {\n        formData.append(key, this.product[key]);\n      }\n      if (this.image) formData.append('image', this.image);\n      try {\n        await axios.post('products/', formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        alert('✅ Product added successfully.');\n        this.$router.push('/monitor-products');\n      } catch (err) {\n        alert('❌ Failed to add product.');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","product","name","description","price","stock","image","imagePreview","methods","handleImage","e","target","files","reader","FileReader","onload","result","readAsDataURL","removeImage","document","getElementById","value","submitProduct","formData","FormData","key","append","post","headers","alert","$router","push","err"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\AddProduct.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-5\">\r\n    <div class=\"row justify-content-center\">\r\n      <div class=\"col-md-8\">\r\n        <div class=\"card elegant-card shadow-sm border-0\">\r\n          <div class=\"card-header py-3\">\r\n            <h3 class=\"elegant-heading text-white mb-0\">\r\n              <i class=\"bi bi-plus-circle me-2\"></i>Add New Product\r\n            </h3>\r\n          </div>\r\n          <div class=\"card-body p-4\">\r\n            <form @submit.prevent=\"submitProduct\" enctype=\"multipart/form-data\">\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label elegant-label\">\r\n                  <i class=\"bi bi-tag-fill me-2\"></i>Product Name\r\n                </label>\r\n                <input \r\n                  v-model=\"product.name\" \r\n                  class=\"form-control form-control-lg elegant-input\" \r\n                  placeholder=\"Enter product name\" \r\n                  required \r\n                />\r\n              </div>\r\n              \r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label elegant-label\">\r\n                  <i class=\"bi bi-card-text me-2\"></i>Description\r\n                </label>\r\n                <textarea \r\n                  v-model=\"product.description\" \r\n                  class=\"form-control elegant-input\" \r\n                  placeholder=\"Enter product description\" \r\n                  rows=\"3\" \r\n                  required\r\n                ></textarea>\r\n              </div>\r\n              \r\n              <div class=\"row mb-3\">\r\n                <div class=\"col-md-6\">\r\n                  <label class=\"form-label elegant-label\">\r\n                    <i class=\"bi bi-currency-dollar me-2\"></i>Price\r\n                  </label>\r\n                  <div class=\"input-group\">\r\n                    <span class=\"input-group-text text-white btn-elegant\">$</span>\r\n                    <input \r\n                      type=\"number\" \r\n                      v-model.number=\"product.price\" \r\n                      class=\"form-control elegant-input\" \r\n                      placeholder=\"0.00\" \r\n                      min=\"0\" \r\n                      step=\"0.01\" \r\n                      required \r\n                    />\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"col-md-6\">\r\n                  <label class=\"form-label elegant-label\">\r\n                    <i class=\"bi bi-box-seam me-2\"></i>Stock\r\n                  </label>\r\n                  <input \r\n                    type=\"number\" \r\n                    v-model.number=\"product.stock\" \r\n                    class=\"form-control elegant-input\" \r\n                    placeholder=\"Quantity available\" \r\n                    min=\"0\" \r\n                    required \r\n                  />\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"mb-4\">\r\n                <label class=\"form-label elegant-label\">\r\n                  <i class=\"bi bi-image me-2\"></i>Product Image\r\n                </label>\r\n                <div class=\"image-upload-container p-3 text-center\">\r\n                  <template v-if=\"imagePreview\">\r\n                    <div class=\"position-relative mb-3\">\r\n                      <img :src=\"imagePreview\" class=\"img-preview img-fluid rounded\" alt=\"Product preview\" />\r\n                      <button type=\"button\" @click=\"removeImage\" class=\"btn btn-sm btn-elegant-danger position-absolute top-0 end-0 rounded-circle\">\r\n                        <i class=\"bi bi-x\"></i>\r\n                      </button>\r\n                    </div>\r\n                  </template>\r\n                  <template v-else>\r\n                    <i class=\"bi bi-cloud-arrow-up display-4 mb-3\"></i>\r\n                    <p class=\"text-muted elegant-text\">Drag and drop your image here or click to browse</p>\r\n                  </template>\r\n                  <input \r\n                    type=\"file\" \r\n                    id=\"fileInput\" \r\n                    @change=\"handleImage\" \r\n                    class=\"form-control mt-2 elegant-input\" \r\n                    accept=\"image/*\" \r\n                  />\r\n                </div>\r\n              </div>\r\n              \r\n              <button type=\"submit\" class=\"btn btn-lg w-100 btn-elegant\">\r\n                <i class=\"bi bi-plus-circle me-2\"></i>Add Product\r\n              </button>\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      product: { name: '', description: '', price: 0, stock: 0 },\r\n      image: null,\r\n      imagePreview: null\r\n    }\r\n  },\r\n  methods: {\r\n    handleImage(e) {\r\n      this.image = e.target.files[0]\r\n      if (this.image) {\r\n        const reader = new FileReader()\r\n        reader.onload = (e) => {\r\n          this.imagePreview = e.target.result\r\n        }\r\n        reader.readAsDataURL(this.image)\r\n      }\r\n    },\r\n    removeImage() {\r\n      this.image = null\r\n      this.imagePreview = null\r\n      document.getElementById('fileInput').value = ''\r\n    },\r\n    async submitProduct() {\r\n      const formData = new FormData()\r\n      for (let key in this.product) {\r\n        formData.append(key, this.product[key])\r\n      }\r\n      if (this.image) formData.append('image', this.image)\r\n\r\n      try {\r\n        await axios.post('products/', formData, {\r\n          headers: { 'Content-Type': 'multipart/form-data' }\r\n        })\r\n        alert('✅ Product added successfully.')\r\n        this.$router.push('/monitor-products')\r\n      } catch (err) {\r\n        alert('❌ Failed to add product.')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Import elegant fonts */\r\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Lora:wght@400;500&family=Source+Sans+Pro:wght@400;600&display=swap');\r\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\");\r\n\r\n/* Refined Brown Color Palette */\r\n:root {\r\n  --deep-brown: #3E2723;\r\n  --primary-brown: #5D4037;\r\n  --medium-brown: #8D6E63;\r\n  --light-brown: #BCAAA4;\r\n  --pale-brown: #EFEBE9;\r\n  --off-white: #F5F5F5;\r\n  \r\n  /* Override existing variables */\r\n  --color-primary: var(--deep-brown);\r\n  --color-secondary: var(--primary-brown);\r\n  --color-accent: var(--medium-brown);\r\n  --color-accent-light: var(--light-brown);\r\n  --color-light: var(--pale-brown);\r\n  --color-white: var(--off-white);\r\n  --color-text: var(--deep-brown);\r\n  --color-text-light: var(--medium-brown);\r\n}\r\n\r\n/* Typography Overrides */\r\n.elegant-heading {\r\n  font-family: 'Playfair Display', serif;\r\n  font-weight: 500;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.elegant-logo {\r\n  font-family: 'Playfair Display', serif;\r\n  background-color: rgba(141, 110, 99, 0.1);\r\n}\r\n\r\n.elegant-subheading {\r\n  font-family: 'Playfair Display', serif;\r\n}\r\n\r\n.elegant-label {\r\n  font-family: 'Lora', serif;\r\n  color: var(--deep-brown);\r\n  font-weight: 500;\r\n}\r\n\r\n.elegant-text, .product-description {\r\n  font-family: 'Source Sans Pro', sans-serif;\r\n}\r\n\r\n/* Buttons Overrides */\r\n.btn-elegant {\r\n  background-color: var(--primary-brown);\r\n  color: white;\r\n  font-family: 'Lora', serif;\r\n  font-weight: 500;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.btn-elegant:hover, .btn-elegant:focus {\r\n  background-color: #6D4C41;\r\n  color: white;\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 4px 12px rgba(62, 39, 35, 0.15);\r\n}\r\n\r\n.btn-elegant-secondary {\r\n  border-color: var(--light-brown);\r\n  color: var(--deep-brown);\r\n  font-family: 'Source Sans Pro', sans-serif;\r\n}\r\n\r\n.btn-elegant-secondary:hover {\r\n  border-color: var(--medium-brown);\r\n  color: var(--primary-brown);\r\n  background-color: rgba(141, 110, 99, 0.05);\r\n}\r\n\r\n.btn-elegant-danger {\r\n  border-color: #c45440;\r\n  color: #c45440;\r\n  font-family: 'Source Sans Pro', sans-serif;\r\n}\r\n\r\n.btn-elegant-danger:hover {\r\n  background-color: #c45440;\r\n  color: white;\r\n}\r\n\r\n/* Cards & UI Elements */\r\n.elegant-card {\r\n  background-color: var(--off-white);\r\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08) !important;\r\n}\r\n\r\n.elegant-badge {\r\n  background-color: rgba(255, 255, 255, 0.9);\r\n  color: var(--primary-brown);\r\n}\r\n\r\n.elegant-modal {\r\n  background-color: var(--off-white);\r\n}\r\n\r\n.elegant-modal-title {\r\n  font-family: 'Playfair Display', serif;\r\n  color: var(--deep-brown);\r\n}\r\n\r\n.elegant-input {\r\n  border-color: var(--light-brown);\r\n  font-family: 'Source Sans Pro', sans-serif;\r\n  transition: border-color 0.3s ease;\r\n}\r\n\r\n.elegant-input:focus {\r\n  border-color: var(--medium-brown);\r\n  box-shadow: 0 0 0 0.25rem rgba(93, 64, 55, 0.2);\r\n}\r\n\r\n.elegant-input:hover:not(:focus) {\r\n  border-color: var(--medium-brown);\r\n}\r\n\r\n/* Product Cards */\r\n.product-image-container {\r\n  background-color: var(--pale-brown);\r\n}\r\n\r\n.product-image-placeholder i {\r\n  color: var(--medium-brown);\r\n}\r\n\r\n.product-title {\r\n  font-family: 'Playfair Display', serif;\r\n  color: var(--deep-brown);\r\n}\r\n\r\n.product-price {\r\n  font-family: 'Lora', serif;\r\n  color: var(--primary-brown);\r\n}\r\n\r\n/* Add Product Form Header */\r\n.card-header {\r\n  background: linear-gradient(to right, var(--primary-brown), var(--medium-brown));\r\n  padding: 1rem;\r\n}\r\n\r\n.card-body {\r\n  background-color: var(--off-white);\r\n}\r\n\r\n/* Image upload container */\r\n.image-upload-container {\r\n  border: 2px dashed var(--medium-brown) !important;\r\n  background-color: var(--pale-brown);\r\n  border-radius: 0.375rem;\r\n}\r\n\r\n.image-upload-container i {\r\n  color: var(--medium-brown);\r\n}\r\n\r\n.img-preview {\r\n  max-height: 200px;\r\n  object-fit: contain;\r\n}\r\n</style>"],"mappings":";AA8GA,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;QAAEC,IAAI,EAAE,EAAE;QAAEC,WAAW,EAAE,EAAE;QAAEC,KAAK,EAAE,CAAC;QAAEC,KAAK,EAAE;MAAE,CAAC;MAC1DC,KAAK,EAAE,IAAI;MACXC,YAAY,EAAE;IAChB;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAACC,CAAC,EAAE;MACb,IAAI,CAACJ,KAAI,GAAII,CAAC,CAACC,MAAM,CAACC,KAAK,CAAC,CAAC;MAC7B,IAAI,IAAI,CAACN,KAAK,EAAE;QACd,MAAMO,MAAK,GAAI,IAAIC,UAAU,CAAC;QAC9BD,MAAM,CAACE,MAAK,GAAKL,CAAC,IAAK;UACrB,IAAI,CAACH,YAAW,GAAIG,CAAC,CAACC,MAAM,CAACK,MAAK;QACpC;QACAH,MAAM,CAACI,aAAa,CAAC,IAAI,CAACX,KAAK;MACjC;IACF,CAAC;IACDY,WAAWA,CAAA,EAAG;MACZ,IAAI,CAACZ,KAAI,GAAI,IAAG;MAChB,IAAI,CAACC,YAAW,GAAI,IAAG;MACvBY,QAAQ,CAACC,cAAc,CAAC,WAAW,CAAC,CAACC,KAAI,GAAI,EAAC;IAChD,CAAC;IACD,MAAMC,aAAaA,CAAA,EAAG;MACpB,MAAMC,QAAO,GAAI,IAAIC,QAAQ,CAAC;MAC9B,KAAK,IAAIC,GAAE,IAAK,IAAI,CAACxB,OAAO,EAAE;QAC5BsB,QAAQ,CAACG,MAAM,CAACD,GAAG,EAAE,IAAI,CAACxB,OAAO,CAACwB,GAAG,CAAC;MACxC;MACA,IAAI,IAAI,CAACnB,KAAK,EAAEiB,QAAQ,CAACG,MAAM,CAAC,OAAO,EAAE,IAAI,CAACpB,KAAK;MAEnD,IAAI;QACF,MAAMP,KAAK,CAAC4B,IAAI,CAAC,WAAW,EAAEJ,QAAQ,EAAE;UACtCK,OAAO,EAAE;YAAE,cAAc,EAAE;UAAsB;QACnD,CAAC;QACDC,KAAK,CAAC,+BAA+B;QACrC,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,mBAAmB;MACvC,EAAE,OAAOC,GAAG,EAAE;QACZH,KAAK,CAAC,0BAA0B;MAClC;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}