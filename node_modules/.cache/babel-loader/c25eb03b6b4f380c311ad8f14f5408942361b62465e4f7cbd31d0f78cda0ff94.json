bled","_createTextVNode","buttonText","_hoisted_19"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ProductList.vue"],"sourcesContent":["<template>\r\n    <div class=\"container py-5\">\r\n      <!-- Header Section -->\r\n      <div class=\"row mb-5\">\r\n        <div class=\"col-12\">\r\n          <div class=\"d-flex justify-content-between align-items-center\">\r\n            <h2 class=\"font-weight-bold text-primary mb-0\">Curated Collection</h2>\r\n            <div class=\"search-container position-relative\">\r\n              <input\r\n                v-model=\"searchQuery\"\r\n                type=\"text\"\r\n                class=\"form-control search-input pl-4 pr-5 rounded-pill border-0 shadow-sm\"\r\n                placeholder=\"Search our collection...\"\r\n              />\r\n              <span class=\"position-absolute search-icon\">\r\n                <i class=\"fas fa-search text-muted\"></i>\r\n              </span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- Product Grid -->\r\n      <div v-if=\"filteredProducts.length === 0\" class=\"text-center py-5\">\r\n        <p class=\"text-muted\">No products match your search criteria.</p>\r\n      </div>\r\n      \r\n      <div class=\"row\">\r\n        <div v-for=\"product in filteredProducts\" :key=\"product.id\" class=\"col-md-4 mb-4\">\r\n          <div class=\"card product-card h-100 border-0 shadow-sm\">\r\n            <div class=\"product-image-container\">\r\n              <img\r\n                v-if=\"product.image\"\r\n                :src=\"fullImageUrl(product.image)\"\r\n                class=\"card-img-top product-image\"\r\n                alt=\"Product\"\r\n              />\r\n              <div v-else class=\"no-image-placeholder\">\r\n                <i class=\"fas fa-image text-muted\"></i>\r\n              </div>\r\n              <div v-if=\"product.stock === 0\" class=\"out-of-stock-badge\">\r\n                Out of Stock\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"card-body d-flex flex-column\">\r\n              <h5 class=\"card-title font-weight-bold\">{{ product.name }}</h5>\r\n              <p class=\"card-text text-muted product-description\">{{ product.description }}</p>\r\n              <div class=\"mt-auto\">\r\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\r\n                  <span class=\"product-price\">₱{{ product.price.toLocaleString() }}</span>\r\n                  <span class=\"stock-indicator\" :class=\"{'text-danger': product.stock < 5 && product.stock > 0}\">\r\n                    {{ product.stock > 0 ? `${product.stock} in stock` : '' }}\r\n                  </span>\r\n                </div>\r\n                <button\r\n                  class=\"btn btn-add-to-cart w-100\"\r\n                  @click=\"addToCart(product)\"\r\n                  :disabled=\"product.stock === 0 || hasReachedLimit(product)\"\r\n                  :class=\"{'btn-secondary': product.stock === 0 || hasReachedLimit(product)}\"\r\n                >\r\n                  <i class=\"fas fa-shopping-cart mr-2\"></i>\r\n                  {{ buttonText(product) }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        products: [],\r\n        cart: [], // ✅ Initialized as array\r\n        searchQuery: ''\r\n      }\r\n    },\r\n    computed: {\r\n      filteredProducts() {\r\n        if (!this.searchQuery) return this.products\r\n        const q = this.searchQuery.toLowerCase()\r\n        return this.products.filter(p =>\r\n          p.name.toLowerCase().includes(q) ||\r\n          p.description.toLowerCase().includes(q)\r\n        )\r\n      }\r\n    },\r\n    methods: {\r\n      buttonText(product) {\r\n        if (product.stock === 0) return 'Out of Stock'\r\n        if (this.hasReachedLimit(product)) return 'Max Quantity Reached'\r\n        return 'Add to Cart'\r\n      },\r\n      fullImageUrl(path) {\r\n        if (!path) return ''\r\n        return path.startsWith('http') ? path : `http://127.0.0.1:8000${path.startsWith('/') ? path : '/media/' + path}`\r\n      },\r\n      loadCart() {\r\n        try {\r\n          const stored = localStorage.getItem('cart')\r\n          this.cart = stored ? JSON.parse(stored) : []\r\n        } catch (err) {\r\n          console.error('Error loading cart:', err)\r\n          this.cart = []\r\n        }\r\n      },\r\n      saveCart() {\r\n        localStorage.setItem('cart', JSON.stringify(this.cart))\r\n      },\r\n      addToCart(product) {\r\n        if (!Array.isArray(this.cart)) {\r\n          this.cart = []\r\n        }\r\n  \r\n        const existing = this.cart.find(item => item.id === product.id)\r\n  \r\n        if (existing) {\r\n          if (existing.quantity < product.stock) {\r\n            existing.quantity += 1\r\n          } else {\r\n            alert(`You've reached the maximum available quantity for this item.`)\r\n            return\r\n          }\r\n        } else {\r\n          if (product.stock === 0) {\r\n            alert('This item is currently out of stock.')\r\n            return\r\n          }\r\n          this.cart.push({ ...product, quantity: 1 })\r\n        }\r\n  \r\n        this.saveCart()\r\n        alert(`${product.name} added to your cart.`)\r\n      },\r\n      hasReachedLimit(product) {\r\n        if (!Array.isArray(this.cart)) return false\r\n        const found = this.cart.find(item => item.id === product.id)\r\n        return found ? found.quantity >= product.stock : false\r\n      },\r\n      async fetchProducts() {\r\n        try {\r\n          const res = await axios.get('products/')\r\n          this.products = res.data\r\n        } catch (err) {\r\n          alert('Failed to fetch products. Please try again later.')\r\n          console.error(err)\r\n        }\r\n      }\r\n    },\r\n    mounted() {\r\n      this.loadCart()\r\n      this.fetchProducts()\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .search-container {\r\n    width: 300px;\r\n  }\r\n  \r\n  .search-input {\r\n    background-color: #f8f9fa;\r\n    transition: all 0.3s;\r\n  }\r\n  \r\n  .search-input:focus {\r\n    background-color: #fff;\r\n    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\r\n  }\r\n  \r\n  .search-icon {\r\n    top: 10px;\r\n    right: 15px;\r\n  }\r\n  \r\n  .product-card {\r\n    transition: transform 0.3s, box-shadow 0.3s;\r\n    overflow: hidden;\r\n  }\r\n  \r\n  .product-card:hover {\r\n    transform: translateY(-5px);\r\n    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;\r\n  }\r\n  \r\n  .product-image-container {\r\n    height: 220px;\r\n    overflow: hidden;\r\n    position: relative;\r\n    background-color: #f8f9fa;\r\n  }\r\n  \r\n  .product-image {\r\n    height: 100%;\r\n    width: 100%;\r\n    object-fit: cover;\r\n  }\r\n  \r\n  .no-image-placeholder {\r\n    height: 100%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n  }\r\n  \r\n  .no-image-placeholder i {\r\n    font-size: 3rem;\r\n  }\r\n  \r\n  .product-description {\r\n    font-size: 0.9rem;\r\n    overflow: hidden;\r\n    display: -webkit-box;\r\n    -webkit-line-clamp: 3;\r\n    -webkit-box-orient: vertical;\r\n    min-height: 60px;\r\n  }\r\n  \r\n  .product-price {\r\n    font-size: 1.25rem;\r\n    font-weight: bold;\r\n    color: #343a40;\r\n  }\r\n  \r\n  .stock-indicator {\r\n    font-size: 0.85rem;\r\n    color: #6c757d;\r\n  }\r\n  \r\n  .btn-add-to-cart {\r\n    background-color: #4a6fdc;\r\n    color: white;\r\n    border: none;\r\n    transition: all 0.3s;\r\n  }\r\n  \r\n  .btn-add-to-cart:hover:not(:disabled) {\r\n    background-color: #3955a7;\r\n  }\r\n  \r\n  .btn-secondary {\r\n    background-color: #6c757d;\r\n  }\r\n  \r\n  .out-of-stock-badge {\r\n    position: absolute;\r\n    top: 10px;\r\n    right: 10px;\r\n    background-color: rgba(220, 53, 69, 0.9);\r\n    color: white;\r\n    padding: 5px 10px;\r\n    border-radius: 4px;\r\n    font-size: 0.8rem;\r\n    font-weight: bold;\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAgB;;EAEpBA,KAAK,EAAC;AAAU;;EACdA,KAAK,EAAC;AAAQ;;EACZA,KAAK,EAAC;AAAmD;;EAEvDA,KAAK,EAAC;AAAoC;;EAP3DC,GAAA;EAuBgDD,KAAK,EAAC;;;EAI3CA,KAAK,EAAC;AAAK;;EAEPA,KAAK,EAAC;AAA4C;;EAChDA,KAAK,EAAC;AAAyB;oBA9BhD;;EAAAC,GAAA;EAqC0BD,KAAK,EAAC;;;EArChCC,GAAA;EAwC8CD,KAAK,EAAC;;;EAKnCA,KAAK,EAAC;AAA8B;;EACnCA,KAAK,EAAC;AAA6B;;EACpCA,KAAK,EAAC;AAA0C;;EAC9CA,KAAK,EAAC;AAAS;;EACbA,KAAK,EAAC;AAAwD;;EAC3DA,KAAK,EAAC;AAAe;oBAlD7C;;uBACIE,mBAAA,CAoEM,OApENC,UAoEM,GAnEJC,mBAAA,oBAAuB,EACvBC,mBAAA,CAiBM,OAjBNC,UAiBM,GAhBJD,mBAAA,CAeM,OAfNE,UAeM,GAdJF,mBAAA,CAaM,OAbNG,UAaM,G,0BAZJH,mBAAA,CAAsE;IAAlEL,KAAK,EAAC;EAAoC,GAAC,oBAAkB,sBACjEK,mBAAA,CAUM,OAVNI,UAUM,G,gBATJJ,mBAAA,CAKE;IAbhB,uBAAAK,MAAA,QAAAA,MAAA,MAAAC,MAAA,IASyBC,KAAA,CAAAC,WAAW,GAAAF,MAAA;IACpBG,IAAI,EAAC,MAAM;IACXd,KAAK,EAAC,qEAAqE;IAC3Ee,WAAW,EAAC;iDAHHH,KAAA,CAAAC,WAAW,E,6BAKtBR,mBAAA,CAEO;IAFDL,KAAK,EAAC;EAA+B,IACzCK,mBAAA,CAAwC;IAArCL,KAAK,EAAC;EAA0B,G,8BAO7CI,mBAAA,kBAAqB,EACVY,QAAA,CAAAC,gBAAgB,CAACC,MAAM,U,cAAlChB,mBAAA,CAEM,OAFNiB,UAEM,EAAAT,MAAA,QAAAA,MAAA,OADJL,mBAAA,CAAiE;IAA9DL,KAAK,EAAC;EAAY,GAAC,yCAAuC,oB,MAxBrEI,mBAAA,gBA2BMC,mBAAA,CAyCM,OAzCNe,UAyCM,I,kBAxCJlB,mBAAA,CAuCMmB,SAAA,QAnEdC,WAAA,CA4B+BN,QAAA,CAAAC,gBAAgB,EAA3BM,OAAO;yBAAnBrB,mBAAA,CAuCM;MAvCoCD,GAAG,EAAEsB,OAAO,CAACC,EAAE;MAAExB,KAAK,EAAC;QAC/DK,mBAAA,CAqCM,OArCNoB,UAqCM,GApCJpB,mBAAA,CAaM,OAbNqB,UAaM,GAXIH,OAAO,CAACI,KAAK,I,cADrBzB,mBAAA,CAKE;MApChBD,GAAA;MAiCiB2B,GAAG,EAAEZ,QAAA,CAAAa,YAAY,CAACN,OAAO,CAACI,KAAK;MAChC3B,KAAK,EAAC,4BAA4B;MAClC8B,GAAG,EAAC;4BAnCpBC,WAAA,M,cAqCc7B,mBAAA,CAEM,OAFN8B,WAEM,OAAAtB,MAAA,QAAAA,MAAA,OADJL,mBAAA,CAAuC;MAApCL,KAAK,