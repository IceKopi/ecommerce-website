>Add Product</router-link>\n        </li>\n\n        <!-- CUSTOMER NAVIGATION -->\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/products\">Shop</router-link>\n        </li>\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/cart\">Cart</router-link>\n        </li>\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/orders\">Orders</router-link>\n        </li>\n        \n        <!-- NON-LOGGED IN NAVIGATION -->\n        <li class=\"nav-item\" v-if=\"!auth.isLoggedIn\">\n          <router-link class=\"nav-link\" to=\"/products\">Shop</router-link>\n        </li>\n      </ul>\n\n      <ul class=\"navbar-nav ms-auto\">\n        <!-- Show Login/Register if LOGGED OUT -->\n        <template v-if=\"!auth.isLoggedIn\">\n          <li class=\"nav-item\">\n            <router-link class=\"nav-link\" to=\"/login\">Login</router-link>\n          </li>\n          <li class=\"nav-item\">\n            <router-link class=\"nav-link\" to=\"/register\">Register</router-link>\n          </li>\n        </template>\n\n        <!-- Show Logout if LOGGED IN -->\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn\">\n          <button class=\"btn btn-sm btn-outline-secondary\" @click=\"logout\">Logout</button>\n        </li>\n      </ul>\n    </div>\n  </nav>\n\n  <router-view />\n</template>\n\n<script>\nimport { auth } from './auth'\n\nexport default {\n  setup() {\n    return { auth }\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart')\n      localStorage.clear()\n      localStorage.setItem('cart', cart)\n\n      auth.isLoggedIn = false\n      auth.isStaff = false\n\n      this.$router.push('/login')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.navbar {\n  background-color: rgba(255, 0, 0, 0.5); /* Semi-transparent white */\n  bac