{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport axios from '../axios';\nimport { Modal } from 'bootstrap';\nexport default {\n  data() {\n    return {\n      orders: [],\n      filteredOrders: [],\n      selectedOrder: null,\n      orderDetailModal: null,\n      filters: {\n        startDate: null,\n        endDate: null\n      }\n    };\n  },\n  methods: {\n    async fetchMyOrders() {\n      try {\n        const res = await axios.get('orders/');\n        console.log('API Response:', res.data);\n\n        // Process the data to ensure we have product names and prices\n        this.orders = res.data.map(order => {\n          // Process items to include product names if not already provided\n          const items = order.items.map(item => {\n            let productName = 'Unknown Product';\n            let productPrice = 0;\n\n            // Handle different product data structures\n            if (typeof item.product === 'object' && item.product !== null) {\n              productName = item.product.name || `Product #${item.product.id}`;\n              productPrice = parseFloat(item.product.price) || 0;\n            } else if (typeof item.product === 'string') {\n              productName = item.product;\n              productPrice = parseFloat(item.price || 0);\n            } else if (typeof item.product === 'number') {\n              productName = `Product #${item.product}`;\n              productPrice = parseFloat(item.price || 0);\n            }\n\n            // Ensure price is always a number\n            const finalPrice = typeof item.price !== 'undefined' ? parseFloat(item.price) : productPrice;\n            return {\n              ...item,\n              product_name: item.product_name || productName,\n              price: isNaN(finalPrice) ? 0 : finalPrice\n            };\n          });\n\n          // Add default values for optional fields\n          return {\n            ...order,\n            status: order.status || 'processing',\n            shipping_address: order.shipping_address || null,\n            payment_method: order.payment_method || null,\n            shipping_cost: order.shipping_cost || 0,\n            tax: order.tax || 0,\n            items: items\n          };\n        });\n        this.filteredOrders = [...this.orders];\n        console.log('Processed Orders:', this.orders);\n      } catch (error) {\n        console.error('Error fetching orders:', error);\n        alert('❌ Failed to load your orders.');\n      }\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return new Intl.DateTimeFormat('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      }).format(date);\n    },\n    formatStatus(status) {\n      if (!status) return 'Processing';\n\n      // Capitalize first letter\n      return status.charAt(0).toUpperCase() + status.slice(1);\n    },\n    getStatusBadgeClass(status) {\n      switch (status?.toLowerCase()) {\n        case 'completed':\n          return 'bg-success';\n        case 'processing':\n          return 'bg-primary';\n        case 'shipped':\n          return 'bg-info';\n        case 'cancelled':\n          return 'bg-danger';\n        case 'pending':\n          return 'bg-warning';\n        default:\n          return 'bg-secondary';\n      }\n    },\n    openOrderDetailModal(order) {\n      this.selectedOrder = order;\n      this.orderDetailModal.show();\n    },\n    calculateTotal(items) {\n      return items.reduce((sum, item) => {\n        const price = parseFloat(item.price || 0);\n        const quantity = parseFloat(item.quantity || 0);\n        return sum + price * quantity;\n      }, 0);\n    },\n    applyFilters() {\n      if (!this.filters.startDate && !this.filters.endDate) {\n        this.filteredOrders = [...this.orders];\n        return;\n      }\n      const startDate = this.filters.startDate ? new Date(this.filters.startDate) : null;\n      const endDate = this.filters.endDate ? new Date(this.filters.endDate) : null;\n\n      // If endDate is provided, set it to end of day (23:59:59)\n      if (endDate) {\n        endDate.setHours(23, 59, 59, 999);\n      }\n      this.filteredOrders = this.orders.filter(order => {\n        const orderDate = new Date(order.date_ordered);\n\n        // Check if the order date is within the filter range\n        if (startDate && orderDate < startDate) {\n          return false;\n        }\n        if (endDate && orderDate > endDate) {\n          return false;\n        }\n        return true;\n      });\n    },\n    resetFilters() {\n      this.filters.startDate = null;\n      this.filters.endDate = null;\n      this.filteredOrders = [...this.orders];\n    },\n    printOrderDetails() {\n      const printContents = document.querySelector('.order-detail-container').innerHTML;\n      const originalContents = document.body.innerHTML;\n      document.body.innerHTML = `\n        <div style=\"padding: 20px;\">\n          ${printContents}\n        </div>\n      `;\n      window.print();\n      document.body.innerHTML = originalContents;\n\n      // Re-initialize the modal and other components\n      this.$nextTick(() => {\n        this.initializeModal();\n      });\n    },\n    initializeModal() {\n      const orderDetailModalElement = document.getElementById('orderDetailModal');\n      if (orderDetailModalElement) {\n        this.orderDetailModal = new Modal(orderDetailModalElement);\n      }\n    }\n  },\n  mounted() {\n    const token = localStorage.getItem('access');\n    if (!token) {\n      alert('⛔ You need to be logged in to view your orders.');\n      this.$router.push('/login');\n      return;\n    }\n    this.fetchMyOrders();\n    this.$nextTick(() => {\n      this.initializeModal();\n    });\n  }\n};","map":{"version":3,"names":["axios","Modal","data","orders","filteredOrders","selectedOrder","orderDetailModal","filters","startDate","endDate","methods","fetchMyOrders","res","get","console","log","map","order","items","item","productName","productPrice","product","name","id","parseFloat","price","finalPrice","product_name","isNaN","status","shipping_address","payment_method","shipping_cost","tax","error","alert","formatDate","dateString","date","Date","Intl","DateTimeFormat","year","month","day","hour","minute","format","formatStatus","charAt","toUpperCase","slice","getStatusBadgeClass","toLowerCase","openOrderDetailModal","show","calculateTotal","reduce","sum","quantity","applyFilters","setHours","filter","orderDate","date_ordered","resetFilters","printOrderDetails","printContents","document","querySelector","innerHTML","originalContents","body","window","print","$nextTick","initializeModal","orderDetailModalElement","getElementById","mounted","token","localStorage","getItem","$router","push"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\views\\OrderHistory.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-5\">\r\n    <div class=\"row justify-content-center\">\r\n      <div class=\"col-lg-10\">\r\n        <h3 class=\"mb-4 fw-light text-center display-6\">\r\n          <i class=\"bi bi-bag-check\"></i> My Order History\r\n        </h3>\r\n        \r\n        <!-- Date Filter -->\r\n        <div class=\"card shadow-sm border-0 mb-4\">\r\n          <div class=\"card-body\">\r\n            <div class=\"row align-items-center\">\r\n              <div class=\"col-md-5\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"startDate\" class=\"form-label text-brown\">From Date</label>\r\n                  <input \r\n                    type=\"date\" \r\n                    class=\"form-control\" \r\n                    id=\"startDate\" \r\n                    v-model=\"filters.startDate\" \r\n                    @change=\"applyFilters\"\r\n                  >\r\n                </div>\r\n              </div>\r\n              <div class=\"col-md-5\">\r\n                <div class=\"form-group\">\r\n                  <label for=\"endDate\" class=\"form-label text-brown\">To Date</label>\r\n                  <input \r\n                    type=\"date\" \r\n                    class=\"form-control\" \r\n                    id=\"endDate\" \r\n                    v-model=\"filters.endDate\" \r\n                    @change=\"applyFilters\"\r\n                  >\r\n                </div>\r\n              </div>\r\n              <div class=\"col-md-2 d-flex align-items-end\">\r\n                <button \r\n                  class=\"btn btn-brown w-100\" \r\n                  @click=\"resetFilters\"\r\n                >\r\n                  Reset\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- No Orders Message -->\r\n        <div class=\"card shadow-sm border-0 mb-4\" v-if=\"filteredOrders.length === 0\">\r\n          <div class=\"card-body text-center p-5 text-muted\">\r\n            <i class=\"bi bi-bag-x fs-1\"></i>\r\n            <p class=\"mt-3\">No orders found.</p>\r\n            <button class=\"btn btn-brown mt-2\" @click=\"$router.push('/shop')\">\r\n              Start Shopping\r\n            </button>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- Order Cards -->\r\n        <div v-for=\"order in filteredOrders\" :key=\"order.id\" class=\"card mb-3 shadow-sm border-0\">\r\n          <div class=\"card-header bg-transparent border-bottom-0 pt-3\">\r\n            <div class=\"d-flex justify-content-between align-items-center\">\r\n              <h6 class=\"fw-normal text-brown mb-0\">\r\n                Order #{{ order.id }}\r\n              </h6>\r\n              <div>\r\n                <span class=\"badge bg-soft-brown text-brown\">\r\n                  {{ formatDate(order.date_ordered) }}\r\n                </span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div class=\"card-body pt-0\">\r\n            \r\n            <div class=\"items-list mb-3\">\r\n              <div v-for=\"item in order.items\" :key=\"item.id\" class=\"d-flex justify-content-between align-items-center py-2 border-bottom border-light\">\r\n                <div>\r\n                  <span class=\"fw-medium\">{{ item.product_name || 'Unknown Product' }}</span>\r\n                  <span class=\"text-muted ms-2\">× {{ item.quantity || 0 }}</span>\r\n                </div>\r\n                <span class=\"text-brown\">${{ parseFloat(item.price || 0).toFixed(2) }}</span>\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"d-flex justify-content-between align-items-center\">\r\n              <span class=\"fw-bold\">Total: <span class=\"text-brown\">${{ calculateTotal(order.items).toFixed(2) }}</span></span>\r\n              <button class=\"btn btn-outline-brown px-4\" @click=\"openOrderDetailModal(order)\">\r\n                <i class=\"bi bi-info-circle me-1\"></i> View Details\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Order Detail Modal -->\r\n    <div class=\"modal fade\" id=\"orderDetailModal\" tabindex=\"-1\" aria-labelledby=\"orderDetailModalLabel\" aria-hidden=\"true\">\r\n      <div class=\"modal-dialog modal-dialog-centered\">\r\n        <div class=\"modal-content border-0\">\r\n          <div class=\"modal-header border-0\">\r\n            <h5 class=\"modal-title fw-light text-brown\" id=\"orderDetailModalLabel\">\r\n              Order #{{ selectedOrder?.id }} Details\r\n            </h5>\r\n            <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n          </div>\r\n          <div class=\"modal-body\" v-if=\"selectedOrder\">\r\n            <div class=\"order-detail-container p-4\">\r\n              <div class=\"text-center mb-4\">\r\n                <h4 class=\"fw-light text-uppercase mb-2\">ORDER DETAILS</h4>\r\n                <p class=\"mb-1 small\">Order #{{ selectedOrder.id }}</p>\r\n                <p class=\"small text-muted\">{{ formatDate(selectedOrder.date_ordered) }}</p>\r\n                <div class=\"separator my-3 mx-auto\"></div>\r\n              </div>\r\n              \r\n              <div class=\"order-info mb-4\">\r\n                <div class=\"row\">\r\n                  <div class=\"col-md-6\">\r\n                    <p class=\"fw-medium mb-1\">Order Date</p>\r\n                    <p class=\"mb-3\">{{ formatDate(selectedOrder.date_ordered) }}</p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"separator my-3 mx-auto\"></div>\r\n              \r\n              <h5 class=\"fw-light mb-3\">Items</h5>\r\n              <table class=\"table receipt-table\">\r\n                <thead class=\"table-light\">\r\n                  <tr class=\"text-brown\">\r\n                    <th class=\"fw-medium\">Item</th>\r\n                    <th class=\"fw-medium\">Qty</th>\r\n                    <th class=\"text-end fw-medium\">Price</th>\r\n                    <th class=\"text-end fw-medium\">Total</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody>\r\n                  <tr v-for=\"item in selectedOrder.items\" :key=\"item.id\">\r\n                    <td>{{ item.product_name || 'Unknown Product' }}</td>\r\n                    <td>{{ item.quantity || 0 }}</td>\r\n                    <td class=\"text-end\">${{ parseFloat(item.price || 0).toFixed(2) }}</td>\r\n                    <td class=\"text-end\">${{ (parseFloat(item.price || 0) * parseFloat(item.quantity || 0)).toFixed(2) }}</td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td colspan=\"3\" class=\"text-end border-0\">Subtotal</td>\r\n                    <td class=\"text-end border-0\">${{ calculateTotal(selectedOrder.items).toFixed(2) }}</td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td colspan=\"3\" class=\"text-end border-0\">Shipping</td>\r\n                    <td class=\"text-end border-0\">${{ (selectedOrder.shipping_cost || 0).toFixed(2) }}</td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td colspan=\"3\" class=\"text-end border-0\">Tax</td>\r\n                    <td class=\"text-end border-0\">${{ (selectedOrder.tax || 0).toFixed(2) }}</td>\r\n                  </tr>\r\n                  <tr class=\"border-top\">\r\n                    <td colspan=\"3\" class=\"text-end\"><strong>Total</strong></td>\r\n                    <td class=\"text-end\">\r\n                      <strong class=\"text-brown\">\r\n                        ${{ (calculateTotal(selectedOrder.items) + (selectedOrder.shipping_cost || 0) + (selectedOrder.tax || 0)).toFixed(2) }}\r\n                      </strong>\r\n                    </td>\r\n                  </tr>\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n          </div>\r\n          <div class=\"modal-footer border-0\">\r\n            <button type=\"button\" class=\"btn btn-light\" data-bs-dismiss=\"modal\">Close</button>\r\n            <button type=\"button\" class=\"btn btn-brown\" @click=\"printOrderDetails\">\r\n              <i class=\"bi bi-printer me-1\"></i> Print Details\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\nimport { Modal } from 'bootstrap'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      orders: [],\r\n      filteredOrders: [],\r\n      selectedOrder: null,\r\n      orderDetailModal: null,\r\n      filters: {\r\n        startDate: null,\r\n        endDate: null\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    async fetchMyOrders() {\r\n      try {\r\n        const res = await axios.get('orders/')\r\n        console.log('API Response:', res.data)\r\n        \r\n        // Process the data to ensure we have product names and prices\r\n        this.orders = res.data.map(order => {\r\n          // Process items to include product names if not already provided\r\n          const items = order.items.map(item => {\r\n            let productName = 'Unknown Product'\r\n            let productPrice = 0\r\n            \r\n            // Handle different product data structures\r\n            if (typeof item.product === 'object' && item.product !== null) {\r\n              productName = item.product.name || `Product #${item.product.id}`\r\n              productPrice = parseFloat(item.product.price) || 0\r\n            } else if (typeof item.product === 'string') {\r\n              productName = item.product\r\n              productPrice = parseFloat(item.price || 0)\r\n            } else if (typeof item.product === 'number') {\r\n              productName = `Product #${item.product}`\r\n              productPrice = parseFloat(item.price || 0)\r\n            }\r\n            \r\n            // Ensure price is always a number\r\n            const finalPrice = typeof item.price !== 'undefined' ? \r\n              parseFloat(item.price) : productPrice\r\n            \r\n            return {\r\n              ...item,\r\n              product_name: item.product_name || productName,\r\n              price: isNaN(finalPrice) ? 0 : finalPrice\r\n            }\r\n          })\r\n          \r\n          // Add default values for optional fields\r\n          return {\r\n            ...order,\r\n            status: order.status || 'processing',\r\n            shipping_address: order.shipping_address || null,\r\n            payment_method: order.payment_method || null,\r\n            shipping_cost: order.shipping_cost || 0,\r\n            tax: order.tax || 0,\r\n            items: items\r\n          }\r\n        })\r\n        \r\n        this.filteredOrders = [...this.orders]\r\n        console.log('Processed Orders:', this.orders)\r\n      } catch (error) {\r\n        console.error('Error fetching orders:', error)\r\n        alert('❌ Failed to load your orders.')\r\n      }\r\n    },\r\n    \r\n    formatDate(dateString) {\r\n      const date = new Date(dateString)\r\n      return new Intl.DateTimeFormat('en-US', {\r\n        year: 'numeric',\r\n        month: 'short',\r\n        day: 'numeric',\r\n        hour: '2-digit',\r\n        minute: '2-digit'\r\n      }).format(date)\r\n    },\r\n    \r\n    formatStatus(status) {\r\n      if (!status) return 'Processing'\r\n      \r\n      // Capitalize first letter\r\n      return status.charAt(0).toUpperCase() + status.slice(1)\r\n    },\r\n    \r\n    getStatusBadgeClass(status) {\r\n      switch (status?.toLowerCase()) {\r\n        case 'completed':\r\n          return 'bg-success'\r\n        case 'processing':\r\n          return 'bg-primary'\r\n        case 'shipped':\r\n          return 'bg-info'\r\n        case 'cancelled':\r\n          return 'bg-danger'\r\n        case 'pending':\r\n          return 'bg-warning'\r\n        default:\r\n          return 'bg-secondary'\r\n      }\r\n    },\r\n    \r\n    openOrderDetailModal(order) {\r\n      this.selectedOrder = order\r\n      this.orderDetailModal.show()\r\n    },\r\n    \r\n    calculateTotal(items) {\r\n      return items.reduce((sum, item) => {\r\n        const price = parseFloat(item.price || 0)\r\n        const quantity = parseFloat(item.quantity || 0)\r\n        return sum + (price * quantity)\r\n      }, 0)\r\n    },\r\n    \r\n    applyFilters() {\r\n      if (!this.filters.startDate && !this.filters.endDate) {\r\n        this.filteredOrders = [...this.orders]\r\n        return\r\n      }\r\n      \r\n      const startDate = this.filters.startDate ? new Date(this.filters.startDate) : null\r\n      const endDate = this.filters.endDate ? new Date(this.filters.endDate) : null\r\n      \r\n      // If endDate is provided, set it to end of day (23:59:59)\r\n      if (endDate) {\r\n        endDate.setHours(23, 59, 59, 999)\r\n      }\r\n      \r\n      this.filteredOrders = this.orders.filter(order => {\r\n        const orderDate = new Date(order.date_ordered)\r\n        \r\n        // Check if the order date is within the filter range\r\n        if (startDate && orderDate < startDate) {\r\n          return false\r\n        }\r\n        \r\n        if (endDate && orderDate > endDate) {\r\n          return false\r\n        }\r\n        \r\n        return true\r\n      })\r\n    },\r\n    \r\n    resetFilters() {\r\n      this.filters.startDate = null\r\n      this.filters.endDate = null\r\n      this.filteredOrders = [...this.orders]\r\n    },\r\n    \r\n    printOrderDetails() {\r\n      const printContents = document.querySelector('.order-detail-container').innerHTML\r\n      const originalContents = document.body.innerHTML\r\n      \r\n      document.body.innerHTML = `\r\n        <div style=\"padding: 20px;\">\r\n          ${printContents}\r\n        </div>\r\n      `\r\n      \r\n      window.print()\r\n      document.body.innerHTML = originalContents\r\n      \r\n      // Re-initialize the modal and other components\r\n      this.$nextTick(() => {\r\n        this.initializeModal()\r\n      })\r\n    },\r\n    \r\n    initializeModal() {\r\n      const orderDetailModalElement = document.getElementById('orderDetailModal')\r\n      if (orderDetailModalElement) {\r\n        this.orderDetailModal = new Modal(orderDetailModalElement)\r\n      }\r\n    }\r\n  },\r\n  mounted() {\r\n    const token = localStorage.getItem('access')\r\n    if (!token) {\r\n      alert('⛔ You need to be logged in to view your orders.')\r\n      this.$router.push('/login')\r\n      return\r\n    }\r\n    \r\n    this.fetchMyOrders()\r\n    this.$nextTick(() => {\r\n      this.initializeModal()\r\n    })\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Brown and neutral color palette */\r\n:root {\r\n  --primary-brown: #8B6E4E;\r\n  --light-brown: #A68C69;\r\n  --dark-brown: #6F563D;\r\n  --soft-brown: #F2EAE1;\r\n  --light-beige: #F9F6F2;\r\n  --dark-beige: #E6DFD5;\r\n}\r\n\r\n.text-brown {\r\n  color: var(--primary-brown);\r\n}\r\n\r\n.bg-brown {\r\n  background-color: var(--primary-brown);\r\n}\r\n\r\n.bg-soft-brown {\r\n  background-color: var(--soft-brown);\r\n}\r\n\r\n.btn-brown {\r\n  background-color: var(--primary-brown);\r\n  color: white;\r\n  border: none;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.btn-brown:hover {\r\n  background-color: var(--dark-brown);\r\n  color: white;\r\n}\r\n\r\n.btn-outline-brown {\r\n  color: var(--primary-brown);\r\n  border-color: var(--primary-brown);\r\n  background-color: transparent;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.btn-outline-brown:hover {\r\n  background-color: var(--primary-brown);\r\n  color: white;\r\n}\r\n\r\n/* Typography Enhancements */\r\nh3, h4, h5, h6 {\r\n  font-family: 'Playfair Display', Georgia, serif;\r\n}\r\n\r\nbody {\r\n  font-family: 'Lato', 'Helvetica Neue', Arial, sans-serif;\r\n}\r\n\r\n.order-detail-container {\r\n  font-family: 'Lato', 'Helvetica Neue', Arial, sans-serif;\r\n  border: 1px solid var(--dark-beige);\r\n  border-radius: 8px;\r\n  background-color: var(--light-beige);\r\n}\r\n\r\n.receipt-table th, .receipt-table td {\r\n  padding: 0.75rem;\r\n}\r\n\r\n.separator {\r\n  height: 1px;\r\n  width: 70%;\r\n  background-color: var(--dark-beige);\r\n}\r\n\r\n.card {\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n  background-color: var(--light-beige);\r\n}\r\n\r\n.card:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 10px 20px rgba(139, 110, 78, 0.1) !important;\r\n}\r\n\r\n/* Print Styles */\r\n@media print {\r\n  body * {\r\n    visibility: hidden;\r\n  }\r\n  .order-detail-container, .order-detail-container * {\r\n    visibility: visible;\r\n  }\r\n  .order-detail-container {\r\n    position: absolute;\r\n    left: 0;\r\n    top: 0;\r\n    width: 100%;\r\n    background-color: white !important;\r\n  }\r\n}\r\n</style>"],"mappings":";;;;;AAoLA,OAAOA,KAAI,MAAO,UAAS;AAC3B,SAASC,KAAI,QAAS,WAAU;AAEhC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,EAAE;MACVC,cAAc,EAAE,EAAE;MAClBC,aAAa,EAAE,IAAI;MACnBC,gBAAgB,EAAE,IAAI;MACtBC,OAAO,EAAE;QACPC,SAAS,EAAE,IAAI;QACfC,OAAO,EAAE;MACX;IACF;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,MAAMC,GAAE,GAAI,MAAMZ,KAAK,CAACa,GAAG,CAAC,SAAS;QACrCC,OAAO,CAACC,GAAG,CAAC,eAAe,EAAEH,GAAG,CAACV,IAAI;;QAErC;QACA,IAAI,CAACC,MAAK,GAAIS,GAAG,CAACV,IAAI,CAACc,GAAG,CAACC,KAAI,IAAK;UAClC;UACA,MAAMC,KAAI,GAAID,KAAK,CAACC,KAAK,CAACF,GAAG,CAACG,IAAG,IAAK;YACpC,IAAIC,WAAU,GAAI,iBAAgB;YAClC,IAAIC,YAAW,GAAI;;YAEnB;YACA,IAAI,OAAOF,IAAI,CAACG,OAAM,KAAM,QAAO,IAAKH,IAAI,CAACG,OAAM,KAAM,IAAI,EAAE;cAC7DF,WAAU,GAAID,IAAI,CAACG,OAAO,CAACC,IAAG,IAAK,YAAYJ,IAAI,CAACG,OAAO,CAACE,EAAE,EAAC;cAC/DH,YAAW,GAAII,UAAU,CAACN,IAAI,CAACG,OAAO,CAACI,KAAK,KAAK;YACnD,OAAO,IAAI,OAAOP,IAAI,CAACG,OAAM,KAAM,QAAQ,EAAE;cAC3CF,WAAU,GAAID,IAAI,CAACG,OAAM;cACzBD,YAAW,GAAII,UAAU,CAACN,IAAI,CAACO,KAAI,IAAK,CAAC;YAC3C,OAAO,IAAI,OAAOP,IAAI,CAACG,OAAM,KAAM,QAAQ,EAAE;cAC3CF,WAAU,GAAI,YAAYD,IAAI,CAACG,OAAO,EAAC;cACvCD,YAAW,GAAII,UAAU,CAACN,IAAI,CAACO,KAAI,IAAK,CAAC;YAC3C;;YAEA;YACA,MAAMC,UAAS,GAAI,OAAOR,IAAI,CAACO,KAAI,KAAM,WAAU,GACjDD,UAAU,CAACN,IAAI,CAACO,KAAK,IAAIL,YAAW;YAEtC,OAAO;cACL,GAAGF,IAAI;cACPS,YAAY,EAAET,IAAI,CAACS,YAAW,IAAKR,WAAW;cAC9CM,KAAK,EAAEG,KAAK,CAACF,UAAU,IAAI,IAAIA;YACjC;UACF,CAAC;;UAED;UACA,OAAO;YACL,GAAGV,KAAK;YACRa,MAAM,EAAEb,KAAK,CAACa,MAAK,IAAK,YAAY;YACpCC,gBAAgB,EAAEd,KAAK,CAACc,gBAAe,IAAK,IAAI;YAChDC,cAAc,EAAEf,KAAK,CAACe,cAAa,IAAK,IAAI;YAC5CC,aAAa,EAAEhB,KAAK,CAACgB,aAAY,IAAK,CAAC;YACvCC,GAAG,EAAEjB,KAAK,CAACiB,GAAE,IAAK,CAAC;YACnBhB,KAAK,EAAEA;UACT;QACF,CAAC;QAED,