{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport axios from '../axios';\nimport { Modal } from 'bootstrap';\nexport default {\n  data() {\n    return {\n      orders: [],\n      selectedOrder: null,\n      receiptModal: null\n    };\n  },\n  methods: {\n    async fetchAllOrders() {\n      try {\n        const res = await axios.get('admin-orders/');\n        console.log('API Response:', res.data); // Debug: Log the response to see its structure\n\n        // Process the data to include customer names and product names\n        this.orders = res.data.map(order => {\n          let customerName = 'Unknown User';\n\n          // Handle different customer data structures\n          if (typeof order.customer === 'object' && order.customer !== null) {\n            customerName = order.customer.username || `User #${order.customer.id}`;\n          } else if (typeof order.customer === 'number') {\n            customerName = `User #${order.customer}`;\n          }\n\n          // Process items to include product names\n          const items = order.items.map(item => {\n            let productName = 'Unknown Product';\n            let productPrice = 0;\n\n            // Handle different product data structures\n            if (typeof item.product === 'object' && item.product !== null) {\n              productName = item.product.name || `Product #${item.product.id}`;\n              productPrice = parseFloat(item.product.price) || 0;\n            } else if (typeof item.product === 'number') {\n              // If only product ID is available, we'll use a placeholder\n              productName = `Product #${item.product}`;\n\n              // Try to get product name from the product field directly if it exists\n              if (item.product_name) {\n                productName = item.product_name;\n              }\n\n              // Try to get price from the item if it exists\n              if (item.price) {\n                productPrice = parseFloat(item.price);\n              }\n            }\n            return {\n              ...item,\n              product_name: productName,\n              price: productPrice\n            };\n          });\n          return {\n            ...order,\n            customer_name: customerName,\n            items: items\n          };\n        });\n        console.log('Processed Orders:', this.orders); // Debug: Log the processed orders\n      } catch (error) {\n        console.error('Error fetching orders:', error);\n        alert('❌ Failed to load orders.');\n      }\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return new Intl.DateTimeFormat('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      }).format(date);\n    },\n    openReceiptModal(order) {\n      this.selectedOrder = order;\n      this.receiptModal.show();\n    },\n    printReceipt() {\n      const printContents = document.querySelector('.receipt-container').innerHTML;\n      const originalContents = document.body.innerHTML;\n      document.body.innerHTML = `\n          <div style=\"padding: 20px;\">\n            ${printContents}\n          </div>\n        `;\n      window.print();\n      document.body.innerHTML = originalContents;\n\n      // Re-initialize the modal and other components\n      this.$nextTick(() => {\n        this.initializeModal();\n      });\n    },\n    calculateTotal(items) {\n      return items.reduce((sum, item) => sum + item.price * item.quantity, 0);\n    },\n    initializeModal() {\n      const modalElement = document.getElementById('receiptModal');\n      if (modalElement) {\n        this.receiptModal = new Modal(modalElement);\n      }\n    }\n  },\n  mounted() {\n    const token = localStorage.getItem('access');\n    const isStaff = localStorage.getItem('is_staff') === 'true';\n    if (!token || !isStaff) {\n      alert('⛔ Access denied. Staff only.');\n      this.$router.push('/login');\n      return;\n    }\n    this.fetchAllOrders();\n    this.$nextTick(() => {\n      this.initializeModal();\n    });\n  }\n};","map":{"version":3,"names":["axios","Modal","data","orders","selectedOrder","receiptModal","methods","fetchAllOrders","res","get","console","log","map","order","customerName","customer","username","id","items","item","productName","productPrice","product","name","parseFloat","price","product_name","customer_name","error","alert","formatDate","dateString","date","Date","Intl","DateTimeFormat","year","month","day","hour","minute","format","openReceiptModal","show","printReceipt","printContents","document","querySelector","innerHTML","originalContents","body","window","print","$nextTick","initializeModal","calculateTotal","reduce","sum","quantity","modalElement","getElementById","mounted","token","localStorage","getItem","isStaff","$router","push"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\AdminTransactionHistory.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-4\">\r\n      <h3>📄 Transaction History</h3>\r\n      <div v-if=\"orders.length === 0\">No transactions found.</div>\r\n      <div v-for=\"order in orders\" :key=\"order.id\" class=\"card mb-2\">\r\n        <div class=\"card-body\">\r\n          <h6>Order #{{ order.id }} — {{ formatDate(order.date_ordered) }}</h6>\r\n          <p><strong>Customer:</strong> {{ order.customer_name }}</p>\r\n          <ul>\r\n            <li v-for=\"item in order.items\" :key=\"item.id\">\r\n              {{ item.product_name || 'Unknown Product' }} — \r\n              Qty: {{ item.quantity || 0 }} — \r\n              ${{ (item.price || 0).toFixed(2) }}\r\n            </li>\r\n          </ul>\r\n          <div class=\"text-end\">\r\n            <button class=\"btn btn-sm btn-primary\" @click=\"openReceiptModal(order)\">\r\n              View Receipt\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- Receipt Modal -->\r\n      <div class=\"modal fade\" id=\"receiptModal\" tabindex=\"-1\" aria-labelledby=\"receiptModalLabel\" aria-hidden=\"true\">\r\n        <div class=\"modal-dialog\">\r\n          <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n              <h5 class=\"modal-title\" id=\"receiptModalLabel\">\r\n                Receipt for Order #{{ selectedOrder?.id }}\r\n              </h5>\r\n              <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n            </div>\r\n            <div class=\"modal-body\" v-if=\"selectedOrder\">\r\n              <div class=\"receipt-container p-3\">\r\n                <div class=\"text-center mb-3\">\r\n                  <h4>RECEIPT</h4>\r\n                  <p>Order #{{ selectedOrder.id }}</p>\r\n                  <p>{{ formatDate(selectedOrder.date_ordered) }}</p>\r\n                </div>\r\n                \r\n                <div class=\"customer-details mb-3\">\r\n                  <p><strong>Customer:</strong> {{ selectedOrder.customer_name }}</p>\r\n                </div>\r\n                \r\n                <table class=\"table table-sm\">\r\n                  <thead>\r\n                    <tr>\r\n                      <th>Item</th>\r\n                      <th>Qty</th>\r\n                      <th class=\"text-end\">Price</th>\r\n                      <th class=\"text-end\">Total</th>\r\n                    </tr>\r\n                  </thead>\r\n                  <tbody>\r\n                    <tr v-for=\"item in selectedOrder.items\" :key=\"item.id\">\r\n                      <td>{{ item.product_name || 'Unknown Product' }}</td>\r\n                      <td>{{ item.quantity || 0 }}</td>\r\n                      <td class=\"text-end\">${{ (item.price || 0).toFixed(2) }}</td>\r\n                      <td class=\"text-end\">${{ ((item.price || 0) * (item.quantity || 0)).toFixed(2) }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                      <td colspan=\"3\" class=\"text-end\"><strong>Total</strong></td>\r\n                      <td class=\"text-end\"><strong>${{ calculateTotal(selectedOrder.items).toFixed(2) }}</strong></td>\r\n                    </tr>\r\n                  </tbody>\r\n                </table>\r\n                \r\n                <div class=\"text-center mt-4\">\r\n                  <p>Thank you for your purchase!</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"modal-footer\">\r\n              <button type=\"button\" class=\"btn btn-secondary\" data-bs-dismiss=\"modal\">Close</button>\r\n              <button type=\"button\" class=\"btn btn-primary\" @click=\"printReceipt\">Print Receipt</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  import { Modal } from 'bootstrap'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        orders: [],\r\n        selectedOrder: null,\r\n        receiptModal: null\r\n      }\r\n    },\r\n    methods: {\r\n      async fetchAllOrders() {\r\n        try {\r\n          const res = await axios.get('admin-orders/')\r\n          console.log('API Response:', res.data) // Debug: Log the response to see its structure\r\n          \r\n          // Process the data to include customer names and product names\r\n          this.orders = res.data.map(order => {\r\n            let customerName = 'Unknown User'\r\n            \r\n            // Handle different customer data structures\r\n            if (typeof order.customer === 'object' && order.customer !== null) {\r\n              customerName = order.customer.username || `User #${order.customer.id}`\r\n            } else if (typeof order.customer === 'number') {\r\n              customerName = `User #${order.customer}`\r\n            }\r\n            \r\n            // Process items to include product names\r\n            const items = order.items.map(item => {\r\n              let productName = 'Unknown Product'\r\n              let productPrice = 0\r\n              \r\n              // Handle different product data structures\r\n              if (typeof item.product === 'object' && item.product !== null) {\r\n                productName = item.product.name || `Product #${item.product.id}`\r\n                productPrice = parseFloat(item.product.price) || 0\r\n              } else if (typeof item.product === 'number') {\r\n                // If only product ID is available, we'll use a placeholder\r\n                productName = `Product #${item.product}`\r\n                \r\n                // Try to get product name from the product field directly if it exists\r\n                if (item.product_name) {\r\n                  productName = item.product_name\r\n                }\r\n                \r\n                // Try to get price from the item if it exists\r\n                if (item.price) {\r\n                  productPrice = parseFloat(item.price)\r\n                }\r\n              }\r\n              \r\n              return {\r\n                ...item,\r\n                product_name: productName,\r\n                price: productPrice\r\n              }\r\n            })\r\n            \r\n            return {\r\n              ...order,\r\n              customer_name: customerName,\r\n              items: items\r\n            }\r\n          })\r\n          \r\n          console.log('Processed Orders:', this.orders) // Debug: Log the processed orders\r\n        } catch (error) {\r\n          console.error('Error fetching orders:', error)\r\n          alert('❌ Failed to load orders.')\r\n        }\r\n      },\r\n      \r\n      formatDate(dateString) {\r\n        const date = new Date(dateString)\r\n        return new Intl.DateTimeFormat('en-US', {\r\n          year: 'numeric',\r\n          month: 'short',\r\n          day: 'numeric',\r\n          hour: '2-digit',\r\n          minute: '2-digit'\r\n        }).format(date)\r\n      },\r\n      \r\n      openReceiptModal(order) {\r\n        this.selectedOrder = order\r\n        this.receiptModal.show()\r\n      },\r\n      \r\n      printReceipt() {\r\n        const printContents = document.querySelector('.receipt-container').innerHTML\r\n        const originalContents = document.body.innerHTML\r\n        \r\n        document.body.innerHTML = `\r\n          <div style=\"padding: 20px;\">\r\n            ${printContents}\r\n          </div>\r\n        `\r\n        \r\n        window.print()\r\n        document.body.innerHTML = originalContents\r\n        \r\n        // Re-initialize the modal and other components\r\n        this.$nextTick(() => {\r\n          this.initializeModal()\r\n        })\r\n      },\r\n      \r\n      calculateTotal(items) {\r\n        return items.reduce((sum, item) => sum + (item.price * item.quantity), 0)\r\n      },\r\n      \r\n      initializeModal() {\r\n        const modalElement = document.getElementById('receiptModal')\r\n        if (modalElement) {\r\n          this.receiptModal = new Modal(modalElement)\r\n        }\r\n      }\r\n    },\r\n    mounted() {\r\n      const token = localStorage.getItem('access')\r\n      const isStaff = localStorage.getItem('is_staff') === 'true'\r\n      if (!token || !isStaff) {\r\n        alert('⛔ Access denied. Staff only.')\r\n        this.$router.push('/login')\r\n        return\r\n      }\r\n      \r\n      this.fetchAllOrders()\r\n      this.$nextTick(() => {\r\n        this.initializeModal()\r\n      })\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .receipt-container {\r\n    font-family: 'Courier New', monospace;\r\n    border: 1px solid #ddd;\r\n    border-radius: 5px;\r\n    background-color: #f9f9f9;\r\n  }\r\n  \r\n  @media print {\r\n    body * {\r\n      visibility: hidden;\r\n    }\r\n    .receipt-container, .receipt-container * {\r\n      visibility: visible;\r\n    }\r\n    .receipt-container {\r\n      position: absolute;\r\n      left: 0;\r\n      top: 0;\r\n      width: 100%;\r\n    }\r\n  }\r\n  </style>"],"mappings":";;;;AAoFE,OAAOA,KAAI,MAAO,UAAS;AAC3B,SAASC,KAAI,QAAS,WAAU;AAEhC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,EAAE;MACVC,aAAa,EAAE,IAAI;MACnBC,YAAY,EAAE;IAChB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF,MAAMC,GAAE,GAAI,MAAMR,KAAK,CAACS,GAAG,CAAC,eAAe;QAC3CC,OAAO,CAACC,GAAG,CAAC,eAAe,EAAEH,GAAG,CAACN,IAAI,GAAE;;QAEvC;QACA,IAAI,CAACC,MAAK,GAAIK,GAAG,CAACN,IAAI,CAACU,GAAG,CAACC,KAAI,IAAK;UAClC,IAAIC,YAAW,GAAI,cAAa;;UAEhC;UACA,IAAI,OAAOD,KAAK,CAACE,QAAO,KAAM,QAAO,IAAKF,KAAK,CAACE,QAAO,KAAM,IAAI,EAAE;YACjED,YAAW,GAAID,KAAK,CAACE,QAAQ,CAACC,QAAO,IAAK,SAASH,KAAK,CAACE,QAAQ,CAACE,EAAE,EAAC;UACvE,OAAO,IAAI,OAAOJ,KAAK,CAACE,QAAO,KAAM,QAAQ,EAAE;YAC7CD,YAAW,GAAI,SAASD,KAAK,CAACE,QAAQ,EAAC;UACzC;;UAEA;UACA,MAAMG,KAAI,GAAIL,KAAK,CAACK,KAAK,CAACN,GAAG,CAACO,IAAG,IAAK;YACpC,IAAIC,WAAU,GAAI,iBAAgB;YAClC,IAAIC,YAAW,GAAI;;YAEnB;YACA,IAAI,OAAOF,IAAI,CAACG,OAAM,KAAM,QAAO,IAAKH,IAAI,CAACG,OAAM,KAAM,IAAI,EAAE;cAC7DF,WAAU,GAAID,IAAI,CAACG,OAAO,CAACC,IAAG,IAAK,YAAYJ,IAAI,CAACG,OAAO,CAACL,EAAE,EAAC;cAC/DI,YAAW,GAAIG,UAAU,CAACL,IAAI,CAACG,OAAO,CAACG,KAAK,KAAK;YACnD,OAAO,IAAI,OAAON,IAAI,CAACG,OAAM,KAAM,QAAQ,EAAE;cAC3C;cACAF,WAAU,GAAI,YAAYD,IAAI,CAACG,OAAO,EAAC;;cAEvC;cACA,IAAIH,IAAI,CAACO,YAAY,EAAE;gBACrBN,WAAU,GAAID,IAAI,CAACO,YAAW;cAChC;;cAEA;cACA,IAAIP,IAAI,CAACM,KAAK,EAAE;gBACdJ,YAAW,GAAIG,UAAU,CAACL,IAAI,CAACM,KAAK;cACtC;YACF;YAEA,OAAO;cACL,GAAGN,IAAI;cACPO,YAAY,EAAEN,WAAW;cACzBK,KAAK,EAAEJ;YACT;UACF,CAAC;UAED,OAAO;YACL,GAAGR,KAAK;YACRc,aAAa,EAAEb,YAAY;YAC3BI,KAAK,EAAEA;UACT;QACF,CAAC;QAEDR,OAAO,CAACC,GAAG,CAAC,mBAAmB,EAAE,IAAI,CAACR,MAAM,GAAE;MAChD,EAAE,OAAOyB,KAAK,EAAE;QACdlB,OAAO,CAACkB,KAAK,CAAC,wBAAwB,EAAEA,KAAK;QAC7CC,KAAK,CAAC,0BAA0B;MAClC;IACF,CAAC;IAEDC,UAAUA,CAACC,UAAU,EAAE;MACrB,MAAMC,IAAG,GAAI,IAAIC,IAAI,CAACF,UAAU;MAChC,OAAO,IAAIG,IAAI,CAACC,cAAc,CAAC,OAAO,EAAE;QACtCC,IAAI,EAAE,SAAS;QACfC,KAAK,EAAE,OAAO;QACdC,GAAG,EAAE,SAAS;QACdC,IAAI,EAAE,SAAS;QACfC,MAAM,EAAE;MACV,CAAC,CAAC,CAACC,MAAM,CAACT,IAAI;IAChB,CAAC;IAEDU,gBAAgBA,CAAC7B,KAAK,EAAE;MACtB,IAAI,CAACT,aAAY,GAAIS,KAAI;MACzB,IAAI,CAACR,YAAY,CAACsC,IAAI,CAAC;IACzB,CAAC;IAEDC,YAAYA,CAAA,EAAG;MACb,MAAMC,aAAY,GAAIC,QAAQ,CAACC,aAAa,CAAC,oBAAoB,CAAC,CAACC,SAAQ;MAC3E,MAAMC,gBAAe,GAAIH,QAAQ,CAACI,IAAI,CAACF,SAAQ;MAE/CF,QAAQ,CAACI,IAAI,CAACF,SAAQ,GAAI;;cAEpBH,aAAa;;SAEnB;MAEAM,MAAM,CAACC,KAAK,CAAC;MACbN,QAAQ,CAACI,IAAI,CAACF,SAAQ,GAAIC,gBAAe;;MAEzC;MACA,IAAI,CAACI,SAAS,CAAC,MAAM;QACnB,IAAI,CAACC,eAAe,CAAC;MACvB,CAAC;IACH,CAAC;IAEDC,cAAcA,CAACrC,KAAK,EAAE;MACpB,OAAOA,KAAK,CAACsC,MAAM,CAAC,CAACC,GAAG,EAAEtC,IAAI,KAAKsC,GAAE,GAAKtC,IAAI,CAACM,KAAI,GAAIN,IAAI,CAACuC,QAAS,EAAE,CAAC;IAC1E,CAAC;IAEDJ,eAAeA,CAAA,EAAG;MAChB,MAAMK,YAAW,GAAIb,QAAQ,CAACc,cAAc,CAAC,cAAc;MAC3D,IAAID,YAAY,EAAE;QAChB,IAAI,CAACtD,YAAW,GAAI,IAAIJ,KAAK,CAAC0D,YAAY;MAC5C;IACF;EACF,CAAC;EACDE,OAAOA,CAAA,EAAG;IACR,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,QAAQ;IAC3C,MAAMC,OAAM,GAAIF,YAAY,CAACC,OAAO,CAAC,UAAU,MAAM,MAAK;IAC1D,IAAI,CAACF,KAAI,IAAK,CAACG,OAAO,EAAE;MACtBpC,KAAK,CAAC,8BAA8B;MACpC,IAAI,CAACqC,OAAO,CAACC,IAAI,CAAC,QAAQ;MAC1B;IACF;IAEA,IAAI,CAAC5D,cAAc,CAAC;IACpB,IAAI,CAAC8C,SAAS,CAAC,MAAM;MACnB,IAAI,CAACC,eAAe,CAAC;IACvB,CAAC;EACH;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}