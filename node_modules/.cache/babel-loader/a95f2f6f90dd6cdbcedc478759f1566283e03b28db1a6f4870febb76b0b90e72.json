pper\">\r\n                            <span class=\"input-icon\">\r\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" class=\"bi bi-person\" viewBox=\"0 0 16 16\">\r\n                    <path d=\"M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664z\"/>\r\n                  </svg>\r\n                </span>\r\n              <input \r\n                id=\"username\"\r\n                v-model=\"username\" \r\n                placeholder=\"Enter your username\" \r\n                class=\"form-input\" \r\n                autocomplete=\"username\"\r\n              />\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"form-group\">\r\n            <div class=\"password-header\">\r\n              <label for=\"password\">Password</label>\r\n            </div>\r\n            <div class=\"input-wrapper\">\r\n                            <span class=\"input-icon\">\r\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" class=\"bi bi-lock\" viewBox=\"0 0 16 16\">\r\n                    <path d=\"M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2M5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1\"/>\r\n                  </svg>\r\n                </span>\r\n              <input \r\n                id=\"password\"\r\n                v-model=\"password\" \r\n                type=\"password\" \r\n                placeholder=\"Enter your password\" \r\n                class=\"form-input\"\r\n                autocomplete=\"current-password\"\r\n              />\r\n            </div>\r\n          </div>\r\n          \r\n          <button type=\"submit\" class=\"login-button\">\r\n            <span class=\"button-text\">Sign In</span>\r\n            <span class=\"button-icon\">\r\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" class=\"bi bi-arrow-right\" viewBox=\"0 0 16 16\">\r\n                <path fill-rule=\"evenodd\" d=\"M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8\"/>\r\n              </svg>\r\n            </span>\r\n          </button>\r\n        </form>\r\n        \r\n        <div class=\"login-footer\">\r\n          <p>Don't have an account? <router-link to=\"/register\" class=\"register-link\">Create one</router-link></p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n    \r\n  <script>\r\n  import axios from '../axios'\r\n  import { auth } from '../auth'\r\n  import { ref } from 'vue'\r\n    \r\n  export default {\r\n    name: 'UserLogin',\r\n    setup() {\r\n      const username = ref('')\r\n      const password = ref('')\r\n      \r\n      const login = async () => {\r\n        if (!username.value || !password.value) {\r\n          alert('Please enter both username and password')\r\n          return\r\n        }\r\n        \r\n        try {\r\n          // Step 1: Get access and refresh tokens\r\n          const res = await axios.post('token/', {\r\n            username: username.value,\r\n            password: password.value\r\n          })\r\n          localStorage.setItem('access', res.data.access)\r\n          localStorage.setItem('refresh', res.data.refresh)\r\n          auth.isLoggedIn = true\r\n    \r\n          // Step 2: Get user info\r\n          const user = await axios.get('user/')\r\n          localStorage.setItem('is_staff', user.data.is_staff)\r\n          auth.isStaff = user.data.is_staff\r\n    \r\n          // Step 3: Redirect based on role\r\n          window.location.href = user.data.is_staff ? '/monitor' : '/products'\r\n        } catch (err) {\r\n          alert('Login failed: Check your username or password.')\r\n        }\r\n      }\r\n      \r\n      return {\r\n        username,\r\n        password,\r\n        login\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .login-container {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    min-height: calc(100vh - 70px);\r\n    padding: 2rem 1rem;\r\n    background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.4) 100%);\r\n  }\r\n  \r\n  .login-card {\r\n    width: 100%;\r\n    max-width: 420px;\r\n    padding: 2.5rem;\r\n    border-radius: 20px;\r\n    background-color: rgba(255, 255, 255, 0.85);\r\n    backdrop-filter: blur(10px);\r\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\r\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n  }\r\n  \r\n  .login-card:hover {\r\n    transform: translateY(-5px);\r\n    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);\r\n  }\r\n  \r\n  .login-header {\r\n    text-align: center;\r\n    margin-bottom: 2rem;\r\n  }\r\n  \r\n  .login-header h2 {\r\n    font-weight: 600;\r\n    color: #333;\r\n    margin-bottom: 0.5rem;\r\n    font-size: 1.8rem;\r\n  }\r\n  \r\n  .login-subtitle {\r\n    color: #777;\r\n    font-size: 0.95rem;\r\n  }\r\n  \r\n  .login-form {\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .form-group {\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .password-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 0.5rem;\r\n  }\r\n  \r\n  label {\r\n    display: block;\r\n    margin-bottom: 0.5rem;\r\n    font-weight: 500;\r\n    color: #555;\r\n    font-size: 0.95rem;\r\n  }\r\n  \r\n  .input-wrapper {\r\n    position: relative;\r\n    display: flex;\r\n    align-items: center;\r\n  }\r\n  \r\n  .input-icon {\r\n    position: absolute;\r\n    left: 15px;\r\n    color: #aaa;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  .form-input {\r\n    width: 100%;\r\n    padding: 12px 15px 12px 40px;\r\n    border: 1px solid #e1e1e1;\r\n    border-radius: 25px;\r\n    background-color: rgba(255, 255, 255, 0.8);\r\n    font-size: 0.95rem;\r\n    transition: all 0.3s ease;\r\n  }\r\n  \r\n  .form-input:focus {\r\n    outline: none;\r\n    border-color: #a5a5a5;\r\n    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);\r\n    background-color: #fff;\r\n  }\r\n  \r\n  .form-input::placeholder {\r\n    color: #aaa;\r\n  }\r\n  \r\n  .forgot-link {\r\n    font-size: 0.85rem;\r\n    color: #777;\r\n    text-decoration: none;\r\n    transition: color 0.2s ease;\r\n  }\r\n  \r\n  .forgot-link:hover {\r\n    color: #333;\r\n    text-decoration: underline;\r\n  }\r\n  \r\n  .login-button {\r\n    width: 100%;\r\n    padding: 12px;\r\n    border: none;\r\n    border-radius: 25px;\r\n    background: linear-gradient(135deg, #b2967d 0%, #d8c6a1 100%);\r\n    color: white;\r\n    font-weight: 500;\r\n    font-size: 1rem;\r\n    cursor: pointer;\r\n    transition: all 0.3s ease;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n  }\r\n  \r\n  .login-button:hover {\r\n    background: linear-gradient(135deg, #5d5abc 0%, #7d52c1 100%);\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 5px 15px rgba(253, 255, 232, 0.3);\r\n  }\r\n  \r\n  .button-text {\r\n    margin-right: 10px;\r\n  }\r\n  \r\n  .button-icon {\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .login-button:hover .button-icon {\r\n    transform: translateX(3px);\r\n  }\r\n  \r\n  .login-footer {\r\n    text-align: center;\r\n    color: #777;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  .register-link {\r\n    color: #f9f6f0;\r\n    font-weight: 500;\r\n    text-decoration: none;\r\n    transition: color 0.2s ease;\r\n  }\r\n  \r\n  .register-link:hover {\r\n    color: #f9f6f0;\r\n    text-decoration: underline;\r\n  }\r\n  \r\n  @media (max-width: 480px) {\r\n    .login-card {\r\n      padding: 2rem 1.5rem;\r\n    }\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAiB;;EACrBA,KAAK,EAAC;AAAY;;EAOdA,KAAK,EAAC;AAAY;;EAEhBA,KAAK,EAAC;AAAe;;EAgBvBA,KAAK,EAAC;AAAY;;EAIhBA,KAAK,EAAC;AAAe;;EA2BzBA,KAAK,EAAC;AAAc;;;uBAzD7BC,mBAAA,CA6DM,OA7DNC,UA6DM,GA5DJC,mBAAA,CA2DM,OA3DNC,UA2DM,G,4BA1DJD,mBAAA,CAGM;IAHDH,KAAK,EAAC;EAAc,IACvBG,mBAAA,CAAqB,YAAjB,cAAY,GAChBA,mBAAA,CAA+D;IAA5DH,KAAK,EAAC;EAAgB,GAAC,mCAAiC,E,sBAG7DG,mBAAA,CAgDO;IAhDAE,QAAM,EAAAC,MAAA,QAAAA,MAAA,MARrBC,cAAA,KAAAC,IAAA,KAQ+BC,MAAA,CAAAC,KAAA,IAAAD,MAAA,CAAAC,KAAA,IAAAF,IAAA,CAAK;IAAER,KAAK,EAAC;MAClCG,mBAAA,CAgBM,OAhBNQ,UAgBM,G,0BAfJR,mBAAA,CAAsC;IAA/BS,GAAG,EAAC;EAAU,GAAC,UAAQ,sBAC9BT,mBAAA,CAaM,OAbNU,UAaM,G,0BAZUV,mBAAA,CAIL;IAJWH,KAAK,EAAC;EAAY,IAClCG,mBAAA,CAEM;IAFDW,KAAK,EAAC,4BAA4B;IAACC,KAAK,EAAC,IAAI;IAACC,MAAM,EAAC,IAAI;IAACC,IAAI,EAAC,cAAc;IAACjB,KAAK,EAAC,cAAc;IAACkB,OAAO,EAAC;MAC9Gf,mBAAA,CAAuP;IAAjPgB,CAAC,EAAC;EAA6O,G,wCAG3PhB,mBAAA,CAME;IALAiB,EAAE,EAAC,UAAU;IAlB7B,uBAAAd,MAAA,QAAAA,MAAA,MAAAe,MAAA,IAmByBZ,MAAA,CAAAa,QAAQ,GAAAD,MAAA;IACjBE,WAAW,EAAC,qBAAqB;IACjCvB,KAAK,EAAC,YAAY;IAClBwB,YAAY,EAAC;iDAHJf,MAAA,CAAAa,QAAQ,E,OAQvBnB,mBAAA,CAmBM,OAnBNsB,UAmBM,G,0BAlBJtB,mBAAA,CAEM;IAFDH,KAAK,EAAC;EAAiB,IAC1BG,mBAAA,CAAsC;IAA/BS,GAAG,EAAC;EAAU,GAAC,UAAQ,E,sBAEhCT,mBAAA,CAcM,OAdNuB,UAcM,G,0BAbUvB,mBAAA,CAIL;IAJWH,KAAK,EAAC;EAAY,IAClCG,mBAAA,CAEM;IAFDW,KAAK,EAAC,4BAA4B;IAACC,KAAK,EAAC,IAAI;IAACC,MAAM,EAAC,IAAI;IAACC,IAAI,EAAC,cAAc;IAACjB,KAAK,EAAC,YAAY;IAACkB,OAAO,EAAC;MAC5Gf,mBAAA,CAA0M;IAApMgB,CAAC,EAAC;EAAgM,G,wCAG9MhB,mBAAA,CAOE;IANAiB,EAAE,EAAC,UAAU;IAtC7B,uBAAAd,MAAA,QAAAA,MAAA,MAAAe,MAAA,IAuCyBZ,MAAA,CAAAkB,QAAQ,GAAAN,MAAA;IACjBO,IAAI,EAAC,UAAU;IACfL,WAAW,EAAC,qBAAqB;IACjCvB,KAAK,EAAC,YAAY;IAClBwB,YAAY,EAAC;iDAJJf,MAAA,CAAAkB,QAAQ,E,iCAvCjCE,kBAAA,uiB,4BA0DQ1B,mBAAA,CAEM,OAFN2B,UAEM,GADJ3B,mBAAA,CAAwG,Y,0BA3DlH4B,gBAAA,CA2Da,yBAAuB,IAAAC,YAAA,CAA0EC,sBAAA;IAA7DC,EAAE,EAAC,WAAW;IAAClC,KAAK,EAAC;;IA3DtEmC,OAAA,EAAAC,QAAA,CA2DsF,MAAU9B,MAAA,QAAAA,MAAA,OA3DhGyB,gBAAA,CA2DsF,YAAU,E;IA3DhGM,CAAA","ignoreList":[]