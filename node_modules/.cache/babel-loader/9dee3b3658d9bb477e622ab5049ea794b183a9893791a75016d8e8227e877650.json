{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport axios from '../axios';\nexport default {\n  data() {\n    return {\n      cartItems: [],\n      isProcessing: false,\n      isLoading: true,\n      backendCartItems: [],\n      localStorageItems: []\n    };\n  },\n  computed: {\n    cartTotal() {\n      return this.cartItems.reduce((total, item) => {\n        return total + parseFloat(item.price) * item.quantity;\n      }, 0);\n    }\n  },\n  async mounted() {\n    // First, load from localStorage for instant display\n    this.loadLocalCart();\n\n    // Then try to fetch from backend\n    await this.fetchBackendCart();\n\n    // Finally, merge them\n    this.mergeLocalAndBackendCarts();\n  },\n  methods: {\n    formatPrice(price) {\n      return parseFloat(price).toLocaleString(undefined, {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      });\n    },\n    loadLocalCart() {\n      try {\n        const stored = localStorage.getItem('cart');\n        this.localStorageItems = stored ? JSON.parse(stored) : [];\n        this.cartItems = [...this.localStorageItems];\n      } catch (err) {\n        console.error('Error loading cart from localStorage:', err);\n        this.localStorageItems = [];\n        this.cartItems = [];\n      }\n    },\n    saveLocalCart() {\n      try {\n        localStorage.setItem('cart', JSON.stringify(this.localStorageItems));\n      } catch (err) {\n        console.error('Error saving cart to localStorage:', err);\n      }\n    },\n    async fetchBackendCart() {\n      this.isLoading = true;\n      try {\n        // Get current cart from backend\n        const response = await axios.get('cart/current/');\n        if (response.data && response.data.items) {\n          this.backendCartItems = response.data.items;\n          console.log(\"Backend cart items:\", this.backendCartItems);\n        } else {\n          this.backendCartItems = [];\n        }\n      } catch (err) {\n        console.error('Error fetching cart from backend:', err);\n        this.backendCartItems = [];\n      } finally {\n        this.isLoading = false;\n      }\n    },\n    mergeLocalAndBackendCarts() {\n      // Start with backend cart\n      const mergedCart = [...this.backendCartItems];\n\n      // Add items from localStorage that aren't in backend cart yet\n      for (const localItem of this.localStorageItems) {\n        // Ensure we have the expected properties\n        if (!localItem.product && localItem.id) {\n          localItem.product = localItem.id;\n        }\n\n        // Check if this item exists in the backend cart\n        const existingItem = mergedCart.find(item => item.product === localItem.product || item.id === localItem.id);\n        if (!existingItem) {\n          // If not in backend cart, add it to merged cart\n          mergedCart.push(localItem);\n        }\n      }\n      this.cartItems = mergedCart;\n      console.log(\"Merged cart:\", this.cartItems);\n    },\n    async increaseQuantity(item) {\n      const productId = item.product || item.id;\n      const localItem = this.localStorageItems.find(i => i.product === productId || i.id === productId);\n      if (localItem) {\n        localItem.quantity += 1;\n        this.saveLocalCart();\n      }\n\n      // Update the display item\n      item.quantity += 1;\n\n      // If this item is in the backend, update it there too\n      if (this.backendCartItems.some(i => i.product === productId || i.id === productId)) {\n        try {\n          await axios.post('order-items/', {\n            product: productId,\n            quantity: 1\n          });\n          // Refresh backend cart\n          await this.fetchBackendCart();\n          this.mergeLocalAndBackendCarts();\n        } catch (err) {\n          console.error('Error increasing quantity in backend:', err);\n          alert('Failed to update quantity. Please try again.');\n        }\n      }\n    },\n    async decreaseQuantity(item) {\n      if (item.quantity <= 1) {\n        return this.removeItem(item);\n      }\n      const productId = item.product || item.id;\n      const localItem = this.localStorageItems.find(i => i.product === productId || i.id === productId);\n      if (localItem) {\n        localItem.quantity -= 1;\n        this.saveLocalCart();\n      }\n\n      // Update the display item\n      item.quantity -= 1;\n\n      // If this item is in the backend, we would need a backend endpoint to decrease quantity\n      // For now, log a message that we'd need this functionality\n      console.log(\"Backend needs a decrease quantity endpoint\");\n    },\n    async removeItem(item) {\n      const productId = item.product || item.id;\n\n      // Remove from local storage\n      this.localStorageItems = this.localStorageItems.filter(i => i.product !== productId && i.id !== productId);\n      this.saveLocalCart();\n\n      // Remove from display\n      this.cartItems = this.cartItems.filter(i => i.product !== productId && i.id !== productId);\n\n      // If this item is in the backend, remove it there too\n      const backendItem = this.backendCartItems.find(i => i.product === productId || i.id === productId);\n      if (backendItem) {\n        try {\n          await axios.delete(`order-items/${backendItem.id}/`);\n          // Refresh backend cart\n          await this.fetchBackendCart();\n        } catch (err) {\n          console.error('Error removing item from backend:', err);\n          alert('Failed to remove item. Please try again.');\n        }\n      }\n    },\n    async clearCart() {\n      if (!confirm('Are you sure you want to clear your cart?')) {\n        return;\n      }\n\n      // Clear local storage\n      localStorage.removeItem('cart');\n      this.localStorageItems = [];\n\n      // Clear from display\n      this.cartItems = [];\n\n      // Clear backend cart if needed\n      if (this.backendCartItems.length > 0) {\n        try {\n          await axios.post('cart/clear/');\n          this.backendCartItems = [];\n        } catch (err) {\n          console.error('Error clearing backend cart:', err);\n          alert('Failed to clear cart on server. Please try again.');\n        }\n      }\n    },\n    async checkout() {\n      this.isProcessing = true;\n      try {\n        // First, ensure all local items are in the backend\n        for (const item of this.localStorageItems) {\n          const productId = item.product || item.id;\n          const backendItem = this.backendCartItems.find(i => i.product === productId || i.id === productId);\n          if (!backendItem) {\n            // Add to backend\n            await axios.post('order-items/', {\n              product: productId,\n              quantity: item.quantity\n            });\n          }\n        }\n\n        // Complete the order\n        await axios.put('orders/complete/');\n\n        // Clear local storage cart\n        localStorage.removeItem('cart');\n        this.localStorageItems = [];\n        this.cartItems = [];\n\n        // Show success message\n        alert('✅ Your order has been placed successfully! Thank you for your purchase.');\n\n        // Redirect to order history or homepage\n        // window.location.href = '/orders' // Uncomment if you have an orders page\n      } catch (err) {\n        console.error('Checkout error:', err);\n        if (err.response && err.response.data && err.response.data.detail) {\n          alert(`❌ ${err.response.data.detail}`);\n        } else {\n          alert('❌ Failed to complete checkout. Please try again.');\n        }\n      } finally {\n        this.isProcessing = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","cartItems","isProcessing","isLoading","backendCartItems","localStorageItems","computed","cartTotal","reduce","total","item","parseFloat","price","quantity","mounted","loadLocalCart","fetchBackendCart","mergeLocalAndBackendCarts","methods","formatPrice","toLocaleString","undefined","minimumFractionDigits","maximumFractionDigits","stored","localStorage","getItem","JSON","parse","err","console","error","saveLocalCart","setItem","stringify","response","get","items","log","mergedCart","localItem","product","id","existingItem","find","push","increaseQuantity","productId","i","some","post","alert","decreaseQuantity","removeItem","filter","backendItem","delete","clearCart","confirm","length","checkout","put","detail"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-3\">\r\n    <h2 class=\"mb-4 text-brown-dark\">My Shopping Cart</h2>\r\n    \r\n    <div v-if=\"isLoading\" class=\"text-center py-4\">\r\n      <div class=\"spinner-border text-brown-medium\" role=\"status\">\r\n        <span class=\"visually-hidden\">Loading...</span>\r\n      </div>\r\n    </div>\r\n    \r\n    <div v-else-if=\"!cartItems || cartItems.length === 0\" class=\"text-center py-5 bg-beige rounded\">\r\n      <i class=\"fas fa-shopping-cart fa-3x text-brown-light mb-3\"></i>\r\n      <h5 class=\"text-brown-medium\">Your cart is empty</h5>\r\n      <p class=\"text-brown-light\">Add items from our collection to start shopping</p>\r\n      <a href=\"/products\" class=\"btn btn-outline-brown mt-2\">Browse Products</a>\r\n    </div>\r\n    \r\n    <div v-else>\r\n      <div class=\"card shadow-sm mb-4\">\r\n        <div class=\"card-header bg-beige py-3\">\r\n          <h5 class=\"mb-0 text-brown-dark\">Cart Items ({{ cartItems.length }})</h5>\r\n        </div>\r\n        <ul class=\"list-group list-group-flush\">\r\n          <li v-for=\"item in cartItems\" :key=\"item.id\" class=\"list-group-item d-flex justify-content-between align-items-center py-3\">\r\n            <div class=\"d-flex align-items-center\">\r\n              <div class=\"me-3\">\r\n                <button @click=\"decreaseQuantity(item)\" class=\"btn btn-sm btn-outline-brown me-1\" :disabled=\"isProcessing\">\r\n                  <i class=\"fas fa-minus\"></i>\r\n                </button>\r\n                <span class=\"mx-2 text-brown-dark\">{{ item.quantity }}</span>\r\n                <button @click=\"increaseQuantity(item)\" class=\"btn btn-sm btn-outline-brown ms-1\" :disabled=\"isProcessing\">\r\n                  <i class=\"fas fa-plus\"></i>\r\n                </button>\r\n              </div>\r\n              <div>\r\n                <h6 class=\"mb-0 text-brown-dark\">{{ item.product_name || item.name }}</h6>\r\n                <small class=\"text-brown-light\">₱{{ formatPrice(item.price) }} each</small>\r\n              </div>\r\n            </div>\r\n            <div class=\"d-flex align-items-center\">\r\n              <span class=\"text-brown-dark me-3 fw-bold\">₱{{ formatPrice(item.price * item.quantity) }}</span>\r\n              <button @click=\"removeItem(item)\" class=\"btn btn-sm btn-outline-danger\" :disabled=\"isProcessing\">\r\n                <i class=\"fas fa-trash\"></i>\r\n              </button>\r\n            </div>\r\n          </li>\r\n        </ul>\r\n        <div class=\"card-footer bg-beige py-3\">\r\n          <div class=\"d-flex justify-content-between align-items-center\">\r\n            <h5 class=\"mb-0 text-brown-dark\">Total:</h5>\r\n            <h5 class=\"mb-0 text-brown-dark\">₱{{ formatPrice(cartTotal) }}</h5>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"d-flex justify-content-between\">\r\n        <button @click=\"clearCart\" class=\"btn btn-outline-brown\" :disabled=\"isProcessing\">\r\n          <i class=\"fas fa-trash me-2\"></i>\r\n          Clear Cart\r\n        </button>\r\n        <button @click=\"checkout\" class=\"btn btn-brown\" :disabled=\"isProcessing\">\r\n          <i class=\"fas fa-shopping-bag me-2\" v-if=\"!isProcessing\"></i>\r\n          <span v-if=\"isProcessing\" class=\"spinner-border spinner-border-sm me-2\" role=\"status\" aria-hidden=\"true\"></span>\r\n          {{ isProcessing ? 'Processing...' : 'Complete Purchase' }}\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      cartItems: [],\r\n      isProcessing: false,\r\n      isLoading: true,\r\n      backendCartItems: [],\r\n      localStorageItems: []\r\n    }\r\n  },\r\n  computed: {\r\n    cartTotal() {\r\n      return this.cartItems.reduce((total, item) => {\r\n        return total + (parseFloat(item.price) * item.quantity)\r\n      }, 0)\r\n    }\r\n  },\r\n  async mounted() {\r\n    // First, load from localStorage for instant display\r\n    this.loadLocalCart()\r\n    \r\n    // Then try to fetch from backend\r\n    await this.fetchBackendCart()\r\n    \r\n    // Finally, merge them\r\n    this.mergeLocalAndBackendCarts()\r\n  },\r\n  methods: {\r\n    formatPrice(price) {\r\n      return parseFloat(price).toLocaleString(undefined, {\r\n        minimumFractionDigits: 2,\r\n        maximumFractionDigits: 2\r\n      })\r\n    },\r\n    \r\n    loadLocalCart() {\r\n      try {\r\n        const stored = localStorage.getItem('cart')\r\n        this.localStorageItems = stored ? JSON.parse(stored) : []\r\n        this.cartItems = [...this.localStorageItems]\r\n      } catch (err) {\r\n        console.error('Error loading cart from localStorage:', err)\r\n        this.localStorageItems = []\r\n        this.cartItems = []\r\n      }\r\n    },\r\n    \r\n    saveLocalCart() {\r\n      try {\r\n        localStorage.setItem('cart', JSON.stringify(this.localStorageItems))\r\n      } catch (err) {\r\n        console.error('Error saving cart to localStorage:', err)\r\n      }\r\n    },\r\n    \r\n    async fetchBackendCart() {\r\n      this.isLoading = true\r\n      try {\r\n        // Get current cart from backend\r\n        const response = await axios.get('cart/current/')\r\n        \r\n        if (response.data && response.data.items) {\r\n          this.backendCartItems = response.data.items\r\n          console.log(\"Backend cart items:\", this.backendCartItems)\r\n        } else {\r\n          this.backendCartItems = []\r\n        }\r\n      } catch (err) {\r\n        console.error('Error fetching cart from backend:', err)\r\n        this.backendCartItems = []\r\n      } finally {\r\n        this.isLoading = false\r\n      }\r\n    },\r\n    \r\n    mergeLocalAndBackendCarts() {\r\n      // Start with backend cart\r\n      const mergedCart = [...this.backendCartItems]\r\n      \r\n      // Add items from localStorage that aren't in backend cart yet\r\n      for (const localItem of this.localStorageItems) {\r\n        // Ensure we have the expected properties\r\n        if (!localItem.product && localItem.id) {\r\n          localItem.product = localItem.id\r\n        }\r\n        \r\n        // Check if this item exists in the backend cart\r\n        const existingItem = mergedCart.find(item => \r\n          item.product === localItem.product || \r\n          item.id === localItem.id\r\n        )\r\n        \r\n        if (!existingItem) {\r\n          // If not in backend cart, add it to merged cart\r\n          mergedCart.push(localItem)\r\n        }\r\n      }\r\n      \r\n      this.cartItems = mergedCart\r\n      console.log(\"Merged cart:\", this.cartItems)\r\n    },\r\n    \r\n    async increaseQuantity(item) {\r\n      const productId = item.product || item.id\r\n      const localItem = this.localStorageItems.find(i => i.product === productId || i.id === productId)\r\n      \r\n      if (localItem) {\r\n        localItem.quantity += 1\r\n        this.saveLocalCart()\r\n      }\r\n      \r\n      // Update the display item\r\n      item.quantity += 1\r\n      \r\n      // If this item is in the backend, update it there too\r\n      if (this.backendCartItems.some(i => i.product === productId || i.id === productId)) {\r\n        try {\r\n          await axios.post('order-items/', {\r\n            product: productId,\r\n            quantity: 1\r\n          })\r\n          // Refresh backend cart\r\n          await this.fetchBackendCart()\r\n          this.mergeLocalAndBackendCarts()\r\n        } catch (err) {\r\n          console.error('Error increasing quantity in backend:', err)\r\n          alert('Failed to update quantity. Please try again.')\r\n        }\r\n      }\r\n    },\r\n    \r\n    async decreaseQuantity(item) {\r\n      if (item.quantity <= 1) {\r\n        return this.removeItem(item)\r\n      }\r\n      \r\n      const productId = item.product || item.id\r\n      const localItem = this.localStorageItems.find(i => i.product === productId || i.id === productId)\r\n      \r\n      if (localItem) {\r\n        localItem.quantity -= 1\r\n        this.saveLocalCart()\r\n      }\r\n      \r\n      // Update the display item\r\n      item.quantity -= 1\r\n      \r\n      // If this item is in the backend, we would need a backend endpoint to decrease quantity\r\n      // For now, log a message that we'd need this functionality\r\n      console.log(\"Backend needs a decrease quantity endpoint\")\r\n    },\r\n    \r\n    async removeItem(item) {\r\n      const productId = item.product || item.id\r\n      \r\n      // Remove from local storage\r\n      this.localStorageItems = this.localStorageItems.filter(\r\n        i => (i.product !== productId) && (i.id !== productId)\r\n      )\r\n      this.saveLocalCart()\r\n      \r\n      // Remove from display\r\n      this.cartItems = this.cartItems.filter(\r\n        i => (i.product !== productId) && (i.id !== productId)\r\n      )\r\n      \r\n      // If this item is in the backend, remove it there too\r\n      const backendItem = this.backendCartItems.find(i => i.product === productId || i.id === productId)\r\n      if (backendItem) {\r\n        try {\r\n          await axios.delete(`order-items/${backendItem.id}/`)\r\n          // Refresh backend cart\r\n          await this.fetchBackendCart()\r\n        } catch (err) {\r\n          console.error('Error removing item from backend:', err)\r\n          alert('Failed to remove item. Please try again.')\r\n        }\r\n      }\r\n    },\r\n    \r\n    async clearCart() {\r\n      if (!confirm('Are you sure you want to clear your cart?')) {\r\n        return\r\n      }\r\n      \r\n      // Clear local storage\r\n      localStorage.removeItem('cart')\r\n      this.localStorageItems = []\r\n      \r\n      // Clear from display\r\n      this.cartItems = []\r\n      \r\n      // Clear backend cart if needed\r\n      if (this.backendCartItems.length > 0) {\r\n        try {\r\n          await axios.post('cart/clear/')\r\n          this.backendCartItems = []\r\n        } catch (err) {\r\n          console.error('Error clearing backend cart:', err)\r\n          alert('Failed to clear cart on server. Please try again.')\r\n        }\r\n      }\r\n    },\r\n    \r\n    async checkout() {\r\n      this.isProcessing = true\r\n      try {\r\n        // First, ensure all local items are in the backend\r\n        for (const item of this.localStorageItems) {\r\n          const productId = item.product || item.id\r\n          const backendItem = this.backendCartItems.find(\r\n            i => i.product === productId || i.id === productId\r\n          )\r\n          \r\n          if (!backendItem) {\r\n            // Add to backend\r\n            await axios.post('order-items/', {\r\n              product: productId,\r\n              quantity: item.quantity\r\n            })\r\n          }\r\n        }\r\n        \r\n        // Complete the order\r\n        await axios.put('orders/complete/')\r\n        \r\n        // Clear local storage cart\r\n        localStorage.removeItem('cart')\r\n        this.localStorageItems = []\r\n        this.cartItems = []\r\n        \r\n        // Show success message\r\n        alert('✅ Your order has been placed successfully! Thank you for your purchase.')\r\n        \r\n        // Redirect to order history or homepage\r\n        // window.location.href = '/orders' // Uncomment if you have an orders page\r\n      } catch (err) {\r\n        console.error('Checkout error:', err)\r\n        if (err.response && err.response.data && err.response.data.detail) {\r\n          alert(`❌ ${err.response.data.detail}`)\r\n        } else {\r\n          alert('❌ Failed to complete checkout. Please try again.')\r\n        }\r\n      } finally {\r\n        this.isProcessing = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Brown Neutral Color Palette */\r\n:root {\r\n  --brown-dark: #5D4037;\r\n  --brown-medium: #7D5A50;\r\n  --brown-light: #A98274;\r\n  --beige: #F5F5DC;\r\n  --cream: #FFFBEB;\r\n  --accent: #8D6E63;\r\n  --neutral-dark: #4E342E;\r\n  --neutral-light: #D7CCC8;\r\n}\r\n\r\n.text-brown-dark {\r\n  color: var(--brown-dark);\r\n}\r\n\r\n.text-brown-medium {\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-brown-light {\r\n  color: var(--brown-light);\r\n}\r\n\r\n.bg-beige {\r\n  background-color: var(--beige);\r\n}\r\n\r\n.btn-brown {\r\n  background-color: var(--brown-medium);\r\n  color: white;\r\n  border: none;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.btn-brown:hover:not(:disabled) {\r\n  background-color: var(--brown-dark);\r\n}\r\n\r\n.btn-outline-brown {\r\n  color: var(--brown-medium);\r\n  border-color: var(--brown-medium);\r\n  background-color: transparent;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.btn-outline-brown:hover:not(:disabled) {\r\n  background-color: var(--brown-medium);\r\n  color: rgb(0, 0, 0);\r\n}\r\n\r\n.card {\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n}\r\n\r\n.list-group-item {\r\n  border-left: none;\r\n  border-right: none;\r\n}\r\n</style>"],"mappings