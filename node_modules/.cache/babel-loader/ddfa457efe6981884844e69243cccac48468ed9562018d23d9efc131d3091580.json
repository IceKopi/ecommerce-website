{"ast":null,"code":"import axios from '../axios';\nexport default {\n  data() {\n    return {\n      cart: [],\n      isProcessing: false\n    };\n  },\n  mounted() {\n    const stored = localStorage.getItem('cart');\n    this.cart = stored ? JSON.parse(stored) : [];\n  },\n  methods: {\n    async checkout() {\n      this.isProcessing = true;\n      try {\n        // Step 1: Create the order\n        const orderResponse = await axios.post('orders/', {}); // or pass customer if needed\n        const orderId = orderResponse.data.id;\n\n        // Step 2: Create order items\n        for (const item of this.cart) {\n          await axios.post('order-items/', {\n            order: orderId,\n            product: item.id,\n            quantity: item.quantity\n          });\n        }\n\n        // Step 3: Mark the order as complete\n        await axios.put(`orders/${orderId}/complete/`);\n        alert('✅ Order placed successfully!');\n        localStorage.removeItem('cart');\n        this.cart = [];\n      } catch (err) {\n        console.error(err);\n        alert('❌ Failed to complete checkout. Please try again.');\n      } finally {\n        this.isProcessing = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","cart","isProcessing","mounted","stored","localStorage","getItem","JSON","parse","methods","checkout","orderResponse","post","orderId","id","item","order","product","quantity","put","alert","removeItem","err","console","error"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-3\">\r\n      <h2>My Cart</h2>\r\n      <div v-if=\"!cart || cart.length === 0\">Cart is empty.</div>\r\n      <ul class=\"list-group mb-3\" v-else>\r\n        <li\r\n          v-for=\"item in cart\"\r\n          :key=\"item.id\"\r\n          class=\"list-group-item d-flex justify-content-between\"\r\n        >\r\n          {{ item.name }} x {{ item.quantity }}\r\n          <span>₱{{ item.price * item.quantity }}</span>\r\n        </li>\r\n      </ul>\r\n      <button\r\n        @click=\"checkout\"\r\n        class=\"btn btn-success\"\r\n        :disabled=\"!cart || cart.length === 0 || isProcessing\"\r\n      >\r\n        {{ isProcessing ? 'Processing...' : 'Checkout' }}\r\n      </button>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        cart: [],\r\n        isProcessing: false\r\n      }\r\n    },\r\n    mounted() {\r\n      const stored = localStorage.getItem('cart')\r\n      this.cart = stored ? JSON.parse(stored) : []\r\n    },\r\n    methods: {\r\n      async checkout() {\r\n  this.isProcessing = true\r\n  try {\r\n    // Step 1: Create the order\r\n    const orderResponse = await axios.post('orders/', {}) // or pass customer if needed\r\n    const orderId = orderResponse.data.id\r\n\r\n    // Step 2: Create order items\r\n    for (const item of this.cart) {\r\n      await axios.post('order-items/', {\r\n        order: orderId,\r\n        product: item.id,\r\n        quantity: item.quantity\r\n      })\r\n    }\r\n\r\n    // Step 3: Mark the order as complete\r\n    await axios.put(`orders/${orderId}/complete/`)\r\n\r\n    alert('✅ Order placed successfully!')\r\n    localStorage.removeItem('cart')\r\n    this.cart = []\r\n  } catch (err) {\r\n    console.error(err)\r\n    alert('❌ Failed to complete checkout. Please try again.')\r\n  } finally {\r\n    this.isProcessing = false\r\n  }\r\n}\r\n    }\r\n  }\r\n  </script>\r\n  "],"mappings":"AAyBE,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,EAAE;MACRC,YAAY,EAAE;IAChB;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;IAC1C,IAAI,CAACL,IAAG,GAAIG,MAAK,GAAIG,IAAI,CAACC,KAAK,CAACJ,MAAM,IAAI,EAAC;EAC7C,CAAC;EACDK,OAAO,EAAE;IACP,MAAMC,QAAQA,CAAA,EAAG;MACrB,IAAI,CAACR,YAAW,GAAI,IAAG;