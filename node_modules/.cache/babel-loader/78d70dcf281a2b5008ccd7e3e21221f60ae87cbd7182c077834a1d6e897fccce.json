{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from '../axios';\nexport default {\n  data() {\n    return {\n      product: {\n        name: '',\n        description: '',\n        price: 0,\n        stock: 0\n      },\n      image: null,\n      imagePreview: null\n    };\n  },\n  methods: {\n    handleImage(e) {\n      this.image = e.target.files[0];\n      if (this.image) {\n        const reader = new FileReader();\n        reader.onload = e => {\n          this.imagePreview = e.target.result;\n        };\n        reader.readAsDataURL(this.image);\n      }\n    },\n    removeImage() {\n      this.image = null;\n      this.imagePreview = null;\n      document.getElementById('fileInput').value = '';\n    },\n    async submitProduct() {\n      const formData = new FormData();\n      for (let key in this.product) {\n        formData.append(key, this.product[key]);\n      }\n      if (this.image) formData.append('image', this.image);\n      try {\n        await axios.post('products/', formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        alert('✅ Product added successfully.');\n        this.$router.push('/monitor-products');\n      } catch (err) {\n        alert('❌ Failed to add product.');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","product","name","description","price","stock","image","imagePreview","methods","handleImage","e","target","files","reader","FileReader","onload","result","readAsDataURL","removeImage","document","getElementById","value","submitProduct","formData","FormData","key","append","post","headers","alert","$router","push","err"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\AddProduct.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-5\">\r\n    <div class=\"row justify-content-center\">\r\n      <div class=\"col-md-8\">\r\n        <div class=\"card shadow-sm border-0\">\r\n          <div class=\"card-header bg-gradient py-3\" style=\"background: linear-gradient(to right, #8B7355, #A67D5D);\">\r\n            <h3 class=\"text-white mb-0 fw-semibold\">\r\n              <i class=\"bi bi-plus-circle me-2\"></i>Add New Product\r\n            </h3>\r\n          </div>\r\n          <div class=\"card-body p-4\" style=\"background-color: #FAF8F6;\">\r\n            <form @submit.prevent=\"submitProduct\" enctype=\"multipart/form-data\">\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label text-brown fw-medium\">\r\n                  <i class=\"bi bi-tag-fill me-2\"></i>Product Name\r\n                </label>\r\n                <input \r\n                  v-model=\"product.name\" \r\n                  class=\"form-control form-control-lg border-brown\" \r\n                  placeholder=\"Enter product name\" \r\n                  required \r\n                />\r\n              </div>\r\n              \r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label text-brown fw-medium\">\r\n                  <i class=\"bi bi-card-text me-2\"></i>Description\r\n                </label>\r\n                <textarea \r\n                  v-model=\"product.description\" \r\n                  class=\"form-control border-brown\" \r\n                  placeholder=\"Enter product description\" \r\n                  rows=\"3\" \r\n                  required\r\n                ></textarea>\r\n              </div>\r\n              \r\n              <div class=\"row mb-3\">\r\n                <div class=\"col-md-6\">\r\n                  <label class=\"form-label text-brown fw-medium\">\r\n                    <i class=\"bi bi-currency-dollar me-2\"></i>Price\r\n                  </label>\r\n                  <div class=\"input-group\">\r\n                    <span class=\"input-group-text bg-brown text-white border-brown\">$</span>\r\n                    <input \r\n                      type=\"number\" \r\n                      v-model.number=\"product.price\" \r\n                      class=\"form-control border-brown\" \r\n                      placeholder=\"0.00\" \r\n                      min=\"0\" \r\n                      step=\"0.01\" \r\n                      required \r\n                    />\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"col-md-6\">\r\n                  <label class=\"form-label text-brown fw-medium\">\r\n                    <i class=\"bi bi-box-seam me-2\"></i>Stock\r\n                  </label>\r\n                  <input \r\n                    type=\"number\" \r\n                    v-model.number=\"product.stock\" \r\n                    class=\"form-control border-brown\" \r\n                    placeholder=\"Quantity available\" \r\n                    min=\"0\" \r\n                    required \r\n                  />\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"mb-4\">\r\n                <label class=\"form-label text-brown fw-medium\">\r\n                  <i class=\"bi bi-image me-2\"></i>Product Image\r\n                </label>\r\n                <div class=\"image-upload-container p-3 text-center border border-2 border-dashed rounded\" \r\n                     style=\"border-color: #A67D5D; background-color: #F5F2EE;\">\r\n                  <template v-if=\"imagePreview\">\r\n                    <div class=\"position-relative mb-3\">\r\n                      <img :src=\"imagePreview\" class=\"img-preview img-fluid rounded\" alt=\"Product preview\" />\r\n                      <button type=\"button\" @click=\"removeImage\" class=\"btn btn-sm btn-danger position-absolute top-0 end-0 rounded-circle\">\r\n                        <i class=\"bi bi-x\"></i>\r\n                      </button>\r\n                    </div>\r\n                  </template>\r\n                  <template v-else>\r\n                    <i class=\"bi bi-cloud-arrow-up display-4 text-brown-light mb-3\"></i>\r\n                    <p class=\"text-muted\">Drag and drop your image here or click to browse</p>\r\n                  </template>\r\n                  <input \r\n                    type=\"file\" \r\n                    id=\"fileInput\" \r\n                    @change=\"handleImage\" \r\n                    class=\"form-control border-brown mt-2\" \r\n                    accept=\"image/*\" \r\n                  />\r\n                </div>\r\n              </div>\r\n              \r\n              <button type=\"submit\" class=\"btn btn-lg w-100 text-white fw-medium\" style=\"background-color: #8B7355;\">\r\n                <i class=\"bi bi-plus-circle me-2\"></i>Add Product\r\n              </button>\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      product: { name: '', description: '', price: 0, stock: 0 },\r\n      image: null,\r\n      imagePreview: null\r\n    }\r\n  },\r\n  methods: {\r\n    handleImage(e) {\r\n      this.image = e.target.files[0]\r\n      if (this.image) {\r\n        const reader = new FileReader()\r\n        reader.onload = (e) => {\r\n          this.imagePreview = e.target.result\r\n        }\r\n        reader.readAsDataURL(this.image)\r\n      }\r\n    },\r\n    removeImage() {\r\n      this.image = null\r\n      this.imagePreview = null\r\n      document.getElementById('fileInput').value = ''\r\n    },\r\n    async submitProduct() {\r\n      const formData = new FormData()\r\n      for (let key in this.product) {\r\n        formData.append(key, this.product[key])\r\n      }\r\n      if (this.image) formData.append('image', this.image)\r\n\r\n      try {\r\n        await axios.post('products/', formData, {\r\n          headers: { 'Content-Type': 'multipart/form-data' }\r\n        })\r\n        alert('✅ Product added successfully.')\r\n        this.$router.push('/monitor-products')\r\n      } catch (err) {\r\n        alert('❌ Failed to add product.')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.text-brown {\r\n  color: #8B7355;\r\n}\r\n\r\n.text-brown-light {\r\n  color: #A67D5D;\r\n}\r\n\r\n.border-brown {\r\n  border-color: #D2BCA4 !important;\r\n}\r\n\r\n.bg-brown {\r\n  background-color: #8B7355;\r\n}\r\n\r\n.form-control:focus {\r\n  border-color: #A67D5D;\r\n  box-shadow: 0 0 0 0.25rem rgba(166, 125, 93, 0.25);\r\n}\r\n\r\n.img-preview {\r\n  max-height: 200px;\r\n  object-fit: contain;\r\n}\r\n\r\n/* Additional animations */\r\n.btn {\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.btn:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\r\n  background-color: #A67D5D !important;\r\n}\r\n\r\n</style>"],"mappings":";AA+GA,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;QAAEC,IAAI,EAAE,EAAE;QAAEC,WAAW,EAAE,EAAE;QAAEC,KAAK,EAAE,CAAC;QAAEC,KAAK,EAAE;MAAE,CAAC;MAC1DC,KAAK,EAAE,IAAI;MACXC,YAAY,EAAE;IAChB;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAACC,CAAC,EAAE;MACb,IAAI,CAACJ,KAAI,GAAII,CAAC,CAACC,MAAM,CAACC,KAAK,CAAC,CAAC;MAC7B,IAAI,IAAI,CAACN,KAAK,EAAE;QACd,MAAMO,MAAK,GAAI,IAAIC,UAAU,CAAC;QAC9BD,MAAM,CAACE,MAAK,GAAKL,CAAC,IAAK;UACrB,IAAI,CAACH,YAAW,GAAIG,CAAC,CAACC,MAAM,CAACK,MAAK;QACpC;QACAH,MAAM,CAACI,aAAa,CAAC,IAAI,CAACX,KAAK;MACjC;IACF,CAAC;IACDY,WAAWA,CAAA,EAAG;MACZ,IAAI,CAACZ,KAAI,GAAI,IAAG;MAChB,IAAI,CAACC,YAAW,GAAI,IAAG;MACvBY,QAAQ,CAACC,cAAc,CAAC,WAAW,CAAC,CAACC,KAAI,GAAI,EAAC;IAChD,CAAC;IACD,MAAMC,aAAaA,CAAA,EAAG;MACpB,MAAMC,QAAO,GAAI,IAAIC,QAAQ,CAAC;MAC9B,KAAK,IAAIC,GAAE,IAAK,IAAI,CAACxB,OAAO,EAAE;QAC5BsB,QAAQ,CAACG,MAAM,CAACD,GAAG,EAAE,IAAI,CAACxB,OAAO,CAACwB,GAAG,CAAC;MACxC;MACA,IAAI,IAAI,CAACnB,KAAK,EAAEiB,QAAQ,CAACG,MAAM,CAAC,OAAO,EAAE,IAAI,CAACpB,KAAK;MAEnD,IAAI;QACF,MAAMP,KAAK,CAAC4B,IAAI,CAAC,WAAW,EAAEJ,QAAQ,EAAE;UACtCK,OAAO,EAAE;YAAE,cAAc,EAAE;