{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { auth } from './auth';\nimport { ref } from 'vue';\nexport default {\n  setup() {\n    const searchQuery = ref('');\n    return {\n      auth,\n      searchQuery\n    };\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart');\n      localStorage.clear();\n      localStorage.setItem('cart', cart);\n      auth.isLoggedIn = false;\n      auth.isStaff = false;\n      this.$router.push('/login');\n    },\n    handleSearch() {\n      // Navigate to products page with search query\n      this.$router.push({\n        path: '/products',\n        query: {\n          search: this.searchQuery\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["auth","ref","setup","searchQuery","methods","logout","cart","localStorage","getItem","clear","setItem","isLoggedIn","isStaff","$router","push","handleSearch","path","query","search"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <nav class=\"navbar navbar-expand-lg px-4 py-3\">\n    <router-link\n      class=\"navbar-brand fw-bold d-flex align-items-center\"\n      :to=\"auth.isLoggedIn ? (auth.isStaff ? '/monitor' : '/products') : '/'\"\n    >\n      <img src=\"@/assets/logo.png\" alt=\"Maisanova Logo\" class=\"me-2\" height=\"30\" onerror=\"this.onerror=null; this.src='https://via.placeholder.com/30'; this.style.opacity=0.7;\">\n      <span class=\"brand-name\">Maisanova</span>\n    </router-link>\n    \n    <button \n      class=\"navbar-toggler\" \n      type=\"button\" \n      data-bs-toggle=\"collapse\" \n      data-bs-target=\"#navbarContent\"\n      aria-controls=\"navbarContent\" \n      aria-expanded=\"false\" \n      aria-label=\"Toggle navigation\"\n    >\n      <span class=\"navbar-toggler-icon\"></span>\n    </button>\n\n    <div class=\"collapse navbar-collapse\" id=\"navbarContent\">\n      <ul class=\"navbar-nav mx-auto mb-2 mb-lg-0\">\n        <!-- STAFF NAVIGATION -->\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/monitor-products\">Products</router-link>\n        </li>\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/add-product\">Add Product</router-link>\n        </li>\n\n        <!-- CUSTOMER NAVIGATION -->\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/products\">Collections</router-link>\n        </li>\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/cart\">Cart</router-link>\n        </li>\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/orders\">Orders</router-link>\n        </li>\n        \n        <!-- NON-LOGGED IN NAVIGATION -->\n        <li class=\"nav-item\" v-if=\"!auth.isLoggedIn\">\n          <router-link class=\"nav-link\" to=\"/products\">Collections</router-link>\n        </li>\n      </ul>\n\n      <!-- SEARCH BAR -->\n      <form class=\"d-flex me-3\" @submit.prevent=\"handleSearch\">\n        <div class=\"search-container\">\n          <input \n            class=\"search-input\" \n            type=\"search\" \n            placeholder=\"Search...\" \n            aria-label=\"Search\"\n            v-model=\"searchQuery\"\n          >\n          <button class=\"search-button\" type=\"submit\">\n            <i class=\"bi bi-search search-icon\"></i>\n          </button>\n        </div>\n      </form>\n\n      <ul class=\"navbar-nav ms-auto\">\n        <!-- Show Login/Register if LOGGED OUT -->\n        <template v-if=\"!auth.isLoggedIn\">\n          <li class=\"nav-item\">\n            <router-link class=\"nav-link\" to=\"/login\">Login</router-link>\n          </li>\n          <li class=\"nav-item\">\n            <router-link class=\"nav-link nav-link-register\" to=\"/register\">Register</router-link>\n          </li>\n        </template>\n\n        <!-- Show Logout if LOGGED IN -->\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn\">\n          <button class=\"btn btn-sm btn-outline-dark logout-btn\" @click=\"logout\">Logout</button>\n        </li>\n      </ul>\n    </div>\n  </nav>\n\n  <router-view />\n</template>\n\n<script>\nimport { auth } from './auth'\nimport { ref } from 'vue'\n\nexport default {\n  setup() {\n    const searchQuery = ref('')\n    \n    return { \n      auth,\n      searchQuery\n    }\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart')\n      localStorage.clear()\n      localStorage.setItem('cart', cart)\n\n      auth.isLoggedIn = false\n      auth.isStaff = false\n\n      this.$router.push('/login')\n    },\n    handleSearch() {\n      // Navigate to products page with search query\n      this.$router.push({\n        path: '/products',\n        query: { search: this.searchQuery }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap');\n@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\");\n\n.navbar {\n  background-color: rgba(249, 246, 240, 0.85);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border-bottom: 1px solid rgba(212, 201, 190, 0.3);\n  box-shadow: 0 2px 15px rgba(0, 0, 0, 0.02);\n  font-family: 'Montserrat', sans-serif;\n}\n\n.navbar-brand {\n  letter-spacing: 1px;\n}\n\n.brand-name {\n  font-family: 'Playfair Display', serif;\n  font-weight: 500;\n  letter-spacing: 1.5px;\n  color: #2c2a29;\n}\n\n.nav-link {\n  color: #2c2a29;\n  font-weight: 400;\n  letter-spacing: 0.8px;\n  text-transform: uppercase;\n  font-size: 0.85rem;\n  padding: 0.5rem 1.25rem;\n  transition: all 0.3s ease;\n}\n\n.nav-link:hover {\n  color: #8a7c6d;\n}\n\n.router-link-active {\n  color: #8a7c6d;\n  font-weight: 500;\n  position: relative;\n}\n\n.router-link-active::after {\n  content: '';\n  position: absolute;\n  bottom: -2px;\n  left: 1.25rem;\n  right: 1.25rem;\n  height: 1px;\n  background-color: #d4c9be;\n}\n\n.nav-link-register {\n  color: #8a7c6d;\n  font-weight: 500;\n}\n\n/* Search Bar Styling */\n.search-container {\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n\n.search-input {\n  border: 1px solid #d4c9be;\n  border-radius: 0;\n  padding: 7px 35px 7px 15px;\n  font-size: 0.85rem;\n  font-family: 'Montserrat', sans-serif;\n  background-color: rgba(255, 255, 255, 0.6);\n  transition: all 0.3s ease;\n  width: 170px;\n  letter-spacing: 0.5px;\n}\n\n.search-input:focus {\n  outline: none;\n  background-color: rgba(255, 255, 255, 0.9);\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);\n  width: 200px;\n  border-color: #8a7c6d;\n}\n\n.search-input::placeholder {\n  color: #8a7c6d;\n  opacity: 0.7;\n}\n\n.search-button {\n  position: absolute;\n  right: 0;\n  top: 0;\n  height: 100%;\n  background: none;\n  border: none;\n  cursor: pointer;\n  padding: 0 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.search-icon {\n  font-size: 0.85rem;\n  color: #8a7c6d;\n  transition: color 0.2s ease;\n}\n\n.search-button:hover .search-icon {\n  color: #2c2a29;\n}\n\n.logout-btn {\n  border: 1px solid #8a7c6d;\n  border-radius: 0;\n  color: #2c2a29;\n  letter-spacing: 0.8px;\n  text-transform: uppercase;\n  font-size: 0.75rem;\n  padding: 0.4rem 1rem;\n  transition: all 0.3s ease;\n}\n\n.logout-btn:hover {\n  background-color: #8a7c6d;\n  color: #fff;\n  border-color: #8a7c6d;\n}\n</style>"],"mappings":";AAwFA,SAASA,IAAG,QAAS,QAAO;AAC5B,SAASC,GAAE,QAAS,KAAI;AAExB,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,WAAU,GAAIF,GAAG,CAAC,EAAE;IAE1B,OAAO;MACLD,IAAI;MAC