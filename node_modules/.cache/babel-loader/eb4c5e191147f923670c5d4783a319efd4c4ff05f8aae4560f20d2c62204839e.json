ommentVNode","_createElementVNode","_hoisted_2","_hoisted_3","_hoisted_4","_hoisted_5","_hoisted_6","_cache","$event","$data","searchQuery","type","placeholder","onClick","args","$options","logout","_createTextVNode","filteredProducts","length","_hoisted_7","_hoisted_8","_Fragment","_renderList","product","id","_hoisted_9","_hoisted_10","image","src","alt","_hoisted_11","_hoisted_12","stock","_hoisted_13","_hoisted_14","_hoisted_15","_toDisplayString","name","_hoisted_16","description","_hoisted_17","_hoisted_18","_hoisted_19","price","toLocaleString","_normalizeClass","hasReachedLimit","addToCart","disabled","buttonText","_hoisted_20"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ProductList.vue"],"sourcesContent":["<template>\r\n  <div class=\"container py-5 main-container\">\r\n    <!-- Header Section -->\r\n    <div class=\"row mb-5\">\r\n      <div class=\"col-12\">\r\n        <div class=\"d-flex justify-content-between align-items-center w-100\">\r\n          <h2 class=\"font-weight-bold text-brown mb-0\">Maisanova Collection</h2>\r\n\r\n          <div class=\"d-flex align-items-center gap-3\">\r\n            <div class=\"search-container position-relative me-3\">\r\n              <input\r\n                v-model=\"searchQuery\"\r\n                type=\"text\"\r\n                class=\"form-control search-input pl-4 pr-5 rounded-pill border-0 shadow-sm\"\r\n                placeholder=\"Search our collection...\"\r\n              />\r\n              <span class=\"position-absolute search-icon\">\r\n                <i class=\"fas fa-search text-brown-light\"></i>\r\n              </span>\r\n            </div>\r\n\r\n            <button class=\"btn btn-outline-danger btn-sm\" @click=\"logout\">\r\n              <i class=\"fas fa-sign-out-alt me-1\"></i> Logout\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Product Grid -->\r\n    <div v-if=\"filteredProducts.length === 0\" class=\"text-center py-5\">\r\n      <p class=\"text-brown-light\">No products match your search criteria.</p>\r\n    </div>\r\n\r\n    <div class=\"row\">\r\n      <div v-for=\"product in filteredProducts\" :key=\"product.id\" class=\"col-md-4 mb-4\">\r\n        <div class=\"card product-card h-100 border-0 shadow-sm\">\r\n          <div class=\"product-image-container\">\r\n            <img\r\n              v-if=\"product.image\"\r\n              :src=\"product.image\"\r\n              class=\"card-img-top product-image-list\"\r\n              alt=\"Product\"\r\n            />\r\n            <div v-else class=\"no-image-placeholder\">\r\n              <i class=\"fas fa-image text-brown-light\"></i>\r\n            </div>\r\n            <div v-if=\"product.stock === 0\" class=\"out-of-stock-badge\">\r\n              Out of Stock\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"card-body d-flex flex-column bg-beige\">\r\n            <h5 class=\"card-title font-weight-bold text-brown-dark\">{{ product.name }}</h5>\r\n            <p class=\"card-text text-brown-medium product-description\">{{ product.description }}</p>\r\n            <div class=\"mt-auto\">\r\n              <div class=\"d-flex justify-content-between align-items-center mb-3\">\r\n                <span class=\"product-price text-brown-dark\">₱{{ product.price.toLocaleString() }}</span>\r\n                <span class=\"stock-indicator\" :class=\"{'text-accent': product.stock < 5 && product.stock > 0}\">\r\n                  {{ product.stock > 0 ? `${product.stock} in stock` : '' }}\r\n                </span>\r\n              </div>\r\n              <button\r\n                class=\"btn btn-add-to-cart-list w-100 text-brown border-1 shadow-sm\"\r\n                @click=\"addToCart(product)\"\r\n                :disabled=\"product.stock === 0 || hasReachedLimit(product)\"\r\n                :class=\"{'btn-brown-light': product.stock === 0 || hasReachedLimit(product)}\"\r\n              >\r\n                <i class=\"fas fa-shopping-cart mr-2\"></i>\r\n                {{ buttonText(product) }}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      searchQuery: '',\r\n      cart: [],\r\n      products: [\r\n        {\r\n          id: 1,\r\n          name: 'Handwoven Basket',\r\n          description: 'Eco-friendly and durable basket for home use.',\r\n          price: 499,\r\n          stock: 5,\r\n          image: 'https://via.placeholder.com/300x200?text=Basket'\r\n        },\r\n        {\r\n          id: 2,\r\n          name: 'Wooden Spoon Set',\r\n          description: 'A set of 5 handcrafted wooden spoons.',\r\n          price: 299,\r\n          stock: 2,\r\n          image: 'https://via.placeholder.com/300x200?text=Spoon+Set'\r\n        },\r\n        {\r\n          id: 3,\r\n          name: 'Canvas Tote Bag',\r\n          description: 'Stylish and reusable tote bag made of cotton.',\r\n          price: 350,\r\n          stock: 0,\r\n          image: 'https://via.placeholder.com/300x200?text=Tote+Bag'\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    filteredProducts() {\r\n      const q = this.searchQuery.toLowerCase()\r\n      return this.products.filter(p =>\r\n        p.name.toLowerCase().includes(q) ||\r\n        p.description.toLowerCase().includes(q)\r\n      )\r\n    }\r\n  },\r\n  methods: {\r\n    buttonText(product) {\r\n      if (product.stock === 0) return 'Out of Stock'\r\n      if (this.hasReachedLimit(product)) return 'Max Quantity Reached'\r\n      return 'Add to Cart'\r\n    },\r\n    loadCart() {\r\n      try {\r\n        const stored = localStorage.getItem('cart')\r\n        this.cart = stored ? JSON.parse(stored) : []\r\n      } catch (err) {\r\n        console.error('Error loading cart:', err)\r\n        this.cart = []\r\n      }\r\n    },\r\n    saveCart() {\r\n      localStorage.setItem('cart', JSON.stringify(this.cart))\r\n      console.log('Cart updated:', this.cart)\r\n    },\r\n    addToCart(product) {\r\n      const cartItem = {\r\n        id: product.id,\r\n        product: product.id,\r\n        product_name: product.name,\r\n        price: product.price,\r\n        quantity: 1\r\n      }\r\n\r\n      const existing = this.cart.find(item => item.product === product.id)\r\n\r\n      if (existing) {\r\n        if (existing.quantity < product.stock) {\r\n          existing.quantity++\r\n        } else {\r\n          alert(\"You've reached the maximum available quantity for this item.\")\r\n          return\r\n        }\r\n      } else {\r\n        if (product.stock === 0) {\r\n          alert('This item is out of stock.')\r\n          return\r\n        }\r\n        this.cart.push(cartItem)\r\n      }\r\n\r\n      this.saveCart()\r\n      alert(`${product.name} added to cart.`)\r\n    },\r\n    hasReachedLimit(product) {\r\n      const item = this.cart.find(c => c.product === product.id)\r\n      return item ? item.quantity >= product.stock : false\r\n    },\r\n    logout() {\r\n      localStorage.clear()\r\n      this.$router.push('/login')\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadCart()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Brown Neutral Color Palette */\r\n:root {\r\n  --brown-dark: #5D4037;\r\n  --brown-medium: #7D5A50;\r\n  --brown-light: #A98274;\r\n  --beige: #F5F5DC;\r\n  --cream: #FFFBEB;\r\n  --accent: #8D6E63;\r\n  --neutral-dark: #4E342E;\r\n  --neutral-light: #D7CCC8;\r\n}\r\n\r\n.main-container {\r\n  background-color: var(--cream);\r\n}\r\n\r\n.search-container {\r\n  width: 300px;\r\n}\r\n\r\n.search-input {\r\n  background-color: #F9F4E8;\r\n  transition: all 0.3s;\r\n  border: 1px solid var(--neutral-light);\r\n}\r\n\r\n.search-input:focus {\r\n  background-color: white;\r\n  box-shadow: 0 0 10px rgba(93, 64, 55, 0.1);\r\n  border-color: var(--brown-light);\r\n}\r\n\r\n.search-icon {\r\n  top: 10px;\r\n  right: 15px;\r\n}\r\n\r\n.product-card {\r\n  transition: transform 0.3s, box-shadow 0.3s;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n}\r\n\r\n.product-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 10px 20px rgba(93, 64, 55, 0.15) !important;\r\n}\r\n\r\n.product-image-container {\r\n  height: 220px;\r\n  overflow: hidden;\r\n  position: relative;\r\n  background-color: #F9F4E8;\r\n}\r\n\r\n.product-image-list {\r\n  height: 100%;\r\n  width: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.no-image-placeholder {\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.no-image-placeholder i {\r\n  font-size: 3rem;\r\n}\r\n\r\n.bg-beige {\r\n  background-color: var(--beige);\r\n}\r\n\r\n.text-brown {\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-brown-dark {\r\n  color: var(--brown-dark);\r\n}\r\n\r\n.text-brown-medium {\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-brown-light {\r\n  color: var(--brown-light);\r\n}\r\n\r\n.product-description {\r\n  font-size: 0.9rem;\r\n  overflow: hidden;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  min-height: 60px;\r\n}\r\n\r\n.product-price {\r\n  font-size: 1.25rem;\r\n  font-weight: bold;\r\n}\r\n\r\n.stock-indicator {\r\n  font-size: 0.85rem;\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-accent {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n.btn-add-to-cart-list {\r\n  background-color: var(--brown-medium);\r\n  color: rgb(37, 30, 30);\r\n  border: 3px solid var(--brown-medium);\r\n  transition: all 0.3s;\r\n  border-radius: 6px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.btn-add-to-cart-list:hover:not(:disabled) {\r\n  background-color: var(--brown-dark);\r\n}\r\n\r\n.btn-brown-light {\r\n  background-color: var(--neutral-light);\r\n  color: var(--neutral-dark);\r\n}\r\n\r\n.out-of-stock-badge {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 10px;\r\n  background-color: rgba(125, 90, 80, 0.9);\r\n  color: white;\r\n  padding: 5px 10px;\r\n  border-radius: 4px;\r\n  font-size: 0.8rem;\r\n  font-weight: bold;\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAA+B;;EAEnCA,KAAK,EAAC;AAAU;;EACdA,KAAK,EAAC;AAAQ;;EACZA,KAAK,EAAC;AAAyD;;EAG7DA,KAAK,EAAC;AAAiC;;EACrCA,KAAK,EAAC;AAAyC;;EAThEC,GAAA;EA8B8CD,KAAK,EAAC;;;EAI3CA,KAAK,EAAC;AAAK;;EAEPA,KAAK,EAAC;AAA4C;;EAChDA,KAAK,EAAC;AAAyB;oBArC9C;;EAAAC,GAAA;EA4CwBD,KAAK,EAAC;;;EA5C9BC,GAAA;EA+C4CD,KAAK,EAAC;;;EAKnCA,KAAK,EAAC;AAAuC;;EAC5CA,KAAK,EAAC;AAA6C;;EACpDA,KAAK,EAAC;AAAiD;;EACrDA,KAAK,EAAC;AAAS;;EACbA,KAAK,EAAC;AAAwD;;EAC3DA,KAAK,EAAC;AAA+B;oBAzD3D;;uBACEE,mBAAA,CA2EM,OA3ENC,UA2EM,GA1EJC,mBAAA,oBAAuB,EACvBC,mBAAA,CAwBM,OAxBNC,UAwBM,GAvBJD,mBAAA,CAsBM,OAtBNE,UAsBM,GArBJF,mBAAA,CAoBM,OApBNG,UAoBM,G,0BAnBJH,mBAAA,CAAsE;IAAlEL,KAAK,EAAC;EAAkC,GAAC,sBAAoB,sBAEjEK,mBAAA,CAgBM,OAhBNI,UAgBM,GAfJJ,mBAAA,CAUM,OAVNK,UAUM,G,gBATJL,mBAAA,CAKE;IAfhB,uBAAAM,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAWyBC,KAAA,CAAAC,WAAW,GAAAF,MAAA;IACpBG,IAAI,EAAC,MAAM;IACXf,KAAK,EAAC,qEAAqE;IAC3EgB,WAAW,EAAC;iDAHHH,KAAA,CAAAC,WAAW,E,6BAKtBT,mBAAA,CAEO;IAFDL,KAAK,EAAC;EAA+B,IACzCK,mBAAA,CAA8C;IAA3CL,KAAK,EAAC;EAAgC,G,wBAI7CK,mBAAA,CAES;IAFDL,KAAK,EAAC,+BAA+B;IAAEiB,OAAK,EAAAN,MAAA,QAAAA,MAAA,UAAAO,IAAA,KAAEC,QAAA,CAAAC,MAAA,IAAAD,QAAA,CAAAC,MAAA,IAAAF,IAAA,CAAM;gCAC1Db,mBAAA,CAAwC;IAArCL,KAAK,EAAC;EAA0B,4BAtBjDqB,gBAAA,CAsBsD,UAC1C,E,YAMRjB,mBAAA,kBAAqB,EACVe,QAAA,CAAAG,gBAAgB,CAACC,MAAM,U,cAAlCrB,mBAAA,CAEM,OAFNsB,UAEM,EAAAb,MAAA,QAAAA,MAAA,OADJN,mBAAA,CAAuE;IAApEL,KAAK,EAAC;EAAkB,GAAC,yCAAuC,oB,MA/BzEI,mBAAA,gBAkCIC,mBAAA,CAyCM,OAzCNoB,UAyCM,I,kBAxCJvB,mBAAA,CAuCMwB,SAAA,QA1EZC,WAAA,CAmC6BR,QAAA,CAAAG,gBAAgB,EAA3BM,OAAO;yBAAnB1B,mBAAA,CAuCM;MAvCoCD,GAAG,EAAE2B,OAAO,CAACC,EAAE;MAAE7B,KAAK,EAAC;QAC/DK,mBAAA,CAqCM,OArCNyB,UAqCM,GApCJzB,mBAAA,CAaM,OAbN0B,WAaM,GAXIH,OAAO,CAACI,KAAK,I,cADrB9B,mBAAA,CAKE;MA3CdD,GAAA;MAwCegC,GAAG,EAAEL,OA