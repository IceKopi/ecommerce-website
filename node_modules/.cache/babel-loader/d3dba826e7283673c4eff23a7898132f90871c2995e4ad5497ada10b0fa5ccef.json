{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport axios from '../axios';\nimport { Modal } from 'bootstrap';\nexport default {\n  data() {\n    return {\n      orders: [],\n      selectedOrder: null,\n      receiptModal: null\n    };\n  },\n  methods: {\n    async fetchAllOrders() {\n      try {\n        const res = await axios.get('admin-orders/');\n        // Process the data to include customer names and product names\n        this.orders = res.data.map(order => {\n          // Add customer name (this assumes the API returns username in the customer object)\n          const customerName = order.customer.username || `User #${order.customer}`;\n\n          // Process items to include product names\n          const items = order.items.map(item => {\n            return {\n              ...item,\n              product_name: item.product.name || `Product #${item.product}`,\n              price: item.product.price || 0\n            };\n          });\n          return {\n            ...order,\n            customer_name: customerName,\n            items: items\n          };\n        });\n      } catch (error) {\n        console.error('Error fetching orders:', error);\n        alert('❌ Failed to load orders.');\n      }\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return new Intl.DateTimeFormat('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      }).format(date);\n    },\n    openReceiptModal(order) {\n      this.selectedOrder = order;\n      this.receiptModal.show();\n    },\n    printReceipt() {\n      const printContents = document.querySelector('.receipt-container').innerHTML;\n      const originalContents = document.body.innerHTML;\n      document.body.innerHTML = `\n          <div style=\"padding: 20px;\">\n            ${printContents}\n          </div>\n        `;\n      window.print();\n      document.body.innerHTML = originalContents;\n\n      // Re-initialize the modal and other components\n      this.$nextTick(() => {\n        this.initializeModal();\n      });\n    },\n    calculateTotal(items) {\n      return items.reduce((sum, item) => sum + item.price * item.quantity, 0);\n    },\n    initializeModal() {\n      const modalElement = document.getElementById('receiptModal');\n      if (modalElement) {\n        this.receiptModal = new Modal(modalElement);\n      }\n    }\n  },\n  mounted() {\n    const token = localStorage.getItem('access');\n    const isStaff = localStorage.getItem('is_staff') === 'true';\n    if (!token || !isStaff) {\n      alert('⛔ Access denied. Staff only.');\n      this.$router.push('/login');\n      return;\n    }\n    this.fetchAllOrders();\n    this.$nextTick(() => {\n      this.initializeModal();\n    });\n  }\n};","map":{"version":3,"names":["axios","Modal","data","orders","selectedOrder","receiptModal","methods","fetchAllOrders","res","get","map","order","customerName","customer","username","items","item","product_name","product","name","price","customer_name","error","console","alert","formatDate","dateString","date","Date","Intl","DateTimeFormat","year","month","day","hour","minute","format","openReceiptModal","show","printReceipt","printContents","document","querySelector","innerHTML","originalContents","body","window","print","$nextTick","initializeModal","calculateTotal","reduce","sum","quantity","modalElement","getElementById","mounted","token","localStorage","getItem","isStaff","$router","push"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\AdminTransactionHistory.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-4\">\r\n      <h3>📄 Transaction History</h3>\r\n      <div v-if=\"orders.length === 0\">No transactions found.</div>\r\n      <div v-for=\"order in orders\" :key=\"order.id\" class=\"card mb-2\">\r\n        <div class=\"card-body\">\r\n          <h6>Order #{{ order.id }} — {{ formatDate(order.date_ordered) }}</h6>\r\n          <p><strong>Customer:</strong> {{ order.customer_name }}</p>\r\n          <ul>\r\n            <li v-for=\"item in order.items\" :key=\"item.id\">\r\n              {{ item.product_name }} — Qty: {{ item.quantity }} — ${{ item.price.toFixed(2) }}\r\n            </li>\r\n          </ul>\r\n          <div class=\"text-end\">\r\n            <button class=\"btn btn-sm btn-primary\" @click=\"openReceiptModal(order)\">\r\n              View Receipt\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- Receipt Modal -->\r\n      <div class=\"modal fade\" id=\"receiptModal\" tabindex=\"-1\" aria-labelledby=\"receiptModalLabel\" aria-hidden=\"true\">\r\n        <div class=\"modal-dialog\">\r\n          <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n              <h5 class=\"modal-title\" id=\"receiptModalLabel\">\r\n                Receipt for Order #{{ selectedOrder?.id }}\r\n              </h5>\r\n              <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n            </div>\r\n            <div class=\"modal-body\" v-if=\"selectedOrder\">\r\n              <div class=\"receipt-container p-3\">\r\n                <div class=\"text-center mb-3\">\r\n                  <h4>RECEIPT</h4>\r\n                  <p>Order #{{ selectedOrder.id }}</p>\r\n                  <p>{{ formatDate(selectedOrder.date_ordered) }}</p>\r\n                </div>\r\n                \r\n                <div class=\"customer-details mb-3\">\r\n                  <p><strong>Customer:</strong> {{ selectedOrder.customer_name }}</p>\r\n                </div>\r\n                \r\n                <table class=\"table table-sm\">\r\n                  <thead>\r\n                    <tr>\r\n                      <th>Item</th>\r\n                      <th>Qty</th>\r\n                      <th class=\"text-end\">Price</th>\r\n                      <th class=\"text-end\">Total</th>\r\n                    </tr>\r\n                  </thead>\r\n                  <tbody>\r\n                    <tr v-for=\"item in selectedOrder.items\" :key=\"item.id\">\r\n                      <td>{{ item.product_name }}</td>\r\n                      <td>{{ item.quantity }}</td>\r\n                      <td class=\"text-end\">${{ item.price.toFixed(2) }}</td>\r\n                      <td class=\"text-end\">${{ (item.price * item.quantity).toFixed(2) }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                      <td colspan=\"3\" class=\"text-end\"><strong>Total</strong></td>\r\n                      <td class=\"text-end\"><strong>${{ calculateTotal(selectedOrder.items).toFixed(2) }}</strong></td>\r\n                    </tr>\r\n                  </tbody>\r\n                </table>\r\n                \r\n                <div class=\"text-center mt-4\">\r\n                  <p>Thank you for your purchase!</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"modal-footer\">\r\n              <button type=\"button\" class=\"btn btn-secondary\" data-bs-dismiss=\"modal\">Close</button>\r\n              <button type=\"button\" class=\"btn btn-primary\" @click=\"printReceipt\">Print Receipt</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  import { Modal } from 'bootstrap'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        orders: [],\r\n        selectedOrder: null,\r\n        receiptModal: null\r\n      }\r\n    },\r\n    methods: {\r\n      async fetchAllOrders() {\r\n        try {\r\n          const res = await axios.get('admin-orders/')\r\n          // Process the data to include customer names and product names\r\n          this.orders = res.data.map(order => {\r\n            // Add customer name (this assumes the API returns username in the customer object)\r\n            const customerName = order.customer.username || `User #${order.customer}`\r\n            \r\n            // Process items to include product names\r\n            const items = order.items.map(item => {\r\n              return {\r\n                ...item,\r\n                product_name: item.product.name || `Product #${item.product}`,\r\n                price: item.product.price || 0\r\n              }\r\n            })\r\n            \r\n            return {\r\n              ...order,\r\n              customer_name: customerName,\r\n              items: items\r\n            }\r\n          })\r\n        } catch (error) {\r\n          console.error('Error fetching orders:', error)\r\n          alert('❌ Failed to load orders.')\r\n        }\r\n      },\r\n      \r\n      formatDate(dateString) {\r\n        const date = new Date(dateString)\r\n        return new Intl.DateTimeFormat('en-US', {\r\n          year: 'numeric',\r\n          month: 'short',\r\n          day: 'numeric',\r\n          hour: '2-digit',\r\n          minute: '2-digit'\r\n        }).format(date)\r\n      },\r\n      \r\n      openReceiptModal(order) {\r\n        this.selectedOrder = order\r\n        this.receiptModal.show()\r\n      },\r\n      \r\n      printReceipt() {\r\n        const printContents = document.querySelector('.receipt-container').innerHTML\r\n        const originalContents = document.body.innerHTML\r\n        \r\n        document.body.innerHTML = `\r\n          <div style=\"padding: 20px;\">\r\n            ${printContents}\r\n          </div>\r\n        `\r\n        \r\n        window.print()\r\n        document.body.innerHTML = originalContents\r\n        \r\n        // Re-initialize the modal and other components\r\n        this.$nextTick(() => {\r\n          this.initializeModal()\r\n        })\r\n      },\r\n      \r\n      calculateTotal(items) {\r\n        return items.reduce((sum, item) => sum + (item.price * item.quantity), 0)\r\n      },\r\n      \r\n      initializeModal() {\r\n        const modalElement = document.getElementById('receiptModal')\r\n        if (modalElement) {\r\n          this.receiptModal = new Modal(modalElement)\r\n        }\r\n      }\r\n    },\r\n    mounted() {\r\n      const token = localStorage.getItem('access')\r\n      const isStaff = localStorage.getItem('is_staff') === 'true'\r\n      if (!token || !isStaff) {\r\n        alert('⛔ Access denied. Staff only.')\r\n        this.$router.push('/login')\r\n        return\r\n      }\r\n      \r\n      this.fetchAllOrders()\r\n      this.$nextTick(() => {\r\n        this.initializeModal()\r\n      })\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .receipt-container {\r\n    font-family: 'Courier New', monospace;\r\n    border: 1px solid #ddd;\r\n    border-radius: 5px;\r\n    background-color: #f9f9f9;\r\n  }\r\n  \r\n  @media print {\r\n    body * {\r\n      visibility: hidden;\r\n    }\r\n    .receipt-container, .receipt-container * {\r\n      visibility: visible;\r\n    }\r\n    .receipt-container {\r\n      position: absolute;\r\n      left: 0;\r\n      top: 0;\r\n      width: 100%;\r\n    }\r\n  }\r\n  </style>"],"mappings":";;;;AAkFE,OAAOA,KAAI,MAAO,UAAS;AAC3B,SAASC,KAAI,QAAS,WAAU;AAEhC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,EAAE;MACVC,aAAa,EAAE,IAAI;MACnBC,YAAY,EAAE;IAChB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF,MAAMC,GAAE,GAAI,MAAMR,KAAK,CAACS,GAAG,CAAC,eAAe;QAC3C;QACA,IAAI,CAACN,MAAK,GAAIK,GAAG,CAACN,IAAI,CAACQ,GAAG,CAACC,KAAI,IAAK;UAClC;UACA,MAAMC,YAAW,GAAID,KAAK,CAACE,QAAQ,CAACC,QAAO,IAAK,SAASH,KAAK,CAACE,QAAQ,EAAC;;UAExE;UACA,MAAME,KAAI,GAAIJ,KAAK,CAACI,KAAK,CAACL,GAAG,CAACM,IAAG,IAAK;YACpC,OAAO;cACL,GAAGA,IAAI;cACPC,YAAY,EAAED,IAAI,CAACE,OAAO,CA