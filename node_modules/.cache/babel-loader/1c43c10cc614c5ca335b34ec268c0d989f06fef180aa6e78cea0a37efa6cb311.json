{"ast":null,"code":"import axios from '../axios';\nexport default {\n  data() {\n    return {\n      cart: []\n    };\n  },\n  mounted() {\n    const stored = localStorage.getItem('cart');\n    this.cart = stored ? JSON.parse(stored) : [];\n  },\n  methods: {\n    async checkout() {\n      try {\n        const user = await axios.get('user/');\n        const orderRes = await axios.post('orders/', {\n          customer: user.data.id,\n          complete: true\n        });\n        const orderId = orderRes.data.id;\n        for (const item of this.cart) {\n          await axios.post('order-items/', {\n            order: orderId,\n            product: item.id,\n            quantity: item.quantity\n          });\n        }\n        alert('✅ Order placed successfully!');\n        localStorage.removeItem('cart');\n        this.cart = [];\n      } catch (err) {\n        console.error(err);\n        alert('❌ Failed to complete checkout. Please try again.');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","cart","mounted","stored","localStorage","getItem","JSON","parse","methods","checkout","user","get","orderRes","post","customer","id","complete","orderId","item","order","product","quantity","alert","removeItem","err","console","error"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-3\">\r\n      <h2>My Cart</h2>\r\n      <div v-if=\"!cart || cart.length === 0\">Cart is empty.</div>\r\n      <ul class=\"list-group mb-3\" v-else>\r\n        <li\r\n          v-for=\"item in cart\"\r\n          :key=\"item.id\"\r\n          class=\"list-group-item d-flex justify-content-between\"\r\n        >\r\n          {{ item.name }} x {{ item.quantity }}\r\n          <span>₱{{ item.price * item.quantity }}</span>\r\n        </li>\r\n      </ul>\r\n      <button @click=\"checkout\" class=\"btn btn-success\" :disabled=\"!cart || cart.length === 0\">\r\n        Checkout\r\n      </button>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        cart: []\r\n      }\r\n    },\r\n    mounted() {\r\n      const stored = localStorage.getItem('cart')\r\n      this.cart = stored ? JSON.parse(stored) : []\r\n    },\r\n    methods: {\r\n      async checkout() {\r\n        try {\r\n          const user = await axios.get('user/')\r\n          const orderRes = await axios.post('orders/', {\r\n            customer: user.data.id,\r\n            complete: true\r\n          })\r\n  \r\n          const orderId = orderRes.data.id\r\n          for (const item of this.cart) {\r\n            await axios.post('order-items/', {\r\n              order: orderId,\r\n              product: item.id,\r\n              quantity: item.quantity\r\n            })\r\n          }\r\n  \r\n          alert('✅ Order placed successfully!')\r\n          localStorage.removeItem('cart')\r\n          this.cart = []\r\n        } catch (err) {\r\n          console.error(err)\r\n          alert('❌ Failed to complete checkout. Please try again.')\r\n        }\r\n      }\r\n    }\r\n  }\r\n  </script>"],"mappings":"AAqBE,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;IAC1C,IAAI,CAACJ,IAAG,GAAIE,MAAK,GAAIG,IAAI,CAACC,KAAK,CAACJ,MAAM,IAAI,EAAC;EAC7C,CAAC;EACDK,OAAO,EAAE;IACP,MAAMC,QAAQA,CAAA,EAAG;MACf,IAAI;QACF,MAAMC,IAAG,GAAI,MAAMX,KAAK,CAACY,GAAG,CAAC,OAAO;QACpC,MAAMC,QAAO,GAAI,MAAMb,KAAK,CAACc,IAAI,CAAC,SAAS,EAAE;UAC3CC,QAAQ,EAAEJ,IAAI,CAACV,IAAI,CAACe,EAAE;UACtBC,QAAQ,EAAE;QACZ,CAAC;QAED,MAAMC,OAAM,GAAIL,QAAQ,CAACZ,IAAI,CAACe,EAAC;QAC/B,KAAK,MAAMG,IAAG,IAAK,IAAI,CAACjB,IAAI,EAAE;UAC5B,MAAMF,KAAK,CAACc,IAAI,CAAC,cAAc,EAAE;YAC/BM,KAAK,EAAEF,OAAO;YACdG,OAAO,EAAEF,IAAI,CAACH,EAAE;YAChBM,QAAQ,EAAEH,IAAI,CAACG;UACjB,CAAC;QACH;QAEAC,KAAK,CAAC,8