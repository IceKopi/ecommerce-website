{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport { toast } from 'vue3-toastify';\nimport 'vue3-toastify/dist/index.css';\nexport default {\n  data() {\n    return {\n      searchQuery: '',\n      cart: [],\n      products: []\n    };\n  },\n  computed: {\n    filteredProducts() {\n      const q = this.searchQuery.toLowerCase();\n      return this.products.filter(p => p.name.toLowerCase().includes(q) || p.description.toLowerCase().includes(q));\n    }\n  },\n  methods: {\n    buttonText(product) {\n      if (product.stock === 0) return 'Out of Stock';\n      if (this.hasReachedLimit(product)) return 'Max Quantity Reached';\n      return 'Add to Cart';\n    },\n    loadCart() {\n      try {\n        const stored = localStorage.getItem('cart');\n        this.cart = stored ? JSON.parse(stored) : [];\n      } catch (err) {\n        console.error('Error loading cart:', err);\n        this.cart = [];\n      }\n    },\n    loadProducts() {\n      const defaultProducts = [{\n        id: 1,\n        name: 'Handwoven Basket',\n        description: 'Eco-friendly and durable basket for home use.',\n        price: 499,\n        stock: 5,\n        image: 'https://via.placeholder.com/300x200?text=Basket'\n      }, {\n        id: 2,\n        name: 'Wooden Spoon Set',\n        description: 'A set of 5 handcrafted wooden spoons.',\n        price: 299,\n        stock: 2,\n        image: 'https://via.placeholder.com/300x200?text=Spoon+Set'\n      }, {\n        id: 3,\n        name: 'Canvas Tote Bag',\n        description: 'Stylish and reusable tote bag made of cotton.',\n        price: 350,\n        stock: 0,\n        image: 'https://via.placeholder.com/300x200?text=Tote+Bag'\n      }];\n      const storedProducts = localStorage.getItem('products');\n      if (storedProducts) {\n        try {\n          this.products = JSON.parse(storedProducts);\n        } catch {\n          this.products = defaultProducts;\n        }\n      } else {\n        this.products = defaultProducts;\n      }\n    },\n    saveCart() {\n      localStorage.setItem('cart', JSON.stringify(this.cart));\n    },\n    saveProducts() {\n      localStorage.setItem('products', JSON.stringify(this.products));\n    },\n    addToCart(product) {\n      const existing = this.cart.find(item => item.product === product.id);\n      if (existing) {\n        if (existing.quantity < product.stock) {\n          existing.quantity++;\n          product.stock--;\n          toast.success(`${product.name} quantity updated!`);\n        } else {\n          toast.warning(`You've reached the max stock for ${product.name}.`);\n          return;\n        }\n      } else {\n        if (product.stock === 0) {\n          toast.error(`${product.name} is out of stock.`);\n          return;\n        }\n        this.cart.push({\n          id: product.id,\n          product: product.id,\n          product_name: product.name,\n          price: product.price,\n          quantity: 1\n        });\n        product.stock--;\n        toast.success(`${product.name} added to cart!`);\n      }\n      this.saveCart();\n      this.saveProducts();\n    },\n    hasReachedLimit(product) {\n      const item = this.cart.find(c => c.product === product.id);\n      return item ? item.quantity >= product.stock : false;\n    },\n    logout() {\n      localStorage.clear();\n      this.$router.push('/login');\n      toast.info('You have been logged out.');\n    }\n  },\n  created() {\n    this.loadCart();\n    this.loadProducts();\n  }\n};","map":{"version":3,"names":["toast","data","searchQuery","cart","products","computed","filteredProducts","q","toLowerCase","filter","p","name","includes","description","methods","buttonText","product","stock","hasReachedLimit","loadCart","stored","localStorage","getItem","JSON","parse","err","console","error","loadProducts","defaultProducts","id","price","image","storedProducts","saveCart","setItem","stringify","saveProducts","addToCart","existing","find","item","quantity","success","warning","push","product_name","c","logout","clear","$router","info","created"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ProductList.vue"],"sourcesContent":["<template>\r\n  <div class=\"container py-5 main-container\">\r\n    <!-- Header Section -->\r\n    <div class=\"row mb-5\">\r\n      <div class=\"col-12\">\r\n        <div class=\"d-flex justify-content-between align-items-center w-100\">\r\n          <h2 class=\"font-weight-bold text-brown mb-0\">Maisanova Collection</h2>\r\n\r\n          <div class=\"d-flex align-items-center gap-3\">\r\n            <div class=\"search-container position-relative me-3\">\r\n              <input\r\n                v-model=\"searchQuery\"\r\n                type=\"text\"\r\n                class=\"form-control search-input pl-4 pr-5 rounded-pill border-0 shadow-sm\"\r\n                placeholder=\"Search our collection...\"\r\n              />\r\n              <span class=\"position-absolute search-icon\">\r\n                <i class=\"fas fa-search text-brown-light\"></i>\r\n              </span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Product Grid -->\r\n    <div v-if=\"filteredProducts.length === 0\" class=\"text-center py-5\">\r\n      <p class=\"text-brown-light\">No products match your search criteria.</p>\r\n    </div>\r\n\r\n    <div class=\"row\">\r\n      <div v-for=\"product in filteredProducts\" :key=\"product.id\" class=\"col-md-4 mb-4\">\r\n        <div class=\"card product-card h-100 border-0 shadow-sm\">\r\n          <div class=\"product-image-container\">\r\n            <img\r\n              v-if=\"product.image\"\r\n              :src=\"product.image\"\r\n              class=\"card-img-top product-image-list\"\r\n              alt=\"Product\"\r\n            />\r\n            <div v-else class=\"no-image-placeholder\">\r\n              <i class=\"fas fa-image text-brown-light\"></i>\r\n            </div>\r\n            <div v-if=\"product.stock === 0\" class=\"out-of-stock-badge\">\r\n              Out of Stock\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"card-body d-flex flex-column bg-beige\">\r\n            <h5 class=\"card-title font-weight-bold text-brown-dark\">{{ product.name }}</h5>\r\n            <p class=\"card-text text-brown-medium product-description\">{{ product.description }}</p>\r\n            <div class=\"mt-auto\">\r\n              <div class=\"d-flex justify-content-between align-items-center mb-3\">\r\n                <span class=\"product-price text-brown-dark\">₱{{ product.price.toLocaleString() }}</span>\r\n                <span class=\"stock-indicator\" :class=\"{'text-accent': product.stock < 5 && product.stock > 0}\">\r\n                  {{ product.stock > 0 ? `${product.stock} in stock` : '' }}\r\n                </span>\r\n              </div>\r\n              <button\r\n                class=\"btn btn-add-to-cart-list w-100 text-brown border-1 shadow-sm\"\r\n                @click=\"addToCart(product)\"\r\n                :disabled=\"product.stock === 0 || hasReachedLimit(product)\"\r\n                :class=\"{'btn-brown-light': product.stock === 0 || hasReachedLimit(product)}\"\r\n              >\r\n                <i class=\"fas fa-shopping-cart mr-2\"></i>\r\n                {{ buttonText(product) }}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { toast } from 'vue3-toastify'\r\nimport 'vue3-toastify/dist/index.css'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      searchQuery: '',\r\n      cart: [],\r\n      products: []\r\n    }\r\n  },\r\n  computed: {\r\n    filteredProducts() {\r\n      const q = this.searchQuery.toLowerCase()\r\n      return this.products.filter(p =>\r\n        p.name.toLowerCase().includes(q) ||\r\n        p.description.toLowerCase().includes(q)\r\n      )\r\n    }\r\n  },\r\n  methods: {\r\n    buttonText(product) {\r\n      if (product.stock === 0) return 'Out of Stock'\r\n      if (this.hasReachedLimit(product)) return 'Max Quantity Reached'\r\n      return 'Add to Cart'\r\n    },\r\n    loadCart() {\r\n      try {\r\n        const stored = localStorage.getItem('cart')\r\n        this.cart = stored ? JSON.parse(stored) : []\r\n      } catch (err) {\r\n        console.error('Error loading cart:', err)\r\n        this.cart = []\r\n      }\r\n    },\r\n    loadProducts() {\r\n      const defaultProducts = [\r\n        {\r\n          id: 1,\r\n          name: 'Handwoven Basket',\r\n          description: 'Eco-friendly and durable basket for home use.',\r\n          price: 499,\r\n          stock: 5,\r\n          image: 'https://via.placeholder.com/300x200?text=Basket'\r\n        },\r\n        {\r\n          id: 2,\r\n          name: 'Wooden Spoon Set',\r\n          description: 'A set of 5 handcrafted wooden spoons.',\r\n          price: 299,\r\n          stock: 2,\r\n          image: 'https://via.placeholder.com/300x200?text=Spoon+Set'\r\n        },\r\n        {\r\n          id: 3,\r\n          name: 'Canvas Tote Bag',\r\n          description: 'Stylish and reusable tote bag made of cotton.',\r\n          price: 350,\r\n          stock: 0,\r\n          image: 'https://via.placeholder.com/300x200?text=Tote+Bag'\r\n        }\r\n      ]\r\n\r\n      const storedProducts = localStorage.getItem('products')\r\n      if (storedProducts) {\r\n        try {\r\n          this.products = JSON.parse(storedProducts)\r\n        } catch {\r\n          this.products = defaultProducts\r\n        }\r\n      } else {\r\n        this.products = defaultProducts\r\n      }\r\n    },\r\n    saveCart() {\r\n      localStorage.setItem('cart', JSON.stringify(this.cart))\r\n    },\r\n    saveProducts() {\r\n      localStorage.setItem('products', JSON.stringify(this.products))\r\n    },\r\n    addToCart(product) {\r\n      const existing = this.cart.find(item => item.product === product.id)\r\n\r\n      if (existing) {\r\n        if (existing.quantity < product.stock) {\r\n          existing.quantity++\r\n          product.stock--\r\n          toast.success(`${product.name} quantity updated!`)\r\n        } else {\r\n          toast.warning(`You've reached the max stock for ${product.name}.`)\r\n          return\r\n        }\r\n      } else {\r\n        if (product.stock === 0) {\r\n          toast.error(`${product.name} is out of stock.`)\r\n          return\r\n        }\r\n\r\n        this.cart.push({\r\n          id: product.id,\r\n          product: product.id,\r\n          product_name: product.name,\r\n          price: product.price,\r\n          quantity: 1\r\n        })\r\n        product.stock--\r\n        toast.success(`${product.name} added to cart!`)\r\n      }\r\n\r\n      this.saveCart()\r\n      this.saveProducts()\r\n    },\r\n    hasReachedLimit(product) {\r\n      const item = this.cart.find(c => c.product === product.id)\r\n      return item ? item.quantity >= product.stock : false\r\n    },\r\n    logout() {\r\n      localStorage.clear()\r\n      this.$router.push('/login')\r\n      toast.info('You have been logged out.')\r\n    }\r\n  },\r\n  created() {\r\n    this.loadCart()\r\n    this.loadProducts()\r\n  }\r\n}\r\n</script>\r\n\r\n\r\n<style scoped>\r\n/* Brown Neutral Color Palette */\r\n:root {\r\n  --brown-dark: #5D4037;\r\n  --brown-medium: #7D5A50;\r\n  --brown-light: #A98274;\r\n  --beige: #F5F5DC;\r\n  --cream: #FFFBEB;\r\n  --accent: #8D6E63;\r\n  --neutral-dark: #4E342E;\r\n  --neutral-light: #D7CCC8;\r\n}\r\n\r\n.main-container {\r\n  background-color: var(--cream);\r\n}\r\n\r\n.search-container {\r\n  width: 300px;\r\n}\r\n\r\n.search-input {\r\n  background-color: #F9F4E8;\r\n  transition: all 0.3s;\r\n  border: 1px solid var(--neutral-light);\r\n}\r\n\r\n.search-input:focus {\r\n  background-color: white;\r\n  box-shadow: 0 0 10px rgba(93, 64, 55, 0.1);\r\n  border-color: var(--brown-light);\r\n}\r\n\r\n.search-icon {\r\n  top: 10px;\r\n  right: 15px;\r\n}\r\n\r\n.product-card {\r\n  transition: transform 0.3s, box-shadow 0.3s;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n}\r\n\r\n.product-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 10px 20px rgba(93, 64, 55, 0.15) !important;\r\n}\r\n\r\n.product-image-container {\r\n  height: 220px;\r\n  overflow: hidden;\r\n  position: relative;\r\n  background-color: #F9F4E8;\r\n}\r\n\r\n.product-image-list {\r\n  height: 100%;\r\n  width: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.no-image-placeholder {\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.no-image-placeholder i {\r\n  font-size: 3rem;\r\n}\r\n\r\n.bg-beige {\r\n  background-color: var(--beige);\r\n}\r\n\r\n.text-brown {\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-brown-dark {\r\n  color: var(--brown-dark);\r\n}\r\n\r\n.text-brown-medium {\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-brown-light {\r\n  color: var(--brown-light);\r\n}\r\n\r\n.product-description {\r\n  font-size: 0.9rem;\r\n  overflow: hidden;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  min-height: 60px;\r\n}\r\n\r\n.product-price {\r\n  font-size: 1.25rem;\r\n  font-weight: bold;\r\n}\r\n\r\n.stock-indicator {\r\n  font-size: 0.85rem;\r\n  color: var(--brown-medium);\r\n}\r\n\r\n.text-accent {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n.btn-add-to-cart-list {\r\n  background-color: var(--brown-medium);\r\n  color: rgb(37, 30, 30);\r\n  border: 3px solid var(--brown-medium);\r\n  transition: all 0.3s;\r\n  border-radius: 6px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.btn-add-to-cart-list:hover:not(:disabled) {\r\n  background-color: var(--brown-dark);\r\n}\r\n\r\n.btn-brown-light {\r\n  background-color: var(--neutral-light);\r\n  color: var(--neutral-dark);\r\n}\r\n\r\n.out-of-stock-badge {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 10px;\r\n  background-color: rgba(125, 90, 80, 0.9);\r\n  color: white;\r\n  padding: 5px 10px;\r\n  border-radius: 4px;\r\n  font-size: 0.8rem;\r\n  font-weight: bold;\r\n}\r\n</style>"],"mappings":";;;;AA4EA,SAASA,KAAI,QAAS,eAAc;AACpC,OAAO,8BAA6B;AAEpC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,WAAW,EAAE,EAAE;MACfC,IAAI,EAAE,EAAE;MACRC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,gBAAgBA,CAAA,EAAG;MACjB,MAAMC,CAAA,GAAI,IAAI,CAACL,WAAW,CAACM,WAAW,CAAC;MACvC,OAAO,IAAI,CAACJ,QAAQ,CAACK,MAAM,CAACC,CAAA,IAC1BA,CAAC,CAACC,IAAI,CAACH,WAAW,CAAC,CAAC,CAACI,QAAQ,CAACL,CAAC,KAC/BG,CAAC,CAACG,WAAW,CAACL,WAAW,CAAC,CAAC,CAACI,QAAQ,CAACL,CAAC,CACxC;IACF;EACF,CAAC;EACDO,OAAO,EAAE;IACPC,UAAUA,CAACC,OAAO,EAAE;MAClB,IAAIA,OAAO,CAACC,KAAI,KAAM,CAAC,EAAE,OAAO,cAAa;MAC7C,IAAI,IAAI,CAACC,eAAe,CAACF,OAAO,CAAC,EAAE,OAAO,sBAAqB;MAC/D,OAAO,aAAY;IACrB,CAAC;IACDG,QAAQA,CAAA,EAAG;MACT,IAAI;QACF,MAAMC,MAAK,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;QAC1C,IAAI,CAACnB,IAAG,GAAIiB,MAAK,GAAIG,IAAI,CAACC,KAAK,CAACJ,MAAM,IAAI,EAAC;MAC7C,EAAE,OAAOK,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,qBAAqB,EAAEF,GAAG;QACxC,IAAI,CAACtB,IAAG,GAAI,EAAC;MACf;IACF,CAAC;IACDyB,YAAYA,CAAA,EAAG;MACb,MAAMC,eAAc,GAAI,CACtB;QACEC,EAAE,EAAE,CAAC;QACLnB,IAAI,EAAE,kBAAkB;QACxBE,WAAW,EAAE,+CAA+C;QAC5DkB,KAAK,EAAE,GAAG;QACVd,KAAK,EAAE,CAAC;QACRe,KAAK,EAAE;MACT,CAAC,EACD;QACEF,EAAE,EAAE,CAAC;QACLnB,IAAI,EAAE,kBAAkB;QACxBE,WAAW,EAAE,uCAAuC;QACpDkB,KAAK,EAAE,GAAG;QACVd,KAAK,EAAE,CAAC;QACRe,KAAK,EAAE;MACT,CAAC,EACD;QACEF,EAAE,EAAE,CAAC;QACLnB,IAAI,EAAE,iBAAiB;QACvBE,WAAW,EAAE,+CAA+C;QAC5DkB,KAAK,EAAE,GAAG;QACVd,KAAK,EAAE,CAAC;QACRe,KAAK,EAAE;MACT,EACF;MAEA,MAAMC,cAAa,GAAIZ,YAAY,CAACC,OAAO,CAAC,UAAU;MACtD,IAAIW,cAAc,EAAE;QAClB,IAAI;UACF,IAAI,CAAC7B,QAAO,GAAImB,IAAI,CAACC,KAAK,CAACS,cAAc;QAC3C,E