{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nexport default {\n  data() {\n    return {\n      orders: [],\n      filteredOrders: [],\n      selectedOrder: null,\n      orderToDelete: null,\n      receiptModal: null,\n      deleteModal: null,\n      isDeleting: false,\n      filters: {\n        startDate: null,\n        endDate: null\n      }\n    };\n  },\n  methods: {\n    fetchAllOrders() {\n      const savedOrders = JSON.parse(localStorage.getItem('orders') || '[]');\n      this.orders = savedOrders;\n      this.filteredOrders = [...savedOrders];\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return new Intl.DateTimeFormat('en-US', {\n        year: 'numeric',\n        month: 'short',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      }).format(date);\n    },\n    openReceiptModal(order) {\n      this.selectedOrder = order;\n      this.receiptModal.show();\n    },\n    confirmDelete(order) {\n      this.orderToDelete = order;\n      this.deleteModal.show();\n    },\n    deleteOrder() {\n      if (!this.orderToDelete) return;\n      this.isDeleting = true;\n      setTimeout(() => {\n        this.orders = this.orders.filter(o => o.id !== this.orderToDelete.id);\n        this.filteredOrders = this.filteredOrders.filter(o => o.id !== this.orderToDelete.id);\n        localStorage.setItem('orders', JSON.stringify(this.orders));\n        this.deleteModal.hide();\n        this.orderToDelete = null;\n        this.isDeleting = false;\n        alert('Transaction deleted successfully');\n      }, 500);\n    },\n    applyFilters() {\n      if (!this.filters.startDate && !this.filters.endDate) {\n        this.filteredOrders = [...this.orders];\n        return;\n      }\n      const start = this.filters.startDate ? new Date(this.filters.startDate) : null;\n      const end = this.filters.endDate ? new Date(this.filters.endDate) : null;\n      if (end) end.setHours(23, 59, 59, 999);\n      this.filteredOrders = this.orders.filter(order => {\n        const d = new Date(order.date_ordered);\n        return (!start || d >= start) && (!end || d <= end);\n      });\n    },\n    resetFilters() {\n      this.filters.startDate = null;\n      this.filters.endDate = null;\n      this.filteredOrders = [...this.orders];\n    },\n    calculateTotal(items) {\n      return items.reduce((sum, i) => sum + i.price * i.quantity, 0);\n    },\n    initializeModal() {\n      this.receiptModal = new bootstrap.Modal(document.getElementById('receiptModal'));\n      this.deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));\n    }\n  },\n  mounted() {\n    const isStaff = localStorage.getItem('is_staff') === 'true';\n    if (!isStaff) {\n      alert('Access denied');\n      this.$router.push('/login');\n      return;\n    }\n    this.fetchAllOrders();\n    this.$nextTick(() => this.initializeModal());\n  }\n};","map":{"version":3,"names":["data","orders","filteredOrders","selectedOrder","orderToDelete","receiptModal","deleteModal","isDeleting","filters","startDate","endDate","methods","fetchAllOrders","savedOrders","JSON","parse","localStorage","getItem","formatDate","dateString","date","Date","Intl","DateTimeFormat","year","month","day","hour","minute","format","openReceiptModal","order","show","confirmDelete","deleteOrder","setTimeout","filter","o","id","setItem","stringify","hide","alert","applyFilters","start","end","setHours","d","date_ordered","resetFilters","calculateTotal","items","reduce","sum","i","price","quantity","initializeModal","bootstrap","Modal","document","getElementById","mounted","isStaff","$router","push","$nextTick"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\AdminTransactionHistory.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-5\">\r\n      <div class=\"row justify-content-center\">\r\n        <div class=\"col-lg-10\">\r\n          <h3 class=\"mb-4 fw-light text-center display-6\">\r\n            <i class=\"bi bi-receipt\"></i> Transaction History\r\n          </h3>\r\n          \r\n          <!-- Date Filter -->\r\n          <div class=\"card shadow-sm border-0 mb-4\">\r\n            <div class=\"card-body\">\r\n              <div class=\"row align-items-center\">\r\n                <div class=\"col-md-5\">\r\n                  <div class=\"form-group\">\r\n                    <label for=\"startDate\" class=\"form-label text-brown\">From Date</label>\r\n                    <input \r\n                      type=\"date\" \r\n                      class=\"form-control\" \r\n                      id=\"startDate\" \r\n                      v-model=\"filters.startDate\" \r\n                      @change=\"applyFilters\"\r\n                    >\r\n                  </div>\r\n                </div>\r\n                <div class=\"col-md-5\">\r\n                  <div class=\"form-group\">\r\n                    <label for=\"endDate\" class=\"form-label text-brown\">To Date</label>\r\n                    <input \r\n                      type=\"date\" \r\n                      class=\"form-control\" \r\n                      id=\"endDate\" \r\n                      v-model=\"filters.endDate\" \r\n                      @change=\"applyFilters\"\r\n                    >\r\n                  </div>\r\n                </div>\r\n                <div class=\"col-md-2 d-flex align-items-end\">\r\n                  <button \r\n                    class=\"btn btn-light w-100\" \r\n                    @click=\"resetFilters\"\r\n                  >\r\n                    Reset\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"card shadow-sm border-0 mb-4\" v-if=\"filteredOrders.length === 0\">\r\n            <div class=\"card-body text-center p-5 text-muted\">\r\n              <i class=\"bi bi-inbox fs-1\"></i>\r\n              <p class=\"mt-3\">No transactions found.</p>\r\n            </div>\r\n          </div>\r\n          \r\n          <div v-for=\"order in filteredOrders\" :key=\"order.id\" class=\"card mb-3 shadow-sm border-0\">\r\n            <div class=\"card-header bg-transparent border-bottom-0 pt-3\">\r\n              <div class=\"d-flex justify-content-between align-items-center\">\r\n                <h6 class=\"fw-normal text-brown mb-0\">\r\n                  Order #{{ order.id }}\r\n                </h6>\r\n                <div>\r\n                  <span class=\"badge bg-soft-brown text-brown me-2\">\r\n                    {{ formatDate(order.date_ordered) }}\r\n                  </span>\r\n                  <button \r\n                    class=\"btn btn-outline-danger btn-sm\" \r\n                    @click=\"confirmDelete(order)\"\r\n                    title=\"Delete Transaction\"\r\n                  >\r\n                    <i class=\"bi bi-trash\"></i>\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"card-body pt-0\">\r\n              <p class=\"mb-3 fw-light\"><span class=\"fw-semibold text-brown\">Customer:</span> {{ order.customer_name }}</p>\r\n              <div class=\"items-list mb-3\">\r\n                <div v-for=\"item in order.items\" :key=\"item.id\" class=\"d-flex justify-content-between align-items-center py-2 border-bottom border-light\">\r\n                  <div>\r\n                    <span class=\"fw-medium\">{{ item.product_name || 'Unknown Product' }}</span>\r\n                    <span class=\"text-muted ms-2\">× {{ item.quantity || 0 }}</span>\r\n                  </div>\r\n                  <span class=\"text-brown\">₱{{ (item.price || 0).toFixed(2) }}</span>\r\n                </div>\r\n              </div>\r\n              <div class=\"text-end\">\r\n                <button class=\"btn btn-outline-brown px-4\" @click=\"openReceiptModal(order)\">\r\n                  <i class=\"bi bi-receipt me-1\"></i> View Receipt\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- Receipt Modal -->\r\n      <div class=\"modal fade\" id=\"receiptModal\" tabindex=\"-1\" aria-labelledby=\"receiptModalLabel\" aria-hidden=\"true\">\r\n        <div class=\"modal-dialog modal-dialog-centered\">\r\n          <div class=\"modal-content border-0\">\r\n            <div class=\"modal-header border-0\">\r\n              <h5 class=\"modal-title fw-light text-brown\" id=\"receiptModalLabel\">\r\n                Receipt for Order #{{ selectedOrder?.id }}\r\n              </h5>\r\n              <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n            </div>\r\n            <div class=\"modal-body\" v-if=\"selectedOrder\">\r\n              <div class=\"receipt-container p-4\">\r\n                <div class=\"text-center mb-4\">\r\n                  <h4 class=\"fw-light text-uppercase mb-2\">RECEIPT</h4>\r\n                  <p class=\"mb-1 small\">Order #{{ selectedOrder.id }}</p>\r\n                  <p class=\"small text-muted\">{{ formatDate(selectedOrder.date_ordered) }}</p>\r\n                  <div class=\"separator my-3 mx-auto\"></div>\r\n                </div>\r\n                \r\n                <div class=\"customer-details mb-4 text-center\">\r\n                  <p class=\"mb-1\"><span class=\"fw-light\">Customer:</span> {{ selectedOrder.customer_name }}</p>\r\n                </div>\r\n                \r\n                <table class=\"table table-borderless receipt-table\">\r\n                  <thead class=\"table-light\">\r\n                    <tr class=\"text-brown\">\r\n                      <th class=\"fw-medium\">Item</th>\r\n                      <th class=\"fw-medium\">Qty</th>\r\n                      <th class=\"text-end fw-medium\">Price</th>\r\n                      <th class=\"text-end fw-medium\">Total</th>\r\n                    </tr>\r\n                  </thead>\r\n                  <tbody>\r\n                    <tr v-for=\"item in selectedOrder.items\" :key=\"item.id\">\r\n                      <td>{{ item.product_name || 'Unknown Product' }}</td>\r\n                      <td>{{ item.quantity || 0 }}</td>\r\n                      <td class=\"text-end\">₱{{ (item.price || 0).toFixed(2) }}</td>\r\n                      <td class=\"text-end\">₱{{ ((item.price || 0) * (item.quantity || 0)).toFixed(2) }}</td>\r\n                    </tr>\r\n                    <tr class=\"border-top\">\r\n                      <td colspan=\"3\" class=\"text-end\"><strong>Total</strong></td>\r\n                      <td class=\"text-end\"><strong class=\"text-brown\">₱{{ calculateTotal(selectedOrder.items).toFixed(2) }}</strong></td>\r\n                    </tr>\r\n                  </tbody>\r\n                </table>\r\n                \r\n                <div class=\"text-center mt-4\">\r\n                  <div class=\"separator my-3 mx-auto\"></div>\r\n                  <p class=\"fw-light fst-italic\">Thank you for your purchase!</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"modal-footer border-0\">\r\n              <button type=\"button\" class=\"btn btn-light\" data-bs-dismiss=\"modal\">Close</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- Delete Confirmation Modal -->\r\n      <div class=\"modal fade\" id=\"deleteModal\" tabindex=\"-1\" aria-labelledby=\"deleteModalLabel\" aria-hidden=\"true\">\r\n        <div class=\"modal-dialog modal-dialog-centered\">\r\n          <div class=\"modal-content border-0\">\r\n            <div class=\"modal-header border-0\">\r\n              <h5 class=\"modal-title fw-light text-danger\" id=\"deleteModalLabel\">\r\n                Confirm Delete\r\n              </h5>\r\n              <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n              <p>Are you sure you want to delete Order #{{ orderToDelete?.id }}?</p>\r\n              <p class=\"small text-muted\">This action cannot be undone.</p>\r\n            </div>\r\n            <div class=\"modal-footer border-0\">\r\n              <button type=\"button\" class=\"btn btn-light\" data-bs-dismiss=\"modal\">Cancel</button>\r\n              <button type=\"button\" class=\"btn btn-danger\" @click=\"deleteOrder\" :disabled=\"isDeleting\">\r\n                <span v-if=\"isDeleting\">\r\n                  <span class=\"spinner-border spinner-border-sm me-1\" role=\"status\" aria-hidden=\"true\"></span>\r\n                  Deleting...\r\n                </span>\r\n                <span v-else>\r\n                  <i class=\"bi bi-trash me-1\"></i> Delete\r\n                </span>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      orders: [],\r\n      filteredOrders: [],\r\n      selectedOrder: null,\r\n      orderToDelete: null,\r\n      receiptModal: null,\r\n      deleteModal: null,\r\n      isDeleting: false,\r\n      filters: {\r\n        startDate: null,\r\n        endDate: null\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    fetchAllOrders() {\r\n      const savedOrders = JSON.parse(localStorage.getItem('orders') || '[]')\r\n      this.orders = savedOrders\r\n      this.filteredOrders = [...savedOrders]\r\n    },\r\n    formatDate(dateString) {\r\n      const date = new Date(dateString)\r\n      return new Intl.DateTimeFormat('en-US', {\r\n        year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'\r\n      }).format(date)\r\n    },\r\n    openReceiptModal(order) {\r\n      this.selectedOrder = order\r\n      this.receiptModal.show()\r\n    },\r\n    confirmDelete(order) {\r\n      this.orderToDelete = order\r\n      this.deleteModal.show()\r\n    },\r\n    deleteOrder() {\r\n      if (!this.orderToDelete) return\r\n      this.isDeleting = true\r\n      setTimeout(() => {\r\n        this.orders = this.orders.filter(o => o.id !== this.orderToDelete.id)\r\n        this.filteredOrders = this.filteredOrders.filter(o => o.id !== this.orderToDelete.id)\r\n        localStorage.setItem('orders', JSON.stringify(this.orders))\r\n        this.deleteModal.hide()\r\n        this.orderToDelete = null\r\n        this.isDeleting = false\r\n        alert('Transaction deleted successfully')\r\n      }, 500)\r\n    },\r\n    applyFilters() {\r\n      if (!this.filters.startDate && !this.filters.endDate) {\r\n        this.filteredOrders = [...this.orders]\r\n        return\r\n      }\r\n      const start = this.filters.startDate ? new Date(this.filters.startDate) : null\r\n      const end = this.filters.endDate ? new Date(this.filters.endDate) : null\r\n      if (end) end.setHours(23, 59, 59, 999)\r\n      this.filteredOrders = this.orders.filter(order => {\r\n        const d = new Date(order.date_ordered)\r\n        return (!start || d >= start) && (!end || d <= end)\r\n      })\r\n    },\r\n    resetFilters() {\r\n      this.filters.startDate = null\r\n      this.filters.endDate = null\r\n      this.filteredOrders = [...this.orders]\r\n    },\r\n    calculateTotal(items) {\r\n      return items.reduce((sum, i) => sum + (i.price * i.quantity), 0)\r\n    },\r\n    initializeModal() {\r\n      this.receiptModal = new bootstrap.Modal(document.getElementById('receiptModal'))\r\n      this.deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'))\r\n    }\r\n  },\r\n  mounted() {\r\n    const isStaff = localStorage.getItem('is_staff') === 'true'\r\n    if (!isStaff) {\r\n      alert('Access denied')\r\n      this.$router.push('/login')\r\n      return\r\n    }\r\n    this.fetchAllOrders()\r\n    this.$nextTick(() => this.initializeModal())\r\n  }\r\n}\r\n</script>\r\n\r\n  \r\n  <style scoped>\r\n  /* Brown and neutral color palette */\r\n  :root {\r\n    --primary-brown: #8B6E4E;\r\n    --light-brown: #A68C69;\r\n    --dark-brown: #6F563D;\r\n    --soft-brown: #F2EAE1;\r\n    --light-beige: #F9F6F2;\r\n    --dark-beige: #E6DFD5;\r\n  }\r\n  \r\n  .text-brown {\r\n    color: var(--primary-brown);\r\n  }\r\n  \r\n  .bg-brown {\r\n    background-color: var(--primary-brown);\r\n  }\r\n  \r\n  .bg-soft-brown {\r\n    background-color: var(--soft-brown);\r\n  }\r\n  \r\n  .btn-brown {\r\n    background-color: var(--primary-brown);\r\n    color: white;\r\n    border: none;\r\n    transition: all 0.3s ease;\r\n  }\r\n  \r\n  .btn-brown:hover {\r\n    background-color: var(--dark-brown);\r\n    color: white;\r\n  }\r\n  \r\n  .btn-outline-brown {\r\n    color: var(--primary-brown);\r\n    border-color: var(--primary-brown);\r\n    background-color: transparent;\r\n    transition: all 0.3s ease;\r\n  }\r\n  \r\n  .btn-outline-brown:hover {\r\n    background-color: var(--primary-brown);\r\n    color: white;\r\n  }\r\n  \r\n  /* Typography Enhancements */\r\n  h3, h4, h5, h6 {\r\n    font-family: 'Playfair Display', Georgia, serif;\r\n  }\r\n  \r\n  body {\r\n    font-family: 'Lato', 'Helvetica Neue', Arial, sans-serif;\r\n  }\r\n  \r\n  /* Receipt Styling */\r\n  .receipt-container {\r\n    font-family: 'Lato', 'Helvetica Neue', Arial, sans-serif;\r\n    border: 1px solid var(--dark-beige);\r\n    border-radius: 8px;\r\n    background-color: var(--light-beige);\r\n  }\r\n  \r\n  .receipt-table th, .receipt-table td {\r\n    padding: 0.75rem;\r\n  }\r\n  \r\n  .separator {\r\n    height: 1px;\r\n    width: 70%;\r\n    background-color: var(--dark-beige);\r\n  }\r\n  \r\n  .card {\r\n    transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n    background-color: var(--light-beige);\r\n  }\r\n  \r\n  .card:hover {\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 10px 20px rgba(139, 110, 78, 0.1) !important;\r\n  }\r\n  \r\n  /* Print Styles */\r\n  @media print {\r\n    body * {\r\n      visibility: hidden;\r\n    }\r\n    .receipt-container, .receipt-container * {\r\n      visibility: visible;\r\n    }\r\n    .receipt-container {\r\n      position: absolute;\r\n      left: 0;\r\n      top: 0;\r\n      width: 100%;\r\n      background-color: white !important;\r\n    }\r\n  }\r\n  </style>"],"mappings":";;;;AA4LA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,EAAE;MACVC,cAAc,EAAE,EAAE;MAClBC,aAAa,EAAE,IAAI;MACnBC,aAAa,EAAE,IAAI;MACnBC,YAAY,EAAE,IAAI;MAClBC,WAAW,EAAE,IAAI;MACjBC,UAAU,EAAE,KAAK;MACjBC,OAAO,EAAE;QACPC,SAAS,EAAE,IAAI;QACfC,OAAO,EAAE;MACX;IACF;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,cAAcA,CAAA,EAAG;MACf,MAAMC,WAAU,GAAIC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,QAAQ,KAAK,IAAI;MACrE,IAAI,CAAChB,MAAK,GAAIY,WAAU;MACxB,IAAI,CAACX,cAAa,GAAI,CAAC,GAAGW,WAAW;IACvC,CAAC;IACDK,UAAUA,CAACC,UAAU,EAAE;MACrB,MAAMC,IAAG,GAAI,IAAIC,IAAI,CAACF,UAAU;MAChC,OAAO,IAAIG,IAAI,CAACC,cAAc,CAAC,OAAO,EAAE;QACtCC,IAAI,EAAE,SAAS;QAAEC,KAAK,EAAE,OAAO;QAAEC,GAAG,EAAE,SAAS;QAAEC,IAAI,EAAE,SAAS;QAAEC,MAAM,EAAE;MAC5E,CAAC,CAAC,CAACC,MAAM,CAACT,IAAI;IAChB,CAAC;IACDU,gBAAgBA,CAACC,KAAK,EAAE;MACtB,IAAI,CAAC5B,aAAY,GAAI4B,KAAI;MACzB,IAAI,CAAC1B,YAAY,CAAC2B,IAAI,CAAC;IACzB,CAAC;IACDC,aAAaA,CAACF,KAAK,EAAE;MACnB,IAAI,CAAC3B,aAAY,GAAI2B,KAAI;MACzB,IAAI,CAACzB,WAAW,CAAC0B,IAAI,CAAC;IACxB,CAAC;IACDE,WAAWA,CAAA,EAAG;MACZ,IAAI,CAAC,IAAI,CAAC9B,aAAa,EAAE;MACzB,IAAI,CAACG,UAAS,GAAI,IAAG;MACrB4B,UAAU,CAAC,MAAM;QACf,IAAI,CAAClC,MAAK,GAAI,IAAI,CAACA,MAAM,CAACmC,MAAM,CAACC,CAAA,IAAKA,CAAC,CAACC,EAAC,KAAM,IAAI,CAAClC,aAAa,CAACkC,EAAE;QACpE,IAAI,CAACpC,cAAa,GAAI,IAAI,CAACA,cAAc,CAACkC,MAAM,CAACC,CAAA,IAAKA,CAAC,CAACC,EAAC,KAAM,IAAI,CAAClC,aAAa,CAACkC,EAAE;QACpFtB,YA