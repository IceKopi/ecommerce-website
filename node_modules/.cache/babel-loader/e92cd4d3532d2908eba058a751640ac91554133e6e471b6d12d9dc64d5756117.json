{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from '../axios';\nimport { auth } from '../auth';\nexport default {\n  name: 'UserLogin',\n  data() {\n    return {\n      username: '',\n      password: ''\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        // Step 1: Get access and refresh tokens\n        const res = await axios.post('token/', {\n          username: this.username,\n          password: this.password\n        });\n        localStorage.setItem('access', res.data.access);\n        localStorage.setItem('refresh', res.data.refresh);\n        auth.isLoggedIn = true;\n\n        // Step 2: Get user info\n        const user = await axios.get('user/');\n        localStorage.setItem('is_staff', user.data.is_staff);\n        auth.isStaff = user.data.is_staff;\n\n        // Step 3: Redirect based on role\n        this.$router.push(user.data.is_staff ? '/monitor' : '/products');\n      } catch (err) {\n        alert('Login failed: Check your username or password.');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","auth","name","data","username","password","methods","login","res","post","localStorage","setItem","access","refresh","isLoggedIn","user","get","is_staff","isStaff","$router","push","err","alert"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\views\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-5\">\r\n    <h2 class=\"mb-4\">Login</h2>\r\n    <form @submit.prevent=\"login\">\r\n      <input v-model=\"username\" placeholder=\"Username\" class=\"form-control mb-2\" />\r\n      <input v-model=\"password\" type=\"password\" placeholder=\"Password\" class=\"form-control mb-3\" />\r\n      <button class=\"btn btn-primary w-100\">Login</button>\r\n    </form>\r\n    <p class=\"mt-3 text-center\">\r\n      Don't have an account? <router-link to=\"/register\">Register here</router-link>\r\n    </p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\nimport { auth } from '../auth'\r\n\r\nexport default {\r\n  name: 'UserLogin',\r\n  data() {\r\n    return {\r\n      username: '',\r\n      password: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        // Step 1: Get access and refresh tokens\r\n        const res = await axios.post('token/', {\r\n          username: this.username,\r\n          password: this.password\r\n        })\r\n        localStorage.setItem('access', res.data.access)\r\n        localStorage.setItem('refresh', res.data.refresh)\r\n        auth.isLoggedIn = true\r\n\r\n        // Step 2: Get user info\r\n        const user = await axios.get('user/')\r\n        localStorage.setItem('is_staff', user.data.is_staff)\r\n        auth.isStaff = user.data.is_staff\r\n\r\n        // Step 3: Redirect based on role\r\n        this.$router.push(user.data.is_staff ? '/monitor' : '/products')\r\n\r\n      } catch (err) {\r\n        alert('Login failed: Check your username or password.')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":";AAeA,OAAOA,KAAI,MAAO,UAAS;AAC3B,SAASC,IAAG,QAAS,SAAQ;AAE7B,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,KAAKA,CAAA,EAAG;MACZ,IAAI;QACF;QACA,MAAMC,GAAE,GAAI,MAAMR,KAAK,CAACS,IAAI,CAAC,QAAQ,EAAE;UACrCL,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC;QACDK,YAAY,CAACC,OAAO,CAAC,QAAQ,EAAEH,GAAG,CAACL,IAAI,CAACS,MAAM;QAC9CF,YAAY,CAACC,OAAO,CAAC,SAAS,EAAEH,GAAG,CAACL,IAAI,CAACU,OAAO;QAChDZ,IAAI,CAACa,UAAS,GAAI,IAAG;;QAErB;QACA,MAAMC,IAAG,GAAI,MAAMf,KAAK,CAACgB,GAAG,CAAC,OAAO;QACpCN,YAAY,CAACC,OAAO,CAAC,UAAU,EAAEI,IAAI,CAACZ,IAAI,CAACc,QAAQ;QACnDhB,IAAI,CAACiB,OAAM,GAAIH,IAAI,CAACZ,IAAI,CAACc,QAAO;;QAEhC;QACA,IAAI,CAACE,OAAO,CAACC,IAAI,CAACL,IAAI,CAACZ,IAAI,CAACc,QAAO,GAAI,UAAS,GAAI,WAAW;MAEjE,EAAE,OAAOI,GAAG,EAAE;QACZC,KAAK,CAAC,gDAAgD;MACxD;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourc