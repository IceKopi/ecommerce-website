ds</router-link></li>\r\n                  <li><hr class=\"dropdown-divider\"></li>\r\n                  <li><router-link to=\"/shop/new\" class=\"dropdown-item\">New Arrivals</router-link></li>\r\n                  <li><router-link to=\"/shop/sale\" class=\"dropdown-item\">Sale</router-link></li>\r\n                </ul>\r\n              </li>\r\n              <li class=\"nav-item\">\r\n                <router-link to=\"/collections\" class=\"nav-link\">Collections</router-link>\r\n              </li>\r\n              <li class=\"nav-item\">\r\n                <router-link to=\"/about\" class=\"nav-link\">About</router-link>\r\n              </li>\r\n            </ul>\r\n            <div class=\"d-flex align-items-center\">\r\n              <div class=\"input-group me-3\">\r\n                <input class=\"form-control\" type=\"search\" placeholder=\"Search products...\" v-model=\"searchQuery\">\r\n                <button class=\"btn btn-light\" type=\"submit\" @click=\"search\">\r\n                  <i class=\"fas fa-search\"></i>\r\n                </button>\r\n              </div>\r\n              <div class=\"d-flex\">\r\n                <router-link to=\"/account\" class=\"btn btn-outline-light me-2\">\r\n                  <i class=\"fas fa-user\"></i>\r\n                </router-link>\r\n                <router-link to=\"/cart\" class=\"btn btn-outline-light position-relative\">\r\n                  <i class=\"fas fa-shopping-cart\"></i>\r\n                  <span v-if=\"cartCount > 0\" class=\"position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger\">\r\n                    {{ cartCount }}\r\n                  </span>\r\n                </router-link>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </nav>\r\n  \r\n      <!-- Hero Section -->\r\n      <section class=\"hero-section\">\r\n        <div class=\"container text-center\">\r\n          <h1 class=\"display-4 fw-bold mb-4\">Summer Collection 2025</h1>\r\n          <p class=\"lead mb-4\">Discover the latest trends in fashion with our new summer collection</p>\r\n          <div class=\"d-flex justify-content-center gap-3\">\r\n            <router-link to=\"/shop/men\" class=\"btn btn-light btn-lg px-4\">Shop Men</router-link>\r\n            <router-link to=\"/shop/women\" class=\"btn btn-outline-light btn-lg px-4\">Shop Women</router-link>\r\n          </div>\r\n          <div class=\"mt-4\">\r\n            <router-link to=\"/products\" class=\"btn btn-primary m-2\">View Products</router-link>\r\n            <router-link to=\"/login\" class=\"btn btn-outline-secondary m-2\">Login</router-link>\r\n            <router-link to=\"/register\" class=\"btn btn-outline-success m-2\">Register</router-link>\r\n          </div>\r\n        </div>\r\n      </section>\r\n  \r\n      <!-- Categories Section -->\r\n      <section class=\"py-5\">\r\n        <div class=\"container\">\r\n          <h2 class=\"text-center mb-5\">Shop By Category</h2>\r\n          <div class=\"row g-4\">\r\n            <div v-for=\"(category, index) in categories\" :key=\"index\" class=\"col-6 col-md-3\">\r\n              <router-link :to=\"category.link\" class=\"text-decoration-none\">\r\n                <div class=\"category-item\">\r\n                  <div class=\"category-icon\">\r\n                    <i :class=\"category.icon\"></i>\r\n                  </div>\r\n                  <h5>{{ category.name }}</h5>\r\n                </div>\r\n              </router-link>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n  \r\n      <!-- Featured Products -->\r\n      <section class=\"py-5 bg-light\">\r\n        <div class=\"container\">\r\n          <div class=\"d-flex justify-content-between align-items-center mb-4\">\r\n            <h2>Featured Products</h2>\r\n            <router-link to=\"/products\" class=\"btn btn-outline-primary\">View All</router-link>\r\n          </div>\r\n          <div class=\"row\">\r\n            <div v-for=\"(product, index) in featuredProducts\" :key=\"index\" class=\"col-6 col-md-3\">\r\n              <div class=\"card h-100\">\r\n                <div v-if=\"product.discount\" class=\"discount-badge\">-{{ product.discount }}%</div>\r\n                <div v-if=\"product.isNew\" class=\"discount-badge\">New!</div>\r\n                <img :src=\"product.image\" class=\"card-img-top\" :alt=\"product.title\">\r\n                <div class=\"card-body\">\r\n                  <h5 class=\"card-title\">{{ product.title }}</h5>\r\n                  <div class=\"d-flex justify-content-between align-items-center\">\r\n                    <div>\r\n                      <span v-if=\"product.originalPrice\" class=\"text-muted text-decoration-line-through\">${{ product.originalPrice }}</span>\r\n                      <span class=\"ms-2 fw-bold text-primary\">${{ product.price }}</span>\r\n                    </div>\r\n                    <div class=\"text-warning\">\r\n                      <i v-for=\"n in 5\" :key=\"n\" :class=\"n <= product.rating ? 'fas fa-star' : (n - 0.5 <= product.rating ? 'fas fa-star-half-alt' : 'far fa-star')\"></i>\r\n                    </div>\r\n                  </div>\r\n                  <button class=\"btn btn-primary w-100 mt-3\" @click=\"addToCart(product)\">Add to Cart</button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n  \r\n      <!-- Special Offer Banner -->\r\n      <section class=\"py-5 bg-primary text-white\">\r\n        <div class=\"container\">\r\n          <div class=\"row align-items-center\">\r\n            <div class=\"col-md-8\">\r\n              <h2 class=\"mb-3\">Special Summer Sale!</h2>\r\n              <p class=\"lead mb-4\">Get up to 50% off on selected items. Limited time offer.</p>\r\n              <router-link to=\"/shop/sale\" class=\"btn btn-light btn-lg\">Shop Now</router-link>\r\n            </div>\r\n            <div class=\"col-md-4 text-center\">\r\n              <img src=\"https://via.placeholder.com/300\" alt=\"Special Offer\" class=\"img-fluid rounded-circle mt-4 mt-md-0\" style=\"max-width: 200px;\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n  \r\n      <!-- Newsletter -->\r\n      <section class=\"py-5 bg-light\">\r\n        <div class=\"container\">\r\n          <div class=\"row justify-content-center\">\r\n            <div class=\"col-md-8 text-center\">\r\n              <h3>Subscribe to Our Newsletter</h3>\r\n              <p class=\"text-muted mb-4\">Get the latest updates about new products and special offers</p>\r\n              <div class=\"input-group mb-3\">\r\n                <input type=\"email\" class=\"form-control\" placeholder=\"Enter your email address\" v-model=\"email\">\r\n                <button class=\"btn btn-primary\" type=\"button\" @click=\"subscribe\">Subscribe</button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n  \r\n      <!-- Footer -->\r\n      <footer class=\"footer\">\r\n        <div class=\"container\">\r\n          <div class=\"row g-4\">\r\n            <div class=\"col-md-4\">\r\n              <h5 class=\"mb-3\">StyleHub</h5>\r\n              <p class=\"text-muted\">Your one-stop destination for premium fashion. We offer a wide range of clothing for men, women, and kids.</p>\r\n              <div class=\"d-flex gap-3 mt-3\">\r\n                <a href=\"#\" class=\"text-primary fs-5\"><i class=\"fab fa-facebook\"></i></a>\r\n                <a href=\"#\" class=\"text-primary fs-5\"><i class=\"fab fa-instagram\"></i></a>\r\n                <a href=\"#\" class=\"text-primary fs-5\"><i class=\"fab fa-twitter\"></i></a>\r\n                <a href=\"#\" class=\"text-primary fs-5\"><i class=\"fab fa-pinterest\"></i></a>\r\n              </div>\r\n            </div>\r\n            <div class=\"col-md-2\">\r\n              <h5 class=\"mb-3\">Shop</h5>\r\n              <ul class=\"list-unstyled\">\r\n                <li class=\"mb-2\"><router-link to=\"/shop/men\" class=\"text-decoration-none text-muted\">Men</router-link></li>\r\n                <li class=\"mb-2\"><router-link to=\"/shop/women\" class=\"text-decoration-none text-muted\">Women</router-link></li>\r\n                <li class=\"mb-2\"><router-link to=\"/shop/kids\" class=\"text-decoration-none text-muted\">Kids</router-link></li>\r\n                <li class=\"mb-2\"><router-link to=\"/shop/accessories\" class=\"text-decoration-none text-muted\">Accessories</router-link></li>\r\n                <li class=\"mb-2\"><router-link to=\"/shop/sale\" class=\"text-decoration-none text-muted\">Sale</router-link></li>\r\n              </ul>\r\n            </div>\r\n            <div class=\"col-md-2\">\r\n              <h5 class=\"mb-3\">Company</h5>\r\n              <ul class=\"list-unstyled\">\r\n                <li class=\"mb-2\"><router-link to=\"/about\" class=\"text-decoration-none text-muted\">About Us</router-link></li>\r\n                <li class=\"mb-2\"><router-link to=\"/contact\" class=\"text-decoration-none text-muted\">Contact</router-link></li>\r\n                <li class=\"mb-2\"><router-link to=\"/careers\" class=\"text-decoration-none text-muted\">Careers</router-link></li>\r\n                <li class=\"mb-2\"><router-link to=\"/stores\" class=\"text-decoration-none text-muted\">Store Locations</router-link></li>\r\n              </ul>\r\n            </div>\r\n            <div class=\"col-md-4\">\r\n              <h5 class=\"mb-3\">Customer Service</h5>\r\n              <ul class=\"list-unstyled\">\r\n                <li class=\"mb-2\"><router-link to=\"/help\" class=\"text-decoration-none text-muted\">Help Center</router-link></li>\r\n                <li class=\"mb-2\"><router-link to=\"/track-order\" class=\"text-decoration-none text-muted\">Track Your Order</router-link></li>\r\n                <li 