ice: null,\r\n            discount: null,\r\n            rating: 4,\r\n            image: 'https://via.placeholder.com/300x400',\r\n            isNew: false\r\n          },\r\n          {\r\n            id: 3,\r\n            title: 'Summer Floral Dress',\r\n            price: 59.99,\r\n            originalPrice: null,\r\n            discount: null,\r\n            rating: 5,\r\n            image: 'https://via.placeholder.com/300x400',\r\n            isNew: true\r\n          },\r\n          {\r\n            id: 4,\r\n            title: 'Casual Hoodie',\r\n            price: 39.99,\r\n            originalPrice: null,\r\n            discount: null,\r\n            rating: 3.5,\r\n            image: 'https://via.placeholder.com/300x400',\r\n            isNew: false\r\n          }\r\n        ]\r\n      }\r\n    },\r\n    methods: {\r\n      search() {\r\n        // Implement search functionality\r\n        console.log('Searching for:', this.searchQuery);\r\n        // You would typically use this.$router.push to navigate to search results\r\n      },\r\n      addToCart(product) {\r\n        // Implement add to cart functionality\r\n        console.log('Adding to cart:', product);\r\n        this.cartCount++;\r\n        // You would typically update your store/state here\r\n      },\r\n      subscribe() {\r\n        // Implement newsletter subscription\r\n        if (this.email) {\r\n          console.log('Subscribing email:', this.email);\r\n          alert('Thank you for subscribing!');\r\n          this.email = '';\r\n        } else {\r\n          alert('Please enter a valid email address');\r\n        }\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  :root {\r\n    --primary-blue: #1a73e8;\r\n    --secondary-blue: #4285f4;\r\n    --dark-blue: #0d47a1;\r\n    --light-blue: #e8f0fe;\r\n  }\r\n  \r\n  .navbar {\r\n    background-color: var(--primary-blue);\r\n  }\r\n  \r\n  .hero-section {\r\n    background: linear-gradient(135deg, #4285f4 0%, #0d4