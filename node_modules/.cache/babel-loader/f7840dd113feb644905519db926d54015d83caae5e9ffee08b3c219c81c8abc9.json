{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { auth } from './auth';\nexport default {\n  setup() {\n    return {\n      auth\n    };\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart');\n      localStorage.clear();\n      localStorage.setItem('cart', cart);\n      auth.isLoggedIn = false; // ✅ Reset reactivity\n      auth.isStaff = false;\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["auth","setup","methods","logout","cart","localStorage","getItem","clear","setItem","isLoggedIn","isStaff","$router","push"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <nav class=\"navbar navbar-expand-lg navbar-light bg-light px-4\">\n    <router-link\n      class=\"navbar-brand\"\n      :to=\"auth.isLoggedIn ? (auth.isStaff ? '/monitor' : '/products') : '/login'\"\n    >\n      E-Store Bogsh\n    </router-link>\n\n    <div class=\"collapse navbar-collapse\">\n      <ul class=\"navbar-nav me-auto mb-2 mb-lg-0\">\n        <!-- STAFF NAVIGATION -->\n         <!-- Inside the staff section of the navbar -->\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/monitor-products\">📦 Monitor Products</router-link>\n        </li>\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/add-product\">➕ Add Product</router-link>\n        </li>\n\n        <!-- CUSTOMER NAVIGATION -->\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/products\">Home</router-link>\n        </li>\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/cart\">Cart</router-link>\n        </li>\n        <li class=\"nav-item\" v-if=\"auth.isLoggedIn && !auth.isStaff\">\n          <router-link class=\"nav-link\" to=\"/orders\">My Orders</router-link>\n        </li>\n      </ul>\n\n      <ul class=\"navbar-nav ms-auto\">\n  <!-- ✅ Show Login/Register only if LOGGED OUT -->\n  <li class=\"nav-item\" v-if=\"!auth.isLoggedIn\">\n    <router-link\n      class=\"nav-link\"\n      v-if=\"$route.name === 'register'\"\n      to=\"/login\"\n    >Login</router-link>\n   \n  </li>\n\n  <!-- ✅ Show Logout if LOGGED IN -->\n  <li class=\"nav-item\" v-if=\"auth.isLoggedIn\">\n    <button class=\"btn btn-outline-danger\" @click=\"logout\">Logout</button>\n  </li>\n</ul>\n\n    </div>\n  </nav>\n\n  <router-view />\n</template>\n\n<script>\nimport { auth } from './auth'\n\nexport default {\n  setup() {\n    return { auth }\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart')\n      localStorage.clear()\n      localStorage.setItem('cart', cart)\n\n      auth.isLoggedIn = false        // ✅ Reset reactivity\n      auth.isStaff = false\n\n      this.$router.push('/login')\n    }\n  }\n}\n</script>"],"mappings":";AAwDA,SAASA,IAAG,QAAS,QAAO;AAE5B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,OAAO;MAAED;IAAK;EAChB,CAAC;EACDE,OAAO,EAAE;IACPC,MAAMA,CAAA,EAAG;MACP,MAAMC,IAAG,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;MACxCD,YAAY,CAACE,KAAK,CAAC;MACnBF,YAAY,CAACG,OAAO,CAAC,MAAM,EAAEJ,IAAI;MAEjCJ,IAAI,CAACS,UAAS,GAAI,KAAI,EAAS;MAC/BT,IAAI,CAACU,OAAM,GAAI,KAAI;MAEnB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ;IAC5B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}