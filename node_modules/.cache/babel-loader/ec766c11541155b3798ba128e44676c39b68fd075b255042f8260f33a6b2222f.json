_hoisted_9","clearCart","_hoisted_10"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ShoppingCart.vue"],"sourcesContent":["<template>\r\n  <div class=\"container mt-3\">\r\n    <h2>My Cart</h2>\r\n    <div v-if=\"isLoading\" class=\"text-center\">\r\n      <div class=\"spinner-border text-primary\" role=\"status\">\r\n        <span class=\"visually-hidden\">Loading...</span>\r\n      </div>\r\n    </div>\r\n    <div v-else-if=\"!cartItems || cartItems.length === 0\">Cart is empty.</div>\r\n    <ul class=\"list-group mb-3\" v-else>\r\n      <li v-for=\"item in cartItems\" :key=\"item.id\" class=\"list-group-item d-flex justify-content-between align-items-center\">\r\n        <div>\r\n          <strong>{{ item.product_name }}</strong> x {{ item.quantity }}\r\n          <span class=\"badge bg-secondary ms-2\">₱{{ (item.price * item.quantity).toFixed(2) }}</span>\r\n        </div>\r\n        <button @click=\"removeItem(item)\" class=\"btn btn-sm btn-outline-danger\">\r\n          <i class=\"bi bi-trash\"></i>\r\n        </button>\r\n      </li>\r\n      <li class=\"list-group-item d-flex justify-content-between\">\r\n        <strong>Total:</strong>\r\n        <strong>₱{{ cartTotal.toFixed(2) }}</strong>\r\n      </li>\r\n    </ul>\r\n    <div class=\"d-flex justify-content-between\">\r\n      <button @click=\"checkout\" class=\"btn btn-success\" :disabled=\"!cartItems || cartItems.length === 0 || isProcessing\">\r\n        {{ isProcessing ? 'Processing...' : 'Checkout' }}\r\n      </button>\r\n      <button @click=\"clearCart\" class=\"btn btn-outline-secondary\" :disabled=\"!cartItems || cartItems.length === 0 || isProcessing\">\r\n        Clear Cart\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '../axios'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      cartItems: [],\r\n      isProcessing: false,\r\n      isLoading: true,\r\n      localCart: []\r\n    }\r\n  },\r\n  computed: {\r\n    cartTotal() {\r\n      return this.cartItems.reduce((total, item) => {\r\n        return total + (parseFloat(item.price) * item.quantity)\r\n      }, 0)\r\n    }\r\n  },\r\n  async mounted() {\r\n    // Load local cart first for quick display\r\n    const stored = localStorage.getItem('cart')\r\n    this.localCart = stored ? JSON.parse(stored) : []\r\n    \r\n    // Then fetch the actual cart from backend\r\n    await this.fetchCart()\r\n  },\r\n  methods: {\r\n    async fetchCart() {\r\n      this.isLoading = true\r\n      try {\r\n        // Get current cart from backend\r\n        const response = await axios.get('cart/current/')\r\n        \r\n        if (response.data && response.data.items) {\r\n          this.cartItems = response.data.items\r\n          \r\n          // Sync with local storage\r\n          localStorage.setItem('cart', JSON.stringify(this.cartItems))\r\n        } else {\r\n          this.cartItems = []\r\n        }\r\n      } catch (err) {\r\n        console.error('Error fetching cart:', err)\r\n        // Fall back to local storage if backend fails\r\n        this.cartItems = this.localCart\r\n      } finally {\r\n        this.isLoading = false\r\n      }\r\n    },\r\n    \r\n    async removeItem(item) {\r\n      // Would need a backend endpoint for this\r\n      // For now we'll just show how it would work\r\n      alert('Remove functionality would require an additional API endpoint')\r\n    },\r\n    \r\n    async clearCart() {\r\n      // Would need a backend endpoint for this\r\n      if (confirm('Are you sure you want to clear your cart?')) {\r\n        localStorage.removeItem('cart')\r\n        this.cartItems = []\r\n        // In a real implementation, you'd also clear the cart on the backend\r\n      }\r\n    },\r\n    \r\n    async checkout() {\r\n      this.isProcessing = true\r\n      try {\r\n        // Send each item from local storage to backend\r\n        const stored = localStorage.getItem('cart')\r\n        const localItems = stored ? JSON.parse(stored) : []\r\n        \r\n        // Only add items that don't exist in backend yet\r\n        for (const item of localItems) {\r\n          const exists = this.cartItems.some(\r\n            backendItem => backendItem.product === item.id\r\n          )\r\n          \r\n          if (!exists) {\r\n            await axios.post('order-items/', {\r\n              product: item.id,\r\n              quantity: item.quantity\r\n            })\r\n          }\r\n        }\r\n\r\n        // Complete the order\r\n        await axios.put('orders/complete/')\r\n\r\n        // Clear local storage\r\n        localStorage.removeItem('cart')\r\n        \r\n        // Show success message\r\n        alert('✅ Order placed successfully!')\r\n        \r\n        // Refresh cart from backend (should be empty now)\r\n        await this.fetchCart()\r\n      } catch (err) {\r\n        console.error('Checkout error:', err)\r\n        if (err.response && err.response.data) {\r\n          alert(`❌ ${err.response.data.detail || 'Failed to complete checkout. Please try again.'}`)\r\n        } else {\r\n          alert('❌ Failed to complete checkout. Please try again.')\r\n        }\r\n      } finally {\r\n        this.isProcessing = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":";;EACOA,KAAK,EAAC;AAAgB;;EAD7BC,GAAA;EAG0BD,KAAK,EAAC;;;EAHhCC,GAAA;AAAA;;EAAAA,GAAA;EASQD,KAAK,EAAC;;;EAIEA,KAAK,EAAC;AAAyB;mBAb/C;;EAmBUA,KAAK,EAAC;AAAgD;;EAKvDA,KAAK,EAAC;AAAgC;mBAxB/C;oBAAA;;uBACEE,mBAAA,CA+BM,OA/BNC,UA+BM,G,0BA9BJC,mBAAA,CAAgB,YAAZ,SAAO,sBACAC,KAAA,CAAAC,SAAS,I,cAApBJ,mBAAA,CAIM,OAJNK,UAIM,EAAAC,MAAA,QAAAA,MAAA,OAHJJ,mBAAA,CAEM;IAFDJ,KAAK,EAAC,6BAA6B;IAACS,IAAI,EAAC;MAC5CL,mBAAA,CAA+C;IAAzCJ,KAAK,EAAC;EAAiB,GAAC,YAAU,E,2BAG3BK,KAAA,CAAAK,SAAS,IAAIL,KAAA,CAAAK,SAAS,CAACC,MAAM,U,cAA9CT,mBAAA,CAA0E,OAR9EU,UAAA,EAQ0D,gBAAc,M,cACpEV,mBAAA,CAcK,MAdLW,UAcK,I,kBAbHX,mBAAA,CAQKY,SAAA,QAlBXC,WAAA,CAUyBV,KAAA,CAAAK,SAAS,EAAjBM,IAAI;yBAAfd,m