{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport { ref, computed, onMounted } from 'vue';\nimport { auth } from './auth';\nexport default {\n  setup() {\n    const cartCount = ref(0);\n    const updateCartCount = () => {\n      try {\n        const cart = JSON.parse(localStorage.getItem('cart') || '{}');\n        cartCount.value = Object.values(cart).reduce((total, item) => total + item.quantity, 0);\n      } catch (e) {\n        cartCount.value = 0;\n        console.error('Error parsing cart:', e);\n      }\n    };\n    onMounted(() => {\n      updateCartCount();\n      window.addEventListener('storage', updateCartCount);\n    });\n    return {\n      auth,\n      cartCount\n    };\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart');\n      localStorage.clear();\n      localStorage.setItem('cart', cart);\n      auth.isLoggedIn = false;\n      auth.isStaff = false;\n      auth.username = null;\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","auth","setup","cartCount","updateCartCount","cart","JSON","parse","localStorage","getItem","value","Object","values","reduce","total","item","quantity","e","console","error","window","addEventListener","methods","logout","clear","setItem","isLoggedIn","isStaff","username","$router","push"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <nav class=\"navbar navbar-expand-lg shadow-sm py-3\">\n    <div class=\"container\">\n      <!-- Logo/Brand -->\n      <router-link\n        class=\"navbar-brand fw-bold text-primary d-flex align-items-center\"\n        :to=\"auth.isLoggedIn ? (auth.isStaff ? '/monitor' : '/products') : '/login'\"\n      >\n        <i class=\"bi bi-bag-check me-2\"></i>\n        <span>ELEGANCE</span>\n      </router-link>\n\n      <!-- Mobile Toggle -->\n      <button \n        class=\"navbar-toggler border-0\" \n        type=\"button\" \n        data-bs-toggle=\"collapse\" \n        data-bs-target=\"#navbarContent\"\n        aria-controls=\"navbarContent\"\n        aria-expanded=\"false\" \n      >\n        <span class=\"navbar-toggler-icon\"></span>\n      </button>\n\n      <!-- Navigation Items -->\n      <div class=\"collapse navbar-collapse\" id=\"navbarContent\">\n        <ul class=\"navbar-nav mx-auto mb-0\">\n          <!-- STAFF NAVIGATION -->\n          <template v-if=\"auth.isLoggedIn && auth.isStaff\">\n            <li class=\"nav-item mx-2\">\n              <router-link class=\"nav-link position-relative px-3\" to=\"/monitor-products\">\n                <i class=\"bi bi-grid me-1\"></i> Inventory\n              </router-link>\n            </li>\n            <li class=\"nav-item mx-2\">\n              <router-link class=\"nav-link position-relative px-3\" to=\"/add-product\">\n                <i class=\"bi bi-plus-circle me-1\"></i> New Product\n              </router-link>\n            </li>\n            <li class=\"nav-item mx-2\">\n              <router-link class=\"nav-link position-relative px-3\" to=\"/analytics\">\n                <i class=\"bi bi-graph-up me-1\"></i> Analytics\n              </router-link>\n            </li>\n          </template>\n\n          <!-- CUSTOMER NAVIGATION -->\n          <template v-if=\"auth.isLoggedIn && !auth.isStaff\">\n            <li class=\"nav-item mx-2\">\n              <router-link class=\"nav-link position-relative px-3\" to=\"/products\">\n                <i class=\"bi bi-shop me-1\"></i> Shop\n              </router-link>\n            </li>\n            <li class=\"nav-item mx-2\">\n              <router-link class=\"nav-link position-relative px-3\" to=\"/cart\">\n                <i class=\"bi bi-cart me-1\"></i> Cart\n                <span v-if=\"cartCount > 0\" class=\"position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger\">\n                  {{ cartCount }}\n                </span>\n              </router-link>\n            </li>\n            <li class=\"nav-item mx-2\">\n              <router-link class=\"nav-link position-relative px-3\" to=\"/orders\">\n                <i class=\"bi bi-box me-1\"></i> Orders\n              </router-link>\n            </li>\n            <li class=\"nav-item mx-2\">\n              <router-link class=\"nav-link position-relative px-3\" to=\"/wishlist\">\n                <i class=\"bi bi-heart me-1\"></i> Wishlist\n              </router-link>\n            </li>\n          </template>\n        </ul>\n\n        <!-- Auth Controls -->\n        <div class=\"d-flex\">\n          <template v-if=\"!auth.isLoggedIn\">\n            <router-link \n              v-if=\"$route.name === 'register'\" \n              to=\"/login\"\n              class=\"btn btn-outline-primary rounded-pill px-4 me-2\"\n            >\n              Sign In\n            </router-link>\n            <router-link \n              v-else \n              to=\"/register\"\n              class=\"btn btn-outline-primary rounded-pill px-4 me-2\"\n            >\n              Register\n            </router-link>\n          </template>\n          \n          <template v-else>\n            <div class=\"dropdown me-3\">\n              <button \n                class=\"btn btn-link text-decoration-none dropdown-toggle text-dark p-0\" \n                type=\"button\" \n                id=\"userDropdown\" \n                data-bs-toggle=\"dropdown\" \n                aria-expanded=\"false\"\n              >\n                <i class=\"bi bi-person-circle me-1\"></i>\n                <span class=\"small\">{{ auth.username || 'Account' }}</span>\n              </button>\n              <ul class=\"dropdown-menu dropdown-menu-end shadow-sm border-0\" aria-labelledby=\"userDropdown\">\n                <li><router-link class=\"dropdown-item\" to=\"/profile\"><i class=\"bi bi-person me-2\"></i>Profile</router-link></li>\n                <li><router-link class=\"dropdown-item\" to=\"/settings\"><i class=\"bi bi-gear me-2\"></i>Settings</router-link></li>\n                <li><hr class=\"dropdown-divider\"></li>\n                <li><a class=\"dropdown-item text-danger\" href=\"#\" @click.prevent=\"logout\"><i class=\"bi bi-box-arrow-right me-2\"></i>Sign Out</a></li>\n              </ul>\n            </div>\n          </template>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n  <router-view />\n</template>\n\n<script>\nimport { ref, computed, onMounted } from 'vue'\nimport { auth } from './auth'\n\nexport default {\n  setup() {\n    const cartCount = ref(0)\n\n    const updateCartCount = () => {\n      try {\n        const cart = JSON.parse(localStorage.getItem('cart') || '{}')\n        cartCount.value = Object.values(cart).reduce((total, item) => total + item.quantity, 0)\n      } catch (e) {\n        cartCount.value = 0\n        console.error('Error parsing cart:', e)\n      }\n    }\n\n    onMounted(() => {\n      updateCartCount()\n      window.addEventListener('storage', updateCartCount)\n    })\n\n    return { \n      auth,\n      cartCount\n    }\n  },\n  methods: {\n    logout() {\n      const cart = localStorage.getItem('cart')\n      localStorage.clear()\n      localStorage.setItem('cart', cart)\n\n      auth.isLoggedIn = false\n      auth.isStaff = false\n      auth.username = null\n\n      this.$router.push('/login')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.navbar {\n  background-color: #ffffff;\n  transition: all 0.3s ease;\n}\n\n.navbar-brand {\n  font-family: 'Montserrat', sans-serif;\n  letter-spacing: 1px;\n}\n\n.nav-link {\n  font-weight: 500;\n  transition: color 0.2s;\n  font-size: 0.95rem;\n}\n\n.nav-link:hover {\n  color: var(--bs-primary);\n}\n\n.nav-link.router-link-active {\n  color: var(--bs-primary);\n  position: relative;\n}\n\n.nav-link.router-link-active::after {\n  content: '';\n  position: absolute;\n  bottom: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 20px;\n  height: 2px;\n  background-color: var(--bs-primary);\n}\n\n.dropdown-item {\n  font-size: 0.9rem;\n  padding: 0.5rem 1.5rem;\n}\n\n.dropdown-item:active {\n  background-color: var(--bs-primary);\n}\n\n/* Add this to your app's global styles to ensure Bootstrap icons work */\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css\");\n</style>"],"mappings":";;;AA0HA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAI;AAC7C,SAASC,IAAG,QAAS,QAAO;AAE5B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIL,GAAG,CAAC,CAAC;IAEvB,MAAMM,eAAc,GAAIA,CAAA,KAAM;MAC5B,IAAI;QACF,MAAMC,IAAG,GAAIC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,MAAM,KAAK,IAAI;QAC5DN,SAAS,CAACO,KAAI,GAAIC,MAAM,CAACC,MAAM,CAACP,IAAI,CAAC,CAACQ,MAAM,CAAC,CAACC,KAAK,EAAEC,IAAI,KAAKD,KAAI,GAAIC,IAAI,CAACC,QAAQ,EAAE,CAAC;MACxF,EAAE,OAAOC,CAAC,EAAE;QACVd,SAAS,CAACO,KAAI,GAAI;QAClBQ,OAAO,CAACC,KAAK,CAAC,qBAAqB,EAAEF,CAAC;MACxC;IACF;IAEAjB,SAAS,CAAC,MAAM;MACdI,eAAe,CAAC;MAChBgB,MAAM,CAACC,gBAAgB,CAAC,SAAS,EAAEjB,eAAe;IACpD,CAAC;IAED,OAAO;MACLH,IAAI;MACJE;IACF;EACF,CAAC;EACDmB,OAAO,EAAE;IACPC,MAAMA,CAAA,EAAG;MACP,MAAMlB,IAAG,GAAIG,YAAY,CAACC,OAAO,CAAC,MAAM;MACxCD,YAAY,CAACgB,KAAK,CAAC;MACnBhB,YAAY,CAACiB,OAAO,CAAC,MAAM,EAAEpB,IAAI;MAEjCJ,IAAI,CAACyB,UAAS,GAAI,KAAI;MACtBzB,IAAI,CAAC0B,OAAM,GAAI,KAAI;MACnB1B,IAAI,CAAC2B,QAAO,GAAI,IAAG;MAEnB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ;IAC5B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}