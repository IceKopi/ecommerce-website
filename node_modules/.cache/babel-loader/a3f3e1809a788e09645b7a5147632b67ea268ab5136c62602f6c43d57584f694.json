{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport axios from '../axios';\nexport default {\n  data() {\n    return {\n      products: [],\n      cart: [],\n      // ✅ Initialized as array\n      searchQuery: ''\n    };\n  },\n  computed: {\n    filteredProducts() {\n      if (!this.searchQuery) return this.products;\n      const q = this.searchQuery.toLowerCase();\n      return this.products.filter(p => p.name.toLowerCase().includes(q) || p.description.toLowerCase().includes(q));\n    }\n  },\n  methods: {\n    buttonText(product) {\n      if (product.stock === 0) return 'Out of Stock';\n      if (this.hasReachedLimit(product)) return 'Max Quantity Reached';\n      return 'Add to Cart';\n    },\n    fullImageUrl(path) {\n      if (!path) return '';\n      return path.startsWith('http') ? path : `http://127.0.0.1:8000${path.startsWith('/') ? path : '/media/' + path}`;\n    },\n    loadCart() {\n      try {\n        const stored = localStorage.getItem('cart');\n        this.cart = stored ? JSON.parse(stored) : [];\n      } catch (err) {\n        console.error('Error loading cart:', err);\n        this.cart = [];\n      }\n    },\n    saveCart() {\n      localStorage.setItem('cart', JSON.stringify(this.cart));\n    },\n    addToCart(product) {\n      if (!Array.isArray(this.cart)) {\n        this.cart = [];\n      }\n      const existing = this.cart.find(item => item.id === product.id);\n      if (existing) {\n        if (existing.quantity < product.stock) {\n          existing.quantity += 1;\n        } else {\n          alert(`You've reached the maximum available quantity for this item.`);\n          return;\n        }\n      } else {\n        if (product.stock === 0) {\n          alert('This item is currently out of stock.');\n          return;\n        }\n        this.cart.push({\n          ...product,\n          quantity: 1\n        });\n      }\n      this.saveCart();\n      alert(`${product.name} added to your cart.`);\n    },\n    hasReachedLimit(product) {\n      if (!Array.isArray(this.cart)) return false;\n      const found = this.cart.find(item => item.id === product.id);\n      return found ? found.quantity >= product.stock : false;\n    },\n    async fetchProducts() {\n      try {\n        const res = await axios.get('products/');\n        this.products = res.data;\n      } catch (err) {\n        alert('Failed to fetch products. Please try again later.');\n        console.error(err);\n      }\n    }\n  },\n  mounted() {\n    this.loadCart();\n    this.fetchProducts();\n  }\n};","map":{"version":3,"names":["axios","data","products","cart","searchQuery","computed","filteredProducts","q","toLowerCase","filter","p","name","includes","description","methods","buttonText","product","stock","hasReachedLimit","fullImageUrl","path","startsWith","loadCart","stored","localStorage","getItem","JSON","parse","err","console","error","saveCart","setItem","stringify","addToCart","Array","isArray","existing","find","item","id","quantity","alert","push","found","fetchProducts","res","get","mounted"],"sources":["D:\\4TH YEAR FILES\\ITEW6\\ITEW6-FINALSEXAM\\ecommerce-frontend\\src\\components\\ProductList.vue"],"sourcesContent":["<template>\r\n    <div class=\"container py-5 main-container\">\r\n      <!-- Header Section -->\r\n      <div class=\"row mb-5\">\r\n        <div class=\"col-12\">\r\n          <div class=\"d-flex justify-content-between align-items-center\">\r\n            <h2 class=\"font-weight-bold text-brown mb-0\">Maisanova Collection</h2>\r\n            <div class=\"search-container position-relative\">\r\n              <input\r\n                v-model=\"searchQuery\"\r\n                type=\"text\"\r\n                class=\"form-control search-input pl-4 pr-5 rounded-pill border-0 shadow-sm\"\r\n                placeholder=\"Search our collection...\"\r\n              />\r\n              <span class=\"position-absolute search-icon\">\r\n                <i class=\"fas fa-search text-brown-light\"></i>\r\n              </span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- Product Grid -->\r\n      <div v-if=\"filteredProducts.length === 0\" class=\"text-center py-5\">\r\n        <p class=\"text-brown-light\">No products match your search criteria.</p>\r\n      </div>\r\n      \r\n      <div class=\"row\">\r\n        <div v-for=\"product in filteredProducts\" :key=\"product.id\" class=\"col-md-4 mb-4\">\r\n          <div class=\"card product-card h-100 border-0 shadow-sm\">\r\n            <div class=\"product-image-container\">\r\n              <img\r\n                v-if=\"product.image\"\r\n                :src=\"fullImageUrl(product.image)\"\r\n                class=\"card-img-top product-image-list\"\r\n                alt=\"Product\"\r\n              />\r\n              <div v-else class=\"no-image-placeholder\">\r\n                <i class=\"fas fa-image text-brown-light\"></i>\r\n              </div>\r\n              <div v-if=\"product.stock === 0\" class=\"out-of-stock-badge\">\r\n                Out of Stock\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"card-body d-flex flex-column bg-beige\">\r\n              <h5 class=\"card-title font-weight-bold text-brown-dark\">{{ product.name }}</h5>\r\n              <p class=\"card-text text-brown-medium product-description\">{{ product.description }}</p>\r\n              <div class=\"mt-auto\">\r\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\r\n                  <span class=\"product-price text-brown-dark\">₱{{ product.price.toLocaleString() }}</span>\r\n                  <span class=\"stock-indicator\" :class=\"{'text-accent': product.stock < 5 && product.stock > 0}\">\r\n                    {{ product.stock > 0 ? `${product.stock} in stock` : '' }}\r\n                  </span>\r\n                </div>\r\n                <button\r\n                  class=\"btn btn-add-to-cart-list w-100\"\r\n                  @click=\"addToCart(product)\"\r\n                  :disabled=\"product.stock === 0 || hasReachedLimit(product)\"\r\n                  :class=\"{'btn-brown-light': product.stock === 0 || hasReachedLimit(product)}\"\r\n                >\r\n                  <i class=\"fas fa-shopping-cart mr-2\"></i>\r\n                  {{ buttonText(product) }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from '../axios'\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        products: [],\r\n        cart: [], // ✅ Initialized as array\r\n        searchQuery: ''\r\n      }\r\n    },\r\n    computed: {\r\n      filteredProducts() {\r\n        if (!this.searchQuery) return this.products\r\n        const q = this.searchQuery.toLowerCase()\r\n        return this.products.filter(p =>\r\n          p.name.toLowerCase().includes(q) ||\r\n          p.description.toLowerCase().includes(q)\r\n        )\r\n      }\r\n    },\r\n    methods: {\r\n      buttonText(product) {\r\n        if (product.stock === 0) return 'Out of Stock'\r\n        if (this.hasReachedLimit(product)) return 'Max Quantity Reached'\r\n        return 'Add to Cart'\r\n      },\r\n      fullImageUrl(path) {\r\n        if (!path) return ''\r\n        return path.startsWith('http') ? path : `http://127.0.0.1:8000${path.startsWith('/') ? path : '/media/' + path}`\r\n      },\r\n      loadCart() {\r\n        try {\r\n          const stored = localStorage.getItem('cart')\r\n          this.cart = stored ? JSON.parse(stored) : []\r\n        } catch (err) {\r\n          console.error('Error loading cart:', err)\r\n          this.cart = []\r\n        }\r\n      },\r\n      saveCart() {\r\n        localStorage.setItem('cart', JSON.stringify(this.cart))\r\n      },\r\n      addToCart(product) {\r\n        if (!Array.isArray(this.cart)) {\r\n          this.cart = []\r\n        }\r\n  \r\n        const existing = this.cart.find(item => item.id === product.id)\r\n  \r\n        if (existing) {\r\n          if (existing.quantity < product.stock) {\r\n            existing.quantity += 1\r\n          } else {\r\n            alert(`You've reached the maximum available quantity for this item.`)\r\n            return\r\n          }\r\n        } else {\r\n          if (product.stock === 0) {\r\n            alert('This item is currently out of stock.')\r\n            return\r\n          }\r\n          this.cart.push({ ...product, quantity: 1 })\r\n        }\r\n  \r\n        this.saveCart()\r\n        alert(`${product.name} added to your cart.`)\r\n      },\r\n      hasReachedLimit(product) {\r\n        if (!Array.isArray(this.cart)) return false\r\n        const found = this.cart.find(item => item.id === product.id)\r\n        return found ? found.quantity >= product.stock : false\r\n      },\r\n      async fetchProducts() {\r\n        try {\r\n          const res = await axios.get('products/')\r\n          this.products = res.data\r\n        } catch (err) {\r\n          alert('Failed to fetch products. Please try again later.')\r\n          console.error(err)\r\n        }\r\n      }\r\n    },\r\n    mounted() {\r\n      this.loadCart()\r\n      this.fetchProducts()\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* Brown Neutral Color Palette */\r\n  :root {\r\n    --brown-dark: #5D4037;\r\n    --brown-medium: #7D5A50;\r\n    --brown-light: #A98274;\r\n    --beige: #F5F5DC;\r\n    --cream: #FFFBEB;\r\n    --accent: #8D6E63;\r\n    --neutral-dark: #4E342E;\r\n    --neutral-light: #D7CCC8;\r\n  }\r\n  \r\n  .main-container {\r\n    background-color: var(--cream);\r\n  }\r\n  \r\n  .search-container {\r\n    width: 300px;\r\n  }\r\n  \r\n  .search-input {\r\n    background-color: #F9F4E8;\r\n    transition: all 0.3s;\r\n    border: 1px solid var(--neutral-light);\r\n  }\r\n  \r\n  .search-input:focus {\r\n    background-color: white;\r\n    box-shadow: 0 0 10px rgba(93, 64, 55, 0.1);\r\n    border-color: var(--brown-light);\r\n  }\r\n  \r\n  .search-icon {\r\n    top: 10px;\r\n    right: 15px;\r\n  }\r\n  \r\n  .product-card {\r\n    transition: transform 0.3s, box-shadow 0.3s;\r\n    overflow: hidden;\r\n    border-radius: 8px;\r\n  }\r\n  \r\n  .product-card:hover {\r\n    transform: translateY(-5px);\r\n    box-shadow: 0 10px 20px rgba(93, 64, 55, 0.15) !important;\r\n  }\r\n  \r\n  .product-image-container {\r\n    height: 220px;\r\n    overflow: hidden;\r\n    position: relative;\r\n    background-color: #F9F4E8;\r\n  }\r\n  \r\n  .product-image-list {\r\n    height: 100%;\r\n    width: 100%;\r\n    object-fit: cover;\r\n  }\r\n  \r\n  .no-image-placeholder {\r\n    height: 100%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n  }\r\n  \r\n  .no-image-placeholder i {\r\n    font-size: 3rem;\r\n  }\r\n  \r\n  .bg-beige {\r\n    background-color: var(--beige);\r\n  }\r\n  \r\n  .text-brown {\r\n    color: var(--brown-medium);\r\n  }\r\n  \r\n  .text-brown-dark {\r\n    color: var(--brown-dark);\r\n  }\r\n  \r\n  .text-brown-medium {\r\n    color: var(--brown-medium);\r\n  }\r\n  \r\n  .text-brown-light {\r\n    color: var(--brown-light);\r\n  }\r\n  \r\n  .product-description {\r\n    font-size: 0.9rem;\r\n    overflow: hidden;\r\n    display: -webkit-box;\r\n    -webkit-line-clamp: 3;\r\n    -webkit-box-orient: vertical;\r\n    min-height: 60px;\r\n  }\r\n  \r\n  .product-price {\r\n    font-size: 1.25rem;\r\n    font-weight: bold;\r\n  }\r\n  \r\n  .stock-indicator {\r\n    font-size: 0.85rem;\r\n    color: var(--brown-medium);\r\n  }\r\n  \r\n  .text-accent {\r\n    color: var(--accent);\r\n    font-weight: 600;\r\n  }\r\n  \r\n  .btn-add-to-cart-list {\r\n    background-color: var(--brown-medium);\r\n    color: rgb(37, 30, 30);\r\n    border: 1px var(--brown-medium);\r\n    transition: all 0.3s;\r\n    border-radius: 6px;\r\n    font-weight: 500;\r\n    letter-spacing: 0.5px;\r\n  }\r\n  \r\n  .btn-add-to-cart-list:hover:not(:disabled) {\r\n    background-color: var(--brown-dark);\r\n  }\r\n  \r\n  .btn-brown-light {\r\n    background-color: var(--neutral-light);\r\n    color: var(--neutral-dark);\r\n  }\r\n  \r\n  .out-of-stock-badge {\r\n    position: absolute;\r\n    top: 10px;\r\n    right: 10px;\r\n    background-color: rgba(125, 90, 80, 0.9);\r\n    color: white;\r\n    padding: 5px 10px;\r\n    border-radius: 4px;\r\n    font-size: 0.8rem;\r\n    font-weight: bold;\r\n  }\r\n  </style>"],"mappings":";;;;AAyEE,OAAOA,KAAI,MAAO,UAAS;AAE3B,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,IAAI,EAAE,EAAE;MAAE;MACVC,WAAW,EAAE;IACf;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,gBAAgBA,CAAA,EAAG;MACjB,IAAI,CAAC,IAAI,CAACF,WAAW,EAAE,OAAO,IAAI,CAACF,QAAO;MAC1C,MAAMK,CAAA,GAAI,IAAI,CAACH,WAAW,CAACI,WAAW,CAAC;MACvC,OAAO,IAAI,CAACN,QAAQ,CAACO,MAAM,CAACC,CAAA,IAC1BA,CAAC,CAACC,IAAI,CAACH,WAAW,CAAC,CAAC,CAACI,QAAQ,CAACL,CAAC,KAC/BG,CAAC,CAACG,WAAW,CAACL,WAAW,CAAC,CAAC,CAACI,QAAQ,CAACL,CAAC,CACxC;IACF;EACF,CAAC;EACDO,OAAO,EAAE;IACPC,UAAUA,CAACC,OAAO,EAAE;MAClB,IAAIA,OAAO,CAACC,KAAI,KAAM,CAAC,EAAE,OAAO,cAAa;MAC7C,IAAI,IAAI,CAACC,eAAe,CAACF,OAAO,CAAC,EAAE,OAAO,sBAAqB;MAC/D,OAAO,aAAY;IACrB,CAAC;IACDG,YAAYA,CAACC,IAAI,EAAE;MACjB,IAAI,CAACA,IAAI,EAAE,OAAO,EAAC;MACnB,OAAOA,IAAI,CAACC,UAAU,CAAC,MAAM,IAAID,IAAG,GAAI,wBAAwBA,IAAI,CAACC,UAAU,CAAC,GAAG,IAAID,IAAG,GAAI,SAAQ,GAAIA,IAAI,EAAC;IACjH,CAAC;IACDE,QAAQA,CAAA,EAAG;MACT,IAAI;QACF,MAAMC,MAAK,GAAIC,YAAY,CAACC,OAAO,CAAC,MAAM;QAC1C,IAAI,CAACtB,IAAG,GAAIoB,MAAK,GAAIG,IAAI,CAACC,KAAK,CAACJ,MAAM,IAAI,EAAC;MAC7C,EAAE,OAAOK,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,qBAAqB,EAAEF,GAAG;QACxC,IAAI,CAACzB,IAAG,GAAI,EAAC;MACf;IACF,CAAC;IACD4B,QAAQA,CAAA,EAAG;MACTP,YAAY,CAACQ,OAAO,CAAC,MAAM,EAAEN,IAAI